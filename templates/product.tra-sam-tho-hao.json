    "pf_product_faq": {
      "type": "pf-product-faq",
      "blocks": {
        "g1": {
          "type": "group",
          "settings": {
            "title": "Vận chuyển & đơn hàng"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "Bao lâu thì tôi nhận được hàng?",
            "answer": "<p>Đơn được đóng gói trong <strong>ngày làm việc kế tiếp</strong> tại kho EU của PHOMIFOOD (Praha, CH Séc) và giao trong <strong>2–5 ngày làm việc</strong> đến hầu hết các nước châu Âu (không tính cuối tuần, ngày lễ).</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Có miễn phí vận chuyển không?",
            "answer": "<p>Có. Đơn từ <strong>169€</strong> được <strong>Freeship</strong> hoặc <strong>giảm 10%</strong>. Thanh tiến độ trong giỏ hàng cho biết bạn còn thiếu bao nhiêu.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Làm sao để theo dõi đơn hàng?",
            "answer": "<p>Bấm <strong>Theo dõi đơn hàng</strong> ở đầu trang để nhắn PHOMIFOOD qua WhatsApp, hoặc nhắn qua Messenger — shop sẽ gửi tình trạng đơn cho bạn.</p>"
          }
        },
        "g2": {
          "type": "group",
          "settings": {
            "title": "Thanh toán & đổi trả"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Hàng bị lỗi khi nhận thì sao?",
            "answer": "<p>Sản phẩm bị lỗi khi giao nhận được <strong>hoàn tiền 100%</strong>. Nếu phát hiện hàng giả, PHOMIFOOD hoàn <strong>120%</strong> giá trị sản phẩm. Chụp ảnh tình trạng hàng và nhắn shop ngay khi nhận.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Tôi có thể thanh toán bằng gì?",
            "answer": "<p>Thanh toán trực tuyến an toàn qua Shopify. Các phương thức khả dụng (thẻ, ví điện tử…) hiển thị ở bước thanh toán.</p>"
          }
        }
