<style>
  .pfc { --pf-green:#1e8541; --pf-green-d:#14672f; --pf-cream:#fff8e9; --pf-gold:#f2b705; --pf-red:#d62828; --pf-ink:#3d3a33; color: var(--pf-ink); }
  .pfc * { box-sizing: border-box; }
  .pfc-wrap { max-width: 116rem; margin: 0 auto; padding: 0 clamp(1.6rem, 4vw, 3rem); }

  .pfc-hero { text-align: center; padding: clamp(3.6rem,7vw,6rem) 0 clamp(2.4rem,4vw,3.6rem);
    background: radial-gradient(120% 100% at 50% 0%, #eaf6ee 0%, var(--pf-cream) 55%, #fff 100%); }
  .pfc-hero__eyebrow { letter-spacing: 2px; font-weight: 800; color: var(--pf-green); font-size: 1.3rem; }
  .pfc-hero__title { font-size: clamp(3rem,6vw,4.6rem); font-weight: 900; color: var(--pf-green-d); margin: .8rem 0 0; }
  .pfc-hero__sub { max-width: 66rem; margin: 1.4rem auto 0; font-size: 1.6rem; line-height: 1.65; color: #5c5747; }

  .pfc-grid-wrap { padding: clamp(2.4rem,5vw,4rem) 0 clamp(2rem,4vw,3rem); }
  .pfc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .pfc-card {
    display: flex; flex-direction: column; background: #fff; border-radius: 18px; overflow: hidden;
    border: 1px solid #ecdcb6; box-shadow: 0 8px 24px rgba(20,103,47,.08);
    transition: transform .18s ease, box-shadow .18s ease; border-top: 5px solid var(--pf-green);
  }
  .pfc-card:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(20,103,47,.16); }
  .pfc-card--green { border-top-color: var(--pf-green); }
  .pfc-card--red { border-top-color: var(--pf-red); }
  .pfc-card--gold { border-top-color: var(--pf-gold); }
  .pfc-card--amber { border-top-color: #e8862f; }
  .pfc-card__head { display: flex; gap: 1.1rem; align-items: flex-start; padding: 1.8rem 1.8rem 1.2rem; }
  .pfc-card__emoji { flex: none; font-size: 2.8rem; line-height: 1; }
  .pfc-card__name { margin: 0; font-size: 2rem; font-weight: 900; color: var(--pf-green-d); }
  .pfc-card__desc { margin: .4rem 0 0; font-size: 1.35rem; line-height: 1.45; color: #6a6255; }
  .pfc-list { list-style: none; margin: 0; padding: 0 1.8rem; flex: 1; }
  .pfc-list li { position: relative; padding: .5rem 0 .5rem 2.2rem; font-size: 1.4rem; line-height: 1.4; color: #4a463d; border-bottom: 1px dashed #f0e6cd; }
  .pfc-list li:last-child { border-bottom: 0; }
  .pfc-list li::before { content: "✓"; position: absolute; left: 0; top: .5rem; width: 1.6rem; height: 1.6rem; background: #e9f7ee; color: var(--pf-green); border-radius: 50%; display: grid; place-items: center; font-size: 1.05rem; font-weight: 900; }
  .pfc-tag { display: inline-block; background: var(--pf-red); color: #fff; font-size: 1rem; font-weight: 800; padding: .1rem .5rem; border-radius: 999px; vertical-align: middle; }
  .pfc-card__foot { padding: 1.4rem 1.8rem 1.8rem; margin-top: 1rem; }
  .pfc-price { display: flex; align-items: baseline; gap: .8rem; margin-bottom: 1rem; }
  .pfc-price__old { font-size: 1.5rem; color: #a49c8c; text-decoration: line-through; }
  .pfc-price__now { font-size: 2.6rem; font-weight: 900; color: var(--pf-red); }
  .pfc-btn { display: block; text-align: center; text-decoration: none; font-weight: 800; font-size: 1.5rem;
    padding: 1.15rem 1.4rem; border-radius: 12px; background: linear-gradient(90deg, #25D366, #1ea952); color: #fff;
    box-shadow: 0 6px 16px rgba(30,169,82,.28); transition: filter .15s ease, transform .15s ease; }
  .pfc-btn:hover { filter: brightness(1.05); transform: translateY(-1px); color: #fff; }
  .pfc-note { margin: 2rem 0 0; font-size: 1.25rem; line-height: 1.5; color: #8a8271; text-align: center; }

  .pfc-cta { text-align: center; padding: clamp(3.6rem,6vw,5.6rem) 0; margin-top: 1rem;
    background: linear-gradient(135deg, var(--pf-cream) 0%, #fdeecb 100%); }
  .pfc-cta__title { font-size: clamp(2.2rem,3.6vw,3rem); font-weight: 900; color: var(--pf-green-d); margin: 0 0 .8rem; }
  .pfc-cta__sub { font-size: 1.6rem; color: #5c5747; margin: 0 0 2.4rem; }
  .pfc-btn--big { display: inline-block; padding: 1.3rem 2.6rem; font-size: 1.7rem; }

  @media (max-width: 749px) {
    .pfc-grid { grid-template-columns: 1fr; gap: 1.6rem; }
    .pfc-card__name { font-size: 1.8rem; }
  }
</style>
