{%- comment -%}
  PHOMIFOOD — "Feedback khách hàng" / Customer feedback page.
  Assign this template to a Page in Shopify admin (Pages → Feedback →
  Theme template → "feedback"). Self-contained + bilingual + lightbox.
  To add/replace images: edit the pf_fb_images list below (one URL per line).
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

{%- comment -%} ===== Feedback image URLs (edit here to add/replace) ===== {%- endcomment -%}
{%- capture pf_fb_images -%}
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/765158470_122111552733396579_5765327748659751309_n.jpg?v=1787019874
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/765818079_122111552829396579_5401768943136104717_n.jpg?v=1787019874
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/764800463_122111552685396579_4072291594541595060_n.jpg?v=1787019874
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/763671755_122111552835396579_3096848449742426825_n.jpg?v=1787019874
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/764752298_122111552739396579_7507345758427458679_n.jpg?v=1787019874
https://cdn.shopify.com/s/files/1/0749/9353/3018/files/image.png?v=1787307634
{%- endcapture -%}
{%- assign pf_fb_list = pf_fb_images | strip | split: '
' -%}

<div class="pffb color-scheme-1">

  {%- comment -%}================= HERO =================={%- endcomment -%}
  <section class="pffb-hero">
    <div class="pffb-wrap">
      <span class="pffb-hero__stars">★★★★★</span>
      <p class="pffb-hero__kicker">{% if vi %}KHÁCH HÀNG NÓI GÌ VỀ PHOMIFOOD{% else %}WHAT OUR CUSTOMERS SAY{% endif %}</p>
      <h1 class="pffb-hero__title">{% if vi %}Feedback từ khách hàng{% else %}Customer feedback{% endif %}</h1>
      <p class="pffb-hero__sub">{% if vi %}Những phản hồi thật từ khách hàng đã mua sắm tại Phomifood — cảm ơn cả nhà đã tin tưởng và ủng hộ! 💚{% else %}Real feedback from customers who shopped at Phomifood — thank you for your trust and support! 💚{% endif %}</p>
    </div>
  </section>

  {%- comment -%}================ GALLERY ================={%- endcomment -%}
  <section class="pffb-wrap pffb-gallery-wrap">
    <div class="pffb-gallery">
      {%- for img in pf_fb_list -%}
        {%- assign img = img | strip -%}
        {%- if img != blank -%}
          <button type="button" class="pffb-item" data-full="{{ img }}" aria-label="{% if vi %}Xem feedback{% else %}View feedback{% endif %} {{ forloop.index }}">
            <img src="{{ img }}" loading="lazy" alt="{% if vi %}Feedback khách hàng Phomifood{% else %}Phomifood customer feedback{% endif %} {{ forloop.index }}">
            <span class="pffb-item__zoom" aria-hidden="true">🔍</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%}================= CTA =================={%- endcomment -%}
  <section class="pffb-cta">
    <div class="pffb-wrap">
      <h2 class="pffb-cta__title">{% if vi %}Trải nghiệm hương vị quê nhà ngay hôm nay{% else %}Taste home today{% endif %}</h2>
      <p class="pffb-cta__sub">{% if vi %}Hàng nghìn khách hàng người Việt tại Châu Âu đã tin chọn Phomifood.{% else %}Thousands of Vietnamese customers across Europe already trust Phomifood.{% endif %}</p>
      <div class="pffb-cta__btns">
        <a class="pffb-btn pffb-btn--primary" href="{{ routes.all_products_collection_url }}">{% if vi %}Khám phá sản phẩm →{% else %}Explore products →{% endif %}</a>
        <a class="pffb-btn pffb-btn--ghost" href="https://m.me/phomifoodstore" target="_blank" rel="noopener">{% if vi %}Liên hệ Phomifood →{% else %}Contact us →{% endif %}</a>
      </div>
    </div>
  </section>

  {%- comment -%}=============== LIGHTBOX ================={%- endcomment -%}
  <div class="pffb-lb" id="pffb-lb" hidden>
    <button type="button" class="pffb-lb__close" id="pffb-lb-close" aria-label="{% if vi %}Đóng{% else %}Close{% endif %}">&times;</button>
    <button type="button" class="pffb-lb__nav pffb-lb__prev" id="pffb-lb-prev" aria-label="{% if vi %}Trước{% else %}Previous{% endif %}">&#10094;</button>
    <img class="pffb-lb__img" id="pffb-lb-img" src="" alt="Feedback">
    <button type="button" class="pffb-lb__nav pffb-lb__next" id="pffb-lb-next" aria-label="{% if vi %}Sau{% else %}Next{% endif %}">&#10095;</button>
  </div>
</div>

<style>
  .pffb { --pf-green:#1e8541; --pf-green-d:#14672f; --pf-cream:#fff8e9; --pf-cream2:#fdeecb; --pf-gold:#f2b705; --pf-ink:#3d3a33; color: var(--pf-ink); }
  .pffb * { box-sizing: border-box; }
  .pffb-wrap { max-width: 112rem; margin: 0 auto; padding: 0 clamp(1.6rem, 4vw, 3rem); }

  /* HERO */
  .pffb-hero { text-align: center; padding: clamp(3.6rem, 7vw, 6rem) 0 clamp(2.4rem,4vw,3.6rem);
    background: radial-gradient(120% 100% at 50% 0%, #eaf6ee 0%, var(--pf-cream) 55%, #fff 100%); }
  .pffb-hero__stars { color: var(--pf-gold); font-size: 2.6rem; letter-spacing: 4px; display: block; }
  .pffb-hero__kicker { letter-spacing: 2.5px; font-weight: 800; color: var(--pf-green); font-size: 1.3rem; margin: 1rem 0 .4rem; }
  .pffb-hero__title { font-size: clamp(3rem, 6vw, 4.6rem); font-weight: 900; color: var(--pf-green-d); margin: 0; }
  .pffb-hero__sub { max-width: 64rem; margin: 1.4rem auto 0; font-size: 1.6rem; line-height: 1.65; color: #5c5747; }

  /* GALLERY — responsive masonry via CSS columns */
  .pffb-gallery-wrap { padding: clamp(2.4rem,5vw,4rem) 0 clamp(3rem,5vw,5rem); }
  .pffb-gallery { columns: 3 28rem; column-gap: 1.8rem; }
  .pffb-item {
    display: block; width: 100%; margin: 0 0 1.8rem; padding: 0; border: 0; cursor: zoom-in;
    position: relative; background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 6px 20px rgba(20,103,47,.10); border: 1px solid #ecdcb6;
    break-inside: avoid; transition: transform .18s ease, box-shadow .18s ease;
  }
  .pffb-item:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(20,103,47,.18); }
  .pffb-item img { width: 100%; height: auto; display: block; }
  .pffb-item__zoom {
    position: absolute; top: 1rem; right: 1rem; width: 3.4rem; height: 3.4rem; border-radius: 50%;
    background: rgba(20,103,47,.85); color: #fff; display: grid; place-items: center; font-size: 1.5rem;
    opacity: 0; transition: opacity .18s ease;
  }
  .pffb-item:hover .pffb-item__zoom { opacity: 1; }

  /* CTA */
  .pffb-cta { text-align: center; padding: clamp(3.6rem,6vw,5.6rem) 0;
    background: linear-gradient(135deg, var(--pf-cream) 0%, var(--pf-cream2) 100%); }
  .pffb-cta__title { font-size: clamp(2.2rem,3.6vw,3rem); font-weight: 900; color: var(--pf-green-d); margin: 0 0 .8rem; }
  .pffb-cta__sub { font-size: 1.6rem; color: #5c5747; margin: 0 0 2.4rem; }
  .pffb-cta__btns { display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap; }
  .pffb-btn { display: inline-flex; align-items: center; text-decoration: none; font-weight: 800; font-size: 1.5rem;
    padding: 1.2rem 2.2rem; border-radius: 999px; transition: transform .15s ease, filter .15s ease; }
  .pffb-btn--primary { background: linear-gradient(90deg, var(--pf-green), var(--pf-green-d)); color: #fff; box-shadow: 0 8px 22px rgba(20,103,47,.28); }
  .pffb-btn--ghost { background: #fff; color: var(--pf-green-d); border: 2px solid var(--pf-green); }
  .pffb-btn:hover { transform: translateY(-2px); filter: brightness(1.04); }

  /* LIGHTBOX */
  .pffb-lb { position: fixed; inset: 0; z-index: 9999; background: rgba(15,25,18,.92);
    display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; }
  .pffb-lb[hidden] { display: none; }
  .pffb-lb__img { max-width: 92vw; max-height: 86vh; border-radius: 10px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .pffb-lb__close { position: absolute; top: 1.4rem; right: 1.8rem; width: 4.4rem; height: 4.4rem; border: 0; cursor: pointer;
    background: rgba(255,255,255,.14); color: #fff; font-size: 3rem; line-height: 1; border-radius: 50%; }
  .pffb-lb__close:hover { background: rgba(255,255,255,.28); }
  .pffb-lb__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 5rem; height: 5rem; border: 0; cursor: pointer;
    background: rgba(255,255,255,.14); color: #fff; font-size: 2.4rem; border-radius: 50%; display: grid; place-items: center; }
  .pffb-lb__nav:hover { background: rgba(255,255,255,.28); }
  .pffb-lb__prev { left: 1.4rem; }
  .pffb-lb__next { right: 1.4rem; }

  @media (max-width: 749px) {
    .pffb-gallery { columns: 2 16rem; column-gap: 1.2rem; }
    .pffb-item { margin-bottom: 1.2rem; border-radius: 12px; }
    .pffb-cta__btns { flex-direction: column; }
    .pffb-lb__nav { width: 4rem; height: 4rem; font-size: 2rem; }
  }
  @media (max-width: 420px) { .pffb-gallery { columns: 1; } }
</style>

<script>
  (function () {
    var lb = document.getElementById('pffb-lb');
    if (!lb) return;
    var img = document.getElementById('pffb-lb-img');
    var items = Array.prototype.slice.call(document.querySelectorAll('.pffb-item'));
    var urls = items.map(function (b) { return b.getAttribute('data-full'); });
    var cur = 0;

    function open(i) { cur = i; img.src = urls[cur]; lb.hidden = false; document.body.style.overflow = 'hidden'; }
    function close() { lb.hidden = true; img.src = ''; document.body.style.overflow = ''; }
    function show(delta) { cur = (cur + delta + urls.length) % urls.length; img.src = urls[cur]; }

    items.forEach(function (b, i) { b.addEventListener('click', function () { open(i); }); });
    document.getElementById('pffb-lb-close').addEventListener('click', close);
    document.getElementById('pffb-lb-prev').addEventListener('click', function (e) { e.stopPropagation(); show(-1); });
    document.getElementById('pffb-lb-next').addEventListener('click', function (e) { e.stopPropagation(); show(1); });
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(-1);
      else if (e.key === 'ArrowRight') show(1);
    });
  })();
</script>
