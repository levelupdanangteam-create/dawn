    "custom_liquid_m33TFL": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* Trang chủ: tăng khoảng cách giữa các section thêm 10px (27/10) */\n  #MainContent > .shopify-section + .shopify-section { margin-top: 10px; }\n  /* Cỡ giá thống nhất cho mọi thẻ sản phẩm trên trang chủ: giá mới 1.8rem đậm, giá gạch 1.3rem xám */\n  .pf-ex__price .now, .pf-bs__price .now, .pf-cb__price .now, .pf-s10__price .now, .pf-cr__now, .pf-hd__now {\n    font-size: 1.8rem !important; font-weight: 800 !important; line-height: 1.2 !important;\n  }\n  .pf-ex__price .was, .pf-bs__price .was, .pf-cb__price .was, .pf-s10__price .was, .pf-cr__was, .pf-hd__was {\n    font-size: 1.3rem !important; font-weight: 400 !important; line-height: 1.2 !important; color: #a79c8e !important;\n  }\n  .pf-ex__price, .pf-bs__price, .pf-cb__price, .pf-s10__price, .pf-cr__price, .pf-hd__price { flex-wrap: wrap; column-gap: .8rem; row-gap: .2rem; }\n  @media (max-width: 749px) {\n    .pf-ex__price .now, .pf-bs__price .now, .pf-cb__price .now, .pf-s10__price .now, .pf-cr__now, .pf-hd__now { font-size: 1.6rem !important; }\n    .pf-ex__price .was, .pf-bs__price .was, .pf-cb__price .was, .pf-s10__price .was, .pf-cr__was, .pf-hd__was { font-size: 1.2rem !important; }\n  }\n  /* Nút trên thẻ sản phẩm: Thêm vào giỏ = xanh lá đặc, Xem sản phẩm = viền xanh lá, đều bo tròn */\n  .pf-card-actions { gap: .6rem !important; }\n  .pf-card-actions .pf-btn-cart, .pf-card-actions .pf-btn-view {\n    border-radius: 999px !important; border: 1.5px solid #1e8541 !important;\n    font-size: 1.3rem !important; font-weight: 700 !important; padding: .9rem .6rem !important;\n  }\n  .pf-card-actions .pf-btn-cart { background: #1e8541 !important; color: #fff !important; }\n  .pf-card-actions .pf-btn-cart:hover:not([disabled]) { background: #14672f !important; border-color: #14672f !important; }\n  .pf-card-actions .pf-btn-cart[disabled] { background: #b9b3a8 !important; border-color: #b9b3a8 !important; opacity: 1 !important; }\n  .pf-card-actions .pf-btn-view { background: #fff !important; color: #14672f !important; }\n  .pf-card-actions .pf-btn-view:hover { background: #e9f5ed !important; color: #14672f !important; }\n  @media (max-width: 749px) {\n    .pf-card-actions .pf-btn-cart, .pf-card-actions .pf-btn-view { font-size: 1.15rem !important; padding: .75rem .4rem !important; }\n  }\n  /* Tiêu đề section trang chủ: cùng màu xanh, cùng font, cùng cỡ + đậm, viết thường (chữ cái đầu hoa) */\n  .pf-it__title, .pf-hd__title, .pf-s10__title, .pf-ex__title, .pf-cb__title, .pf-bs__title, .pf-cr__title, .pf-se__title, .pf-os__title {\n    font-family: var(--font-heading-family, sans-serif) !important; font-weight: 900 !important; font-style: normal !important;\n    font-size: clamp(2.6rem, 3.4vw, 3.8rem) !important; line-height: 1.15 !important; letter-spacing: 0 !important;\n    text-transform: none !important; color: #1e8541 !important;\n  }\n  .pf-it__title::after, .pf-s10__title::after, .pf-ex__title::after, .pf-cb__title::after, .pf-bs__title::after, .pf-cr__title::after, .pf-se__title::after { background: linear-gradient(90deg, #1e8541, #ffc61a) !important; }\n  .pf-bs__eyebrow { color: #1e8541 !important; }\n  @media (max-width: 749px) {\n    .pf-it__title, .pf-hd__title, .pf-s10__title, .pf-ex__title, .pf-cb__title, .pf-bs__title, .pf-cr__title, .pf-se__title, .pf-os__title { font-size: 2.4rem !important; }\n  }\n  /* Mobile (27/10): các section sản phẩm = 1 hàng trượt ngang, 3 sản phẩm / màn hình + chấm phân trang (JS bên dưới) */\n  @media (max-width: 749px) {\n    .pf-cb__grid, .pf-ex__grid, .pf-s10__grid, .pf-bs__grid, .pf-cr__track {\n      display: flex !important; gap: .8rem !important; overflow-x: auto !important; overflow-y: hidden;\n      scroll-snap-type: x mandatory !important; scroll-behavior: smooth; -webkit-overflow-scrolling: touch;\n      scrollbar-width: none; padding: .2rem 0 .4rem !important; grid-template-columns: none !important;\n    }\n    .pf-cb__grid::-webkit-scrollbar, .pf-ex__grid::-webkit-scrollbar, .pf-s10__grid::-webkit-scrollbar, .pf-bs__grid::-webkit-scrollbar, .pf-cr__track::-webkit-scrollbar { display: none; }\n    .pf-cb__grid > .pf-fs__card, .pf-ex__grid > .pf-fs__card, .pf-s10__grid > .pf-fs__card, .pf-bs__grid > *, .pf-cr__track > .pf-fs__card {\n      flex: 0 0 calc((100% - 1.6rem) / 3) !important; width: auto !important; min-width: 0; scroll-snap-align: start;\n      padding: .6rem .6rem .7rem !important;\n    }\n    .pf-s10__card--hidden, .pf-simple .pf-s10__card--hidden { display: flex !important; }\n    .pf-simple__more-wrap, .pf-s10__more-wrap, .pf-cb__morewrap, .pf-ex__more-wrap { display: none !important; }\n    .pf-cb__grid .pf-fs__name, .pf-ex__grid .pf-fs__name, .pf-s10__grid .pf-fs__name, .pf-cr__track .pf-fs__name { font-size: 1.2rem !important; margin-top: .5rem !important; }\n    .pf-cb__grid .pf-fs__now, .pf-ex__grid .pf-fs__now, .pf-s10__grid .pf-fs__now, .pf-cr__track .pf-fs__now { font-size: 1.45rem !important; }\n    .pf-cb__grid .pf-fs__was, .pf-ex__grid .pf-fs__was, .pf-s10__grid .pf-fs__was, .pf-cr__track .pf-fs__was { font-size: 1.05rem !important; }\n    .pf-cb__grid .pf-fs__badge, .pf-ex__grid .pf-fs__badge, .pf-s10__grid .pf-fs__badge, .pf-cr__track .pf-fs__badge { font-size: .95rem !important; padding: .25rem .35rem !important; }\n    .pf-cb__grid .pf-fs__bar span, .pf-ex__grid .pf-fs__bar span, .pf-s10__grid .pf-fs__bar span, .pf-cr__track .pf-fs__bar span { font-size: .95rem !important; padding: 0 .3rem !important; }\n    .pf-cb__grid .pf-fs__add--text, .pf-ex__grid .pf-fs__add--text, .pf-s10__grid .pf-fs__add--text, .pf-cr__track .pf-fs__add--text { font-size: 1.1rem !important; padding: .6rem .2rem !important; }\n    .pf-mdots { display: flex; justify-content: center; gap: .7rem; margin-top: 1.2rem; }\n    .pf-mdots button { width: .9rem; height: .9rem; padding: 0; border: 1.5px solid #14672f; border-radius: 999px; background: transparent; cursor: pointer; transition: width .2s ease, background .2s ease; }\n    .pf-mdots button[aria-current=\"true\"] { width: 2.2rem; background: #14672f; }\n  }\n</style>\n<script>\n  (function () {\n    document.querySelectorAll('[data-pf-s10-more]').forEach(function (b) {\n      var a = document.createElement('a');\n      a.href = '/pages/flash-sale';\n      a.className = b.className;\n      a.style.textDecoration = 'none';\n      a.innerHTML = 'Xem thêm <span aria-hidden=\"true\">→</span>';\n      b.replaceWith(a);\n    });\n  })();\n</script>\n<script>\n  /* Mobile: thêm chấm phân trang dưới mỗi hàng sản phẩm trượt ngang (1 chấm = 1 màn hình 3 sản phẩm) */\n  document.addEventListener('DOMContentLoaded', function () {\n    if (!window.matchMedia('(max-width: 749px)').matches) return;\n    document.querySelectorAll('.pf-cb__grid, .pf-ex__grid, .pf-s10__grid, .pf-bs__grid, .pf-cr__track').forEach(function (track) {\n      var dots = document.createElement('div');\n      dots.className = 'pf-mdots';\n      (track.closest('.pf-cr__slider') || track).insertAdjacentElement('afterend', dots);\n      var pages = 0;\n      var mark = function () {\n        var max = track.scrollWidth - track.clientWidth;\n        var k = track.scrollLeft >= max - 4 ? pages - 1 : Math.round(track.scrollLeft / track.clientWidth);\n        Array.prototype.forEach.call(dots.children, function (d, i) { d.setAttribute('aria-current', i === k ? 'true' : 'false'); });\n      };\n      var build = function () {\n        var n = Math.ceil((track.scrollWidth - 4) / track.clientWidth);\n        if (n === pages) return;\n        pages = n; dots.innerHTML = ''; dots.hidden = n < 2;\n        for (var i = 0; i < n; i++) {\n          var b = document.createElement('button');\n          b.type = 'button'; b.setAttribute('aria-label', 'Trang ' + (i + 1));\n          b.addEventListener('click', (function (k) { return function () { track.scrollTo({ left: k * track.clientWidth }); }; })(i));\n          dots.appendChild(b);\n        }\n        mark();\n      };\n      var t;\n      track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(mark, 60); }, { passive: true });\n      window.addEventListener('resize', build);\n      window.addEventListener('load', build);\n      build();\n    });\n  });\n</script>",
