        "custom_liquid": "<div class=\"pf-uh\">\n  <div class=\"page-width pf-uh__in\">\n    <nav class=\"pf-uh__crumb\"><a href=\"/\">Trang chủ</a><span aria-hidden=\"true\">/</span><span>Black Friday</span></nav>\n    <p class=\"pf-uh__kicker\">Cập nhật mỗi ngày</p>\n    <h1 class=\"pf-uh__title\">Black Friday</h1>\n    <p class=\"pf-uh__sub\">Tất cả chương trình đang diễn ra trên Phomifood.eu — bấm để xem nhanh từng đợt ưu đãi.</p>\n    <div class=\"pf-uh__chips\">\n      <a class=\"pf-uh__chip\" href=\"#duy-nhat-hom-nay\" data-pf-go=\"pf_deal\">🎉 Duy nhất hôm nay</a>\n      <a class=\"pf-uh__chip\" href=\"#freeship\" data-pf-go=\"pf_ship_banner\">🚚 Freeship đơn từ 139€ / Giảm 10%</a>\n      <a class=\"pf-uh__chip\" href=\"#uu-dai-theo-bac\" data-pf-go=\"pf_tier_banner\">🛒 Ưu đãi theo bậc</a>\n      <a class=\"pf-uh__chip\" href=\"/pages/mua-1-tang-1\" data-pf-go=\"pf_bogo\">🛍️ Mua 1 tặng 1</a>\n      <a class=\"pf-uh__chip\" href=\"#gia-xa-kho\" data-pf-go=\"pf_xk_banner\">🔥 Giá siêu rẻ</a>\n      <a class=\"pf-uh__chip\" href=\"#combo\" data-pf-go=\"pf_combo\">🎁 Combo tiết kiệm</a>\n    </div>\n  </div>\n</div>\n<style>\n  #MainContent > .shopify-section + .shopify-section { margin-top: 12px; }\n  /* Mọi banner cách sản phẩm phía trên 20px (24 + 12 - 16), phía dưới vẫn 60px */\n  #MainContent > .shopify-section:has(> .pf-promo) { margin-top: -16px; }\n  #MainContent { background: #0b0b0b; }\n  .pf-uh { padding: 28px 0 18px; color: #fff; background: radial-gradient(circle at 85% 0%, rgba(225, 29, 46, .35), rgba(225, 29, 46, 0) 45%), #0b0b0b; }\n  .pf-uh__in { max-width: none; padding-inline: clamp(1.6rem, 3vw, 4.8rem); }\n  .pf-uh__crumb { display: flex; gap: .6rem; font-size: 1.3rem; color: rgba(255,255,255,.55); margin-bottom: 1.4rem; }\n  .pf-uh__crumb a { color: #ffc61a; font-weight: 700; text-decoration: none; }\n  .pf-uh__kicker { margin: 0 0 .6rem; font-size: 1.2rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #ff4d5a; }\n  .pf-uh__title { margin: 0; font-weight: 900; font-size: clamp(3.2rem, 4.6vw, 5.6rem); line-height: 1.05; color: #ffc61a; letter-spacing: -.01em; text-transform: uppercase; }\n  .pf-uh__sub { margin: .8rem 0 0; font-size: 1.5rem; color: rgba(255,255,255,.75); }\n  .pf-uh__chips { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }\n  .pf-uh__chip { display: inline-flex; align-items: center; padding: .9rem 1.6rem; border-radius: 999px; border: 1.5px solid #ffc61a; color: #ffc61a; background: #161616; font-size: 1.4rem; font-weight: 700; text-decoration: none; transition: background .15s, color .15s; }\n  .pf-uh__chip:hover { background: #ffc61a; color: #0b0b0b; }\n  /* Các khối sản phẩm trên nền đen */\n  #MainContent .pf-fs .pf-fs__wrap { background: radial-gradient(circle at 92% -10%, rgba(225,29,46,.35), rgba(225,29,46,0) 40%), #161616 !important; border: 1px solid rgba(255,198,26,.35); box-shadow: none !important; }\n  #MainContent .pf-fs .pf-hd__title.pf-fs__title { background: linear-gradient(transparent 80%, #e11d2e 80%, #e11d2e 92%, transparent 92%) !important; }\n  #MainContent .pf-fs .pf-fs__all { background: #ffc61a; border-color: #ffc61a; color: #0b0b0b; }\n  #MainContent .pf-simple .pf-simple__head, #MainContent .pf-xk .pf-xk__head { border-bottom-color: rgba(255,255,255,.15) !important; }\n  #MainContent .pf-simple .pf-simple__head .pf-simple__title, #MainContent .pf-xk .pf-s10__title.pf-xk__title { color: #ffc61a !important; }\n  #MainContent .pf-simple .pf-simple__sub, #MainContent .pf-xk .pf-xk__sub { color: rgba(255,255,255,.7) !important; }\n  #MainContent .pf-simple .pf-simple__all, #MainContent .pf-xk .pf-xk__all { background: transparent !important; color: #ffc61a !important; border-color: #ffc61a !important; }\n  #MainContent .pf-simple .pf-simple__all:hover, #MainContent .pf-xk .pf-xk__all:hover { background: #ffc61a !important; color: #0b0b0b !important; }\n  #MainContent .pf-bogo .pf-bogo__timer-label, #MainContent .pf-xk .pf-xk__timer-label { color: rgba(255,255,255,.8) !important; }\n  #MainContent .pf-cb__more, #MainContent .pf-s10__more, #MainContent .pf-bogo__more { background: #ffc61a !important; color: #0b0b0b !important; border-color: #ffc61a !important; }\n  @media (max-width: 749px) {\n    .pf-uh { padding-top: 18px; }\n    .pf-uh__sub { font-size: 1.35rem; }\n    .pf-uh__chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -1.6rem; padding-inline: 1.6rem; }\n    .pf-uh__chips::-webkit-scrollbar { display: none; }\n    .pf-uh__chip { flex: 0 0 auto; font-size: 1.3rem; padding: .8rem 1.3rem; }\n  }\n</style>\n<script>\n  document.addEventListener('click', function (e) {\n    var a = e.target.closest && e.target.closest('[data-pf-go]');\n    if (!a) return;\n    var el = document.querySelector('[id$=\"__' + a.getAttribute('data-pf-go') + '\"]');\n    if (!el) return;\n    e.preventDefault();\n    var top = el.getBoundingClientRect().top + window.pageYOffset - 90;\n    window.scrollTo({ top: top, behavior: 'smooth' });\n  });\n</script>",
