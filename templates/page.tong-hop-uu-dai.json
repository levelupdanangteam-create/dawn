6rem; border-radius: 999px; border: 1.5px solid #1e8541; color: #14672f; background: #eef6f0; font-size: 1.4rem; font-weight: 700; text-decoration: none; transition: background .15s, color .15s; }\n  .pf-uh__chip:hover { background: #1e8541; color: #fff; }\n  @media (max-width: 749px) {\n    .pf-uh { padding-top: 18px; }\n    .pf-uh__sub { font-size: 1.35rem; }\n    .pf-uh__chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -1.6rem; padding-inline: 1.6rem; }\n    .pf-uh__chips::-webkit-scrollbar { display: none; }\n    .pf-uh__chip { flex: 0 0 auto; font-size: 1.3rem; padding: .8rem 1.3rem; }\n  }\n</style>\n<script>\n  document.addEventListener('click', function (e) {\n    var a = e.target.closest && e.target.closest('[data-pf-go]');\n    if (!a) return;\n    var el = document.querySelector('[id$=\"__' + a.getAttribute('data-pf-go') + '\"]');\n    if (!el) return;\n    e.preventDefault();\n    var top = el.getBoundingClientRect().top + window.pageYOffset - 90;\n    window.scrollTo({ top: top, behavior: 'smooth' });\n  });\n</script>",
