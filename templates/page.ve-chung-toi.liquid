          <p class="pfa-small">Cung cấp thực phẩm Việt chính hãng, chuẩn vị, giá tốt cùng dịch vụ giao vận tận tâm.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}============ 03 · NHỮNG CON SỐ BIẾT NÓI — sửa số ở pfa_stats: số|tiền tố nhỏ|hậu tố|tiêu đề|mô tả ============{%- endcomment -%}
  {%- assign pfa_stats = '300||+|sản phẩm Việt|được cập nhật thường xuyên;1.000||+|đơn hàng|đã được trao tận tay khách hàng;25|||nước Châu Âu|Phomifood giao tới tận cửa;35||+|sản phẩm độc quyền|chỉ có tại Phomifood' | split: ';' -%}
  <section class="pfa-sec">
    <div class="pfa-wrap">
      <p class="pfa-kicker">03 · Con số</p>
      <h2 class="pfa-h2">Những con số biết nói</h2>
      <div class="pfa-stats" data-pfa-stats>
        {%- for row in pfa_stats -%}
          {%- assign st = row | split: '|' -%}
          {%- assign digits = st[0] | split: '' -%}
          <div class="pfa-stat">
            <div class="pfa-stat__num" aria-label="{{ st[1] }} {{ st[0] }}{{ st[2] }}">
              {%- if st[1] != blank -%}<span class="pfa-stat__pre">{{ st[1] }}</span>{%- endif -%}
              <span class="pfa-odo" aria-hidden="true">
                {%- for d in digits -%}
                  {%- if '0123456789' contains d -%}
                    {%- assign to = d | plus: 10 -%}
                    <span class="pfa-odo__col"><span class="pfa-odo__strip" style="--to: {{ to }}; --i: {{ forloop.index0 }}; --n: {{ digits.size }};">
                      {%- for k in (0..19) -%}<span>{{ k | modulo: 10 }}</span>{%- endfor -%}
                    </span></span>
                  {%- else -%}
                    <span class="pfa-odo__sep">{{ d }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if st[2] != blank -%}<span class="pfa-odo__sep">{{ st[2] }}</span>{%- endif -%}
              </span>
            </div>
            <p class="pfa-stat__label">{{ st[3] }}</p>
            <p class="pfa-stat__sub">{{ st[4] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%}============ 04 · SẢN PHẨM ============{%- endcomment -%}
