<script>
  /* Đối tác: chấm phân trang thay thanh cuộn */
  (function () {
    var list = document.querySelector('[data-pfa-brands]'), dots = document.querySelector('[data-pfa-dots]');
    if (!list || !dots) return;
    var pages = 0;
    var mark = function () {
      var max = list.scrollWidth - list.clientWidth;
      var k = list.scrollLeft >= max - 4 ? pages - 1 : Math.round(list.scrollLeft / list.clientWidth);
      Array.prototype.forEach.call(dots.children, function (d, i) { d.setAttribute('aria-current', i === k ? 'true' : 'false'); });
    };
    var build = function () {
      var n = Math.ceil((list.scrollWidth - 4) / list.clientWidth);
      if (n === pages) return;
      pages = n; dots.innerHTML = ''; dots.hidden = n < 2;
      for (var i = 0; i < n; i++) {
        var b = document.createElement('button');
        b.type = 'button'; b.setAttribute('aria-label', 'Trang ' + (i + 1));
        b.addEventListener('click', (function (k) { return function () { list.scrollTo({ left: k * list.clientWidth }); }; })(i));
        dots.appendChild(b);
      }
      mark();
    };
    var t;
    list.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(mark, 60); }, { passive: true });
    window.addEventListener('resize', build);
    build();
  })();
</script>

<script>
