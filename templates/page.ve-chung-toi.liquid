{%- comment -%}
  PHOMIFOOD — trang "Về chúng tôi" (/pages/ve-chung-toi), thiết kế lại 26/10 theo file "Về chúng tôi 1.pdf":
  Hero → 01 Chúng tôi là ai (video) → 02 Triết lý → 03 Sản phẩm → 04 Kho Praha (6 ảnh kho) → 05 Đối tác (hàng logo + tên)
  → 06 Vì sao chọn → 07 Ưu đãi → 08 Khách nói gì → CTA cuối.
  Nhẹ: chỉ CSS + SVG nội tuyến, không thư viện/JS; ảnh lazy + srcset theo bề ngang; video preload="none" có ảnh poster.
  Bản cũ xem trong lịch sử git của file này.
{%- endcomment -%}
{%- liquid
  assign pfa_cdn = 'https://cdn.shopify.com/s/files/1/0749/9353/3018/files/'
  assign pfa_kho = '759881151_122141535231179229_3801021190243726628_n.jpg?v=1787036177,764774570_122142676821179229_5406358648784605218_n.jpg?v=1787036177,764800600_122142677025179229_3432164435546363149_n.jpg?v=1787036177,779019196_122144936703179229_7436146164322467373_n.jpg?v=1787036177,764661354_122142676899179229_3503208907088839976_n.jpg?v=1787036176,778869910_122144937135179229_2084264640343354086_n.jpg?v=1787036177' | split: ','
  assign pfa_brands = 'Acecook|acecook-mi-tom-hao-hao-vi-tom-chua-cay-75g-x-30-goi;Vifon|vifon-pho-bo-65g-x-30-goi;Chinsu|chinsu-pho-story-truyen-thong-nuoc-trong;Omachi|mi-tom-omachi-bo-ham;Nam Ngư|nuoc-mam-nam-ngu-750ml;Trung Nguyên|tn-ca-phe-g7-21-goi-x-16-g-x-24-hop;Ông Thọ|sua-dac-ong-tho-lon-do-380g-x-48-hop;TH true MILK|sua-th-true-milk-it-duong-180ml-x-48-hop;Orion Choco-Pie|banh-chocopie-classic-396g-x-8-goi;Oishi|chip-oishi-ngo-80-goi-32g-x-80-goi-bich;Knorr|hat-nem-knor-900g-x-8-goi;Ajinomoto|ajinomoto-mi-chinh-454g;Vinamit|mit-say-vinamit-210g-x-20-goi;Tufoco|tufoco-banh-trang-cuon-tron-size-22-340g-x-44-goi;Vĩnh Thuận|bot-nang-vinh-thuan-400g-x-20;C2|nuoc-tra-xanh-c2-455mlx24-chai' | split: ';'
  assign pfa_fb = '765158470_122111552733396579_5765327748659751309_n.jpg,765818079_122111552829396579_5401768943136104717_n.jpg,764800463_122111552685396579_4072291594541595060_n.jpg' | split: ','
  assign pfa_cats = 'gạo-nếp-cac-loại|Gạo & Nếp|ST25, Jasmine, gạo nếp các loại;bun-phở-kho|Bún – Phở – Bánh tráng|Bún bò Huế, bánh phở, bánh tráng;bột-gia-vị|Gia vị & Nguyên liệu|Nước mắm, nước tương, sa tế, hạt nêm;mi-an-liền|Mì ăn liền|Hảo Hảo, Omachi, Vifon, Kokomi;banh-kẹo-dồ-an-vặt|Đồ ăn vặt|Bánh, kẹo, snack, thạch, socola;dồ-uống|Cà phê & Đồ uống|Cà phê G7, trà, nước ngọt;hang-dộc-quyền|Chỉ có tại Phomifood|Hàng độc quyền, chọn lọc' | split: ';'
-%}

<div class="pfa">

  {%- comment -%}================= HERO ================={%- endcomment -%}
  <section class="pfa-sec pfa-sec--cream">
    <div class="pfa-wrap pfa-split">
      <div>
        <p class="pfa-kicker">Gửi những người Việt xa nhà</p>
        <h1 class="pfa-hero__title">PHOMIFOOD</h1>
        <p class="pfa-hero__tag">Hương vị quê nhà giữa lòng Châu Âu</p>
        <p class="pfa-p">Xa quê, đôi khi chỉ một gói mì, một chai nước mắm quen thuộc cũng đủ làm bữa cơm ấm lại. Chúng tôi ở đây để mang những điều quen thuộc ấy về bếp nhà bạn.</p>
        <a class="pfa-btn" href="{{ routes.all_products_collection_url }}">Khám phá sản phẩm <span aria-hidden="true">→</span></a>
        <ul class="pfa-chips">
          <li>Kho tại Praha</li><li>Giao 1–3 ngày</li><li>Toàn Châu Âu</li>
        </ul>
      </div>
      <div class="pfa-media">
        {%- assign f = pfa_kho[0] -%}
        <img src="{{ pfa_cdn }}{{ f }}&width=900" srcset="{{ pfa_cdn }}{{ f }}&width=600 600w, {{ pfa_cdn }}{{ f }}&width=900 900w, {{ pfa_cdn }}{{ f }}&width=1200 1200w" sizes="(max-width: 749px) 100vw, 50vw" alt="Kệ hàng thực phẩm Việt tại kho Phomifood ở Praha" width="1200" height="900" fetchpriority="high">
      </div>
    </div>
  </section>

  {%- comment -%}============ 01 · CHÚNG TÔI (VIDEO) ============{%- endcomment -%}
  <section class="pfa-sec">
    <div class="pfa-wrap pfa-split">
      <div>
        <p class="pfa-kicker">01 · Chúng tôi</p>
        <h2 class="pfa-h2">Chúng tôi là ai</h2>
        <p class="pfa-p">Phomifood là đơn vị cung ứng thực phẩm Việt Nam, vận hành kho trung tâm trực tiếp tại Praha, Cộng hòa Séc.</p>
        <p class="pfa-p">Sứ mệnh của chúng tôi là kết nối kiều bào toàn Châu Âu với nguồn thực phẩm quê nhà chính hãng, đảm bảo tiêu chuẩn kiểm định EU, giá thành hợp lý và quy trình giao nhận minh bạch, nhanh chóng.</p>
      </div>
      <div class="pfa-media pfa-media--video">
        {%- assign f = pfa_kho[1] -%}
        <video controls playsinline preload="none" poster="{{ pfa_cdn }}{{ f }}&width=900" aria-label="Video giới thiệu Phomifood">
          <source src="https://cdn.shopify.com/videos/c/o/v/065abf7625254b97ad6198a553f32f1f.mp4" type="video/mp4">
        </video>
      </div>
    </div>
  </section>

  {%- comment -%}============ 02 · TRIẾT LÝ ============{%- endcomment -%}
  <section class="pfa-sec pfa-sec--mint">
    <div class="pfa-wrap">
      <p class="pfa-kicker">02 · Triết lý</p>
      <h2 class="pfa-h2">Triết lý của Phomifood</h2>
      <div class="pfa-grid pfa-grid--3">
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <h3 class="pfa-h3">An toàn là trên hết</h3>
          <p class="pfa-small">Đặt sức khỏe khách hàng làm ưu tiên hàng đầu, 100% sản phẩm kiểm định đạt chuẩn EU.</p>
        </div>
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg></span>
          <h3 class="pfa-h3">Khách hàng là nền tảng</h3>
          <p class="pfa-small">Lấy sự tin tưởng của cộng đồng người Việt làm kim chỉ nam để phát triển bền vững.</p>
        </div>
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h12l3 5-9 11L3 9l3-5z"/><path d="M3 9h18M9 4l3 16 3-16"/></svg></span>
          <h3 class="pfa-h3">Giá trị thật</h3>
          <p class="pfa-small">Cung cấp thực phẩm Việt chính hãng, chuẩn vị, giá tốt cùng dịch vụ giao vận tận tâm.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}============ 03 · SẢN PHẨM ============{%- endcomment -%}
  <section class="pfa-sec pfa-sec--cream">
    <div class="pfa-wrap">
      <p class="pfa-kicker">03 · Sản phẩm</p>
      <p class="pfa-q">Có phải bạn luôn nhớ hương vị quen thuộc nơi xa xứ?</p>
      <h2 class="pfa-h2 pfa-h2--narrow">Phomifood gửi vị Việt đến gian bếp của bạn</h2>
      <p class="pfa-p pfa-p--narrow">Sản phẩm của chúng tôi rất đa dạng. Đặc biệt, chúng tôi chọn lọc một số mặt hàng độc quyền nhập về kho, những món bạn không thể tìm thấy ở nơi khác.</p>
      <div class="pfa-grid pfa-grid--4">
        {%- for row in pfa_cats -%}
          {%- assign parts = row | split: '|' -%}
          {%- assign col = collections[parts[0]] -%}
          {%- assign img = col.image | default: col.products.first.featured_image -%}
          <a class="pfa-cat{% if forloop.last %} pfa-cat--gold{% endif %}" href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
            <span class="pfa-cat__img">
              {%- if img != blank -%}
                {{ img | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(max-width: 749px) 50vw, 25vw', alt: parts[1] }}
              {%- endif -%}
            </span>
            <b>{{ parts[1] }}</b>
            <small>{{ parts[2] }}</small>
          </a>
        {%- endfor -%}
        <a class="pfa-cat pfa-cat--all" href="{{ routes.all_products_collection_url }}">
          <b>Khám phá tất cả sản phẩm</b><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%}============ 04 · KHO HÀNG ============{%- endcomment -%}
  <section class="pfa-sec">
    <div class="pfa-wrap">
      <p class="pfa-kicker">04 · Kho hàng</p>
      <h2 class="pfa-h2">Kho thật tại Praha</h2>
      <p class="pfa-p">Lưu kho, kiểm tra, đóng gói ngay tại Praha, rồi giao tận nhà bạn trong 1–3 ngày.</p>
      <ol class="pfa-steps">
        <li><small>Bước 1</small><b>Nhà sản xuất Việt Nam</b></li>
        <li><small>Bước 2</small><b>Kho Praha</b></li>
        <li><small>Bước 3</small><b>Đóng gói</b></li>
        <li><small>Bước 4</small><b>Giao tận nhà, 1–3 ngày</b></li>
      </ol>
      <div class="pfa-kho">
        {%- for f in pfa_kho -%}
          <figure>
            <img src="{{ pfa_cdn }}{{ f }}&width=480" srcset="{{ pfa_cdn }}{{ f }}&width=320 320w, {{ pfa_cdn }}{{ f }}&width=480 480w, {{ pfa_cdn }}{{ f }}&width=720 720w" sizes="(max-width: 749px) 50vw, 33vw" loading="lazy" decoding="async" alt="Kho Phomifood tại Praha {{ forloop.index }}" width="720" height="540">
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%}============ 05 · ĐỐI TÁC (thương hiệu có tại kho; ảnh = 1 sản phẩm tiêu biểu của hãng) ============{%- endcomment -%}
  <section class="pfa-sec pfa-sec--mint">
    <div class="pfa-wrap">
      <p class="pfa-kicker">05 · Đối tác</p>
      <h2 class="pfa-h2">Đối tác của Phomifood</h2>
      <p class="pfa-p">Những thương hiệu Việt quen thuộc luôn có sẵn tại kho Phomifood.</p>
      <ul class="pfa-brands">
        {%- for row in pfa_brands -%}
          {%- assign parts = row | split: '|' -%}
          {%- assign bp = all_products[parts[1]] -%}
          <li>
            <a href="{{ routes.search_url }}?q={{ parts[0] | url_encode }}&type=product">
              <span class="pfa-brand__logo">
                {%- if bp.featured_image -%}
                  {{ bp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: parts[0] }}
                {%- endif -%}
              </span>
              <b>{{ parts[0] }}</b>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%}============ 06 · VÌ SAO ============{%- endcomment -%}
  <section class="pfa-sec pfa-sec--cream">
    <div class="pfa-wrap">
      <p class="pfa-kicker">06 · Vì sao</p>
      <h2 class="pfa-h2">Vì sao chọn Phomifood</h2>
      <div class="pfa-grid pfa-grid--4">
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <h3 class="pfa-h3">Chuẩn vị &amp; An toàn EU</h3>
          <p class="pfa-small">100% thương hiệu quen thuộc từ Việt Nam, hạn sử dụng xa, đạt đầy đủ tiêu chuẩn kiểm định thực phẩm châu Âu.</p>
        </div>
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 00-14.3-4.9L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0014.3 4.9L20 16"/><path d="M20 20v-4h-4"/></svg></span>
          <h3 class="pfa-h3">Đổi trả minh bạch</h3>
          <p class="pfa-small">Chính sách bảo hành rõ ràng, hỗ trợ đổi trả hoặc hoàn tiền nhanh gọn nếu sản phẩm bị hư hại trong lúc vận chuyển.</p>
        </div>
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg></span>
          <h3 class="pfa-h3">Tối ưu giá, từ lẻ đến sỉ</h3>
          <ul class="pfa-small pfa-list">
            <li><b>Khách lẻ:</b> giá tốt, nhiều combo tiết kiệm cho từng bữa ăn.</li>
            <li><b>Khách sỉ:</b> chiết khấu cao, nguồn hàng ổn định cho nhà hàng, quán ăn và tiệm tạp hóa.</li>
          </ul>
        </div>
        <div class="pfa-card">
          <span class="pfa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 6h12v10H2z"/><path d="M14 9h4l4 4v3h-8"/><circle cx="6" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/></svg></span>
          <h3 class="pfa-h3">Giao nhanh toàn Châu Âu</h3>
          <p class="pfa-small">Hàng luôn có sẵn tại kho Praha, đóng gói chống sốc kỹ càng và giao tận cửa khắp các nước EU trong 1–3 ngày.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}============ 06 · ƯU ĐÃI ============{%- endcomment -%}
  <section class="pfa-sec pfa-sec--rose">
    <div class="pfa-wrap pfa-center">
      <p class="pfa-kicker">07 · Ưu đãi</p>
      <h2 class="pfa-h2 pfa-h2--red">Nhẹ ví hơn cùng Phomifood</h2>
      <p class="pfa-p">Freeship, giảm giá, combo: mua cho cả nhà mà không lo xót ví.</p>
      <div class="pfa-grid pfa-grid--3">
        <div class="pfa-offer">
          <span class="pfa-pill">Đơn từ 139€</span>
          <h3>MIỄN PHÍ SHIP</h3>
          <p class="pfa-small">Đức, Séc, Ba Lan, Slovakia, Hungary, Bulgaria, Romania, Áo, Croatia, Ý, Bỉ, Pháp, Hà Lan, Tây Ban Nha, Bồ Đào Nha, Hy Lạp, Luxembourg, Slovenia: <b>miễn phí vận chuyển</b> cho đơn từ <b>139€</b> (tới 30 kg).</p>
        </div>
        <div class="pfa-offer">
          <span class="pfa-pill">Đơn từ 139€</span>
          <h3>GIẢM 10%</h3>
          <p class="pfa-small">Ireland, Đan Mạch, Phần Lan, Thụy Điển: <b>giảm 10% tiền hàng</b> cho đơn từ <b>139€</b>, tự động áp dụng khi thanh toán.</p>
        </div>
        <div class="pfa-offer">
          <span class="pfa-pill">Combo</span>
          <h3>TIẾT KIỆM</h3>
          <p class="pfa-small">Combo gom sẵn món, rẻ hơn so với mua lẻ. Không biết chọn gì? Có combo rồi.</p>
          {%- assign pfa_combo = collections['combo'] -%}
          <a class="pfa-link" href="{% if pfa_combo != blank %}{{ pfa_combo.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Xem combo →</a>
        </div>
      </div>
      <p class="pfa-note"><b>Lưu ý:</b> Các chương trình ưu đãi có thể thay đổi theo từng thời điểm. Vui lòng kiểm tra thông tin ưu đãi hiện hành trên website trước khi đặt hàng.</p>
    </div>
  </section>

  {%- comment -%}============ 07 · KHÁCH HÀNG ============{%- endcomment -%}
  <section class="pfa-sec">
    <div class="pfa-wrap">
      <p class="pfa-kicker">08 · Khách hàng</p>
      <h2 class="pfa-h2">Khách nói gì</h2>
      <p class="pfa-p">Mỗi đơn là một hành trình từ kho Praha đến bếp nhà khách.</p>
      <div class="pfa-grid pfa-grid--3">
        {%- for f in pfa_fb -%}
          <figure class="pfa-fb">
            <img src="{{ pfa_cdn }}{{ f }}?width=600" srcset="{{ pfa_cdn }}{{ f }}?width=400 400w, {{ pfa_cdn }}{{ f }}?width=600 600w" sizes="(max-width: 749px) 100vw, 33vw" loading="lazy" decoding="async" alt="Phản hồi thật của khách hàng Phomifood {{ forloop.index }}">
          </figure>
        {%- endfor -%}
      </div>
      <a class="pfa-link" href="/pages/feedback-khach-hang">Xem tất cả đánh giá →</a>
    </div>
  </section>

  {%- comment -%}============ CTA CUỐI ============{%- endcomment -%}
  <section class="pfa-cta">
    <div class="pfa-wrap pfa-center">
      <h2>Gom đồ Việt về nhà thôi!</h2>
      <p>Phở, bún, mì, gia vị quen thuộc, giao tận cửa trong 1–3 ngày.</p>
      <div class="pfa-cta__btns">
        <a class="pfa-btn pfa-btn--white" href="{{ routes.all_products_collection_url }}">Đi chợ ngay</a>
        <a class="pfa-btn pfa-btn--line" href="{% if pfa_combo != blank %}{{ pfa_combo.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Xem combo tiết kiệm</a>
      </div>
    </div>
  </section>
</div>

<style>
  .pfa { --g: #1e8541; --g-d: #14672f; --cream: #faf5ea; --mint: #eaf3ec; --rose: #fdece6; --red: #c0261f; --ink: #2f2b25; --mut: #6b6357; --line: #ece4d6; color: var(--ink); }
  .pfa *, .pfa *::before, .pfa *::after { box-sizing: border-box; }
  .pfa-wrap { max-width: 120rem; margin: 0 auto; padding: 0 clamp(1.6rem, 4vw, 3.2rem); }
  .pfa-sec { padding: clamp(4rem, 7vw, 7.2rem) 0; background: #fff; }
  .pfa-sec--cream { background: var(--cream); }
  .pfa-sec--mint { background: var(--mint); }
  .pfa-sec--rose { background: var(--rose); }
  .pfa-center { text-align: center; }
  .pfa-split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.4rem, 5vw, 6rem); align-items: center; }

  .pfa-kicker { margin: 0 0 .8rem; font-size: 1.2rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
  .pfa-hero__title { margin: 0; font-size: clamp(4.4rem, 7vw, 7.6rem); font-weight: 900; line-height: 1.02; color: var(--g-d); letter-spacing: .01em; }
  .pfa-hero__tag { margin: 1rem 0 1.6rem; font-size: clamp(2rem, 2.6vw, 2.8rem); font-weight: 800; color: var(--g); line-height: 1.25; }
