<script>
  (function () {
    var root = document.querySelector('.pfs');
    if (!root) return;
    var sel = root.querySelector('#pfs-country');
    var chips = root.querySelectorAll('.pfs-chip');
    var rows = root.querySelectorAll('tbody tr');
    var empty = root.querySelector('.pfs__empty');
    var count = root.querySelector('.pfs__count');
    var filter = 'all';

    // Thêm nhãn ưu đãi cạnh tên nước (hiện trên điện thoại)
    rows.forEach(function (r) {
      var b = r.querySelector('.pfs-offer-cell .pfs-badge');
      if (b) { var c = b.cloneNode(true); c.classList.add('pfs-row-badge'); r.querySelector('th').appendChild(c); }
    });

    function apply() {
      var cc = sel.value, shown = 0;
      rows.forEach(function (r) {
        var ok = (!cc || r.dataset.cc === cc) && (cc || filter === 'all' || r.dataset.offer === filter);
        r.hidden = !ok;
        r.classList.toggle('is-hit', !!cc && ok);
        if (ok) shown++;
      });
      empty.style.display = shown ? 'none' : 'block';
      count.textContent = 'Đang hiển thị ' + shown + ' / ' + rows.length + ' nước';
    }
    sel.addEventListener('change', function () {
      if (sel.value) { filter = 'all'; chips.forEach(function (c) { c.setAttribute('aria-pressed', c.dataset.filter === 'all'); }); }
      apply();
    });
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        filter = c.dataset.filter; sel.value = '';
        chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c); });
        apply();
      });
    });
    apply();
  })();
</script>
