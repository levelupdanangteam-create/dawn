{%- comment -%}
  Trang Tra cứu phí ship. Số liệu lấy từ cấu hình vận chuyển trong Shopify
  (Settings → Shipping and delivery → General profile) ngày 23/10/2026.
  Khi đổi phí ship trong Shopify, nhớ cập nhật lại bảng này.
{%- endcomment -%}
<style>
  .pfs { --g: #1f8a43; --g-d: #14672f; --y: #ffc61a; --ink: #22201c; --mut: #6b645a; --line: #e7e2d6; --soft: #f4f8f1;
    padding: 3.2rem 0 6rem; color: var(--ink); }
  .pfs__wrap { max-width: 112rem; margin-inline: auto; padding-inline: clamp(1.6rem, 4vw, 4rem); }
  .pfs__head { text-align: center; max-width: 72rem; margin: 0 auto 2.8rem; }
  .pfs__eyebrow { display: inline-block; font-size: 1.25rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: var(--g); background: #e6f3e9; padding: .5rem 1.2rem; border-radius: 999px; }
  .pfs__title { font-family: var(--font-heading-family, sans-serif); font-weight: 900; font-size: clamp(2.8rem, 4.4vw, 4.4rem);
    line-height: 1.1; margin: 1.2rem 0 1rem; color: var(--g-d); }
  .pfs__lead { font-size: 1.6rem; line-height: 1.6; color: var(--mut); margin: 0; }

  .pfs__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-bottom: 2.4rem; }
  .pfs-note { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.6rem 1.8rem; }
  .pfs-note h2 { display: flex; align-items: center; gap: .8rem; margin: 0 0 .8rem; font-size: 1.6rem; line-height: 1.3; color: var(--ink); }
  .pfs-note h2 i { flex: none; width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 1.5rem; }
  .pfs-note p, .pfs-note li { margin: 0; font-size: 1.4rem; line-height: 1.6; color: #4a453d; }
  .pfs-note ul { margin: 0; padding-left: 1.8rem; }
  .pfs-note li + li { margin-top: .3rem; }
  .pfs-note--w i { background: #e6f3e9; }
  .pfs-note--f { border-color: #bfe0c8; background: #f3faf4; }
  .pfs-note--f i { background: var(--g); color: #fff; }
  .pfs-note--d { border-color: #f1dc9c; background: #fffaea; }
  .pfs-note--d i { background: var(--y); }

  .pfs__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; background: #fff; border: 1px solid var(--line);
    border-radius: 14px 14px 0 0; border-bottom: 0; padding: 1.4rem 1.6rem; }
  .pfs__select { position: relative; flex: 0 1 28rem; }
  .pfs__select label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .pfs__select select { width: 100%; appearance: none; -webkit-appearance: none; font: inherit; font-size: 1.5rem; font-weight: 600;
    color: var(--ink); background: var(--soft); border: 1.5px solid #cfe3d3; border-radius: 10px; padding: 1rem 3.6rem 1rem 1.4rem; cursor: pointer; }
  .pfs__select select:focus-visible { outline: 2px solid var(--g); outline-offset: 2px; }
  .pfs__select::after { content: ""; position: absolute; right: 1.4rem; top: 50%; width: .8rem; height: .8rem; margin-top: -.6rem;
    border-right: 2px solid var(--g); border-bottom: 2px solid var(--g); transform: rotate(45deg); pointer-events: none; }
  .pfs__chips { display: flex; flex-wrap: wrap; gap: .8rem; }
  .pfs-chip { font: inherit; font-size: 1.35rem; font-weight: 700; cursor: pointer; border: 1.5px solid var(--line); background: #fff;
    color: #4a453d; border-radius: 999px; padding: .75rem 1.4rem; transition: background .15s, border-color .15s, color .15s; }
  .pfs-chip:hover { border-color: #b9d8c1; }
  .pfs-chip[aria-pressed="true"] { background: var(--g); border-color: var(--g); color: #fff; }
  .pfs-chip small { font-size: 1.15rem; font-weight: 700; opacity: .75; margin-left: .3rem; }
  .pfs__count { margin-left: auto; font-size: 1.3rem; color: var(--mut); }

  .pfs__table-wrap { background: #fff; border: 1px solid var(--line); border-radius: 0 0 14px 14px; overflow: hidden; }
  .pfs table { width: 100%; border-collapse: collapse; }
  .pfs thead th { background: var(--g-d); color: #fff; font-size: 1.25rem; font-weight: 800; letter-spacing: .02em; text-align: left;
    padding: 1.2rem 1.4rem; white-space: nowrap; }
  .pfs thead th:first-child { padding-left: 1.8rem; }
  .pfs tbody th, .pfs tbody td { padding: 1.2rem 1.4rem; border-top: 1px solid var(--line); text-align: left; vertical-align: middle; font-weight: 400; }
  .pfs tbody th { padding-left: 1.8rem; }
  .pfs tbody tr:nth-child(even) { background: #fbfaf6; }
  .pfs tbody tr:hover { background: var(--soft); }
  .pfs tbody tr.is-hit { background: #fff6d6; }
  .pfs tbody tr[hidden] { display: none !important; }
  .pfs-country { display: inline-flex; align-items: center; gap: 1rem; font-size: 1.5rem; font-weight: 700; white-space: nowrap; }
  .pfs-country img { width: 2.4rem; height: 1.6rem; object-fit: cover; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
  .pfs-price { display: block; font-size: 1.55rem; font-weight: 800; color: var(--ink); white-space: nowrap; }
  .pfs-free { display: block; font-size: 1.15rem; font-weight: 700; color: var(--g); white-space: nowrap; margin-top: .1rem; }
  .pfs-na { font-size: 1.35rem; font-weight: 600; color: var(--mut); font-style: italic; }
  .pfs-badge { display: inline-block; font-size: 1.2rem; font-weight: 800; padding: .45rem 1rem; border-radius: 999px; white-space: nowrap; }
  .pfs-badge--free { background: #e2f3e6; color: var(--g-d); }
  .pfs-badge--d10 { background: #fff0bf; color: #6a5200; }
  .pfs-badge--none { background: #f1efea; color: var(--mut); font-weight: 700; }
  .pfs__empty { display: none; padding: 2.4rem; text-align: center; font-size: 1.5rem; color: var(--mut); }
  .pfs__foot { margin-top: 1.6rem; font-size: 1.3rem; line-height: 1.6; color: var(--mut); }
  .pfs__foot a { color: var(--g); font-weight: 700; }

  @media screen and (max-width: 989px) {
    .pfs__notes { grid-template-columns: 1fr; }
    .pfs__count { margin-left: 0; width: 100%; }
  }
  /* Điện thoại: mỗi nước thành một thẻ */
  @media screen and (max-width: 749px) {
    .pfs { padding-top: 2.2rem; }
    .pfs__wrap { display: flex; flex-direction: column; }
    .pfs__head { order: 1; margin-bottom: 1.8rem; }
    .pfs__bar { order: 2; }
    .pfs__table-wrap { order: 3; }
    .pfs__notes { order: 4; margin: 1.4rem 0 0; }
    .pfs__foot { order: 5; }
    .pfs__lead { font-size: 1.45rem; }
    .pfs__bar { border-radius: 14px; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; padding: 1.2rem; }
    .pfs__select { flex: 1 1 100%; }
    .pfs-chip { font-size: 1.25rem; padding: .65rem 1.1rem; }
    .pfs__table-wrap { background: none; border: 0; border-radius: 0; overflow: visible; }
    .pfs thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .pfs table, .pfs tbody { display: block; }
    .pfs tbody tr { display: grid; grid-template-columns: 1fr 1fr; background: #fff !important; border: 1px solid var(--line);
      border-radius: 14px; margin-bottom: 1rem; overflow: hidden; }
    .pfs tbody tr.is-hit { border-color: var(--y); box-shadow: 0 0 0 2px var(--y); }
    .pfs tbody th { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      border-top: 0; background: var(--soft); padding: 1.1rem 1.4rem; }
    .pfs tbody td { border-top: 1px solid var(--line); padding: 1rem 1.4rem; }
    .pfs tbody td:nth-of-type(odd) { border-left: 1px solid var(--line); }
    .pfs tbody td::before { content: attr(data-label); display: block; font-size: 1.15rem; font-weight: 700; color: var(--mut); margin-bottom: .2rem; }
    .pfs tbody td.pfs-offer-cell { display: none; }
    .pfs-row-badge { display: inline-block; }
  }
  @media screen and (min-width: 750px) { .pfs-row-badge { display: none; } }
</style>

