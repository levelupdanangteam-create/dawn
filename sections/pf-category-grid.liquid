{%- comment -%}
  Danh mục sản phẩm — kiểu icon tròn (tham khảo "Kategorien" của MAOMAO):
  tiêu đề trái + "Xem tất cả" phải, mỗi danh mục = ảnh tròn + tên ngắn bên dưới.
  Máy tính: dàn đều nhiều cột; điện thoại: trượt ngang 1–2 hàng.
  Ảnh ưu tiên: ảnh tải lên → URL ảnh → ảnh danh mục → ảnh sản phẩm đầu tiên → emoji.
{%- endcomment -%}
<style>
  #pf-catgrid-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__grid {
    display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop | default: 12 }}, minmax(0, 1fr)); gap: 1.6rem 1.2rem;
  }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item { display: flex; flex-direction: column; align-items: center; gap: .8rem; text-decoration: none; text-align: center; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img {
    width: 100%; max-width: 9.6rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: #f7f1e9; border: 2px solid #ece3d4; display: grid; place-items: center;
    transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img img { width: 100%; height: 100%; object-fit: cover; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img--contain img { object-fit: contain; padding: 14%; background: #fff; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img .placeholder-svg { width: 100%; height: 100%; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__emoji { font-size: 3.4rem; line-height: 1; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item:hover .pf-catgrid__img { border-color: #1e8541; transform: translateY(-3px); box-shadow: 0 8px 18px rgba(20,90,45,.16); }
  #pf-catgrid-{{ section.id }} .pf-catgrid__name { font-size: 1.3rem; font-weight: 700; line-height: 1.25; color: #2a2622; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item:hover .pf-catgrid__name { color: #1e8541; }
  @media (max-width: 989px) {
    #pf-catgrid-{{ section.id }} .pf-catgrid__grid {
      grid-auto-flow: column; grid-template-columns: none; grid-template-rows: repeat({{ section.settings.rows_mobile | default: 2 }}, auto);
      grid-auto-columns: 7.6rem; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: .8rem; scrollbar-width: none;
    }
    #pf-catgrid-{{ section.id }} .pf-catgrid__grid::-webkit-scrollbar { display: none; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__item { scroll-snap-align: start; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__name { font-size: 1.2rem; }
  }
</style>

{%- liquid
  if request.locale.iso_code == 'vi'
    assign all_label = section.settings.all_button_label | default: 'Xem tất cả danh mục'
  else
    assign all_label = 'pf.view_all' | t
  endif
-%}
<div id="pf-catgrid-{{ section.id }}">
  <div class="pf-panel">
    <div class="pf-panel__inner">
      <div class="pf-rowhead">
        <h2 class="pf-rowhead__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        {%- if section.settings.show_all_button -%}
          <a class="pf-rowhead__all" href="{{ section.settings.all_button_link | default: routes.collections_url }}">
            {{ all_label }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="pf-catgrid__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            if block.settings.label != blank
              capture cat_label
                render 'pf-tr', s: block.settings.label
              endcapture
            elsif col != blank
              assign cat_label = col.title
            else
              assign cat_label = 'Category'
            endif
            assign cat_url = col.url | default: routes.collections_url
            assign img = block.settings.image
            assign contain = false
            if img == blank and block.settings.image_url == blank and col != blank
              if col.featured_image
                assign img = col.featured_image
              elsif col.products.first.featured_image
                assign img = col.products.first.featured_image
                assign contain = true
              endif
            endif
          -%}
          <a class="pf-catgrid__item" href="{{ cat_url }}" {{ block.shopify_attributes }}>
            <span class="pf-catgrid__img{% if contain %} pf-catgrid__img--contain{% endif %}">
              {%- if block.settings.image_url != blank and block.settings.image == blank -%}
                <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="96" height="96">
              {%- elsif img != blank -%}
                {{ img | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, alt: '' }}
              {%- elsif block.settings.emoji != blank -%}
                <span class="pf-catgrid__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="pf-catgrid__name">{{ cat_label | strip }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Danh Mục Sản Phẩm",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Danh Mục Sản Phẩm" },
    { "type": "checkbox", "id": "show_all_button", "label": "Hiện link \"Xem tất cả danh mục\"", "default": true },
    { "type": "text", "id": "all_button_label", "label": "Chữ của link", "default": "Xem tất cả danh mục" },
    { "type": "url", "id": "all_button_link", "label": "Liên kết (mặc định: trang bộ sưu tập)" },
    { "type": "range", "id": "columns_desktop", "min": 4, "max": 12, "step": 1, "label": "Số cột trên máy tính", "default": 12 },
    { "type": "range", "id": "rows_mobile", "min": 1, "max": 2, "step": 1, "label": "Số hàng trên điện thoại", "default": 2 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Ô danh mục",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Bộ sưu tập" },
        { "type": "text", "id": "label", "label": "Tên hiển thị (nếu chưa chọn bộ sưu tập)" },
        { "type": "image_picker", "id": "image", "label": "Ảnh (tải lên)" },
        { "type": "text", "id": "image_url", "label": "Hoặc dán URL ảnh" },
        { "type": "text", "id": "emoji", "label": "Emoji dự phòng", "info": "Hiện trong vòng tròn khi không có ảnh nào (ảnh tải lên, URL, ảnh danh mục, ảnh sản phẩm đầu tiên)." },
        { "type": "text", "id": "price_text", "label": "Chữ badge giá (không dùng ở kiểu icon)" },
        { "type": "color", "id": "badge_color", "label": "Màu badge (không dùng ở kiểu icon)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Danh Mục Sản Phẩm",
      "blocks": [
        { "type": "category" }, { "type": "category" }, { "type": "category" },
        { "type": "category" }, { "type": "category" }, { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
