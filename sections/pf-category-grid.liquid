{%- comment -%}
  Danh mục sản phẩm — kiểu icon tròn (tham khảo "Kategorien" của MAOMAO):
  tiêu đề trái + "Xem tất cả" phải, mỗi danh mục = ảnh tròn + tên ngắn bên dưới.
  Máy tính: dàn đều nhiều cột; điện thoại: trượt ngang 1–2 hàng.
  Ảnh ưu tiên: ảnh tải lên → URL ảnh → ảnh danh mục → ảnh sản phẩm đầu tiên → emoji.
{%- endcomment -%}
{%- liquid
  assign pf_cat_cols = section.settings.columns_desktop | default: 12
  if section.blocks.size > 0 and section.blocks.size < pf_cat_cols
    assign pf_cat_cols = section.blocks.size
  endif
-%}
<style>
  /* Tối giản: không khung, không viền đậm, không bóng — chỉ vòng tròn nhạt + tên */
  #pf-catgrid-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__wrap { max-width: var(--page-width, 120rem); margin: 0 auto; padding: 0 clamp(1.6rem, 3vw, 3rem); }
  #pf-catgrid-{{ section.id }} .pf-catgrid__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1.6rem; margin-bottom: 2.4rem; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__title { margin: 0; font-family: var(--font-heading-family, sans-serif); font-weight: 600; font-size: clamp(1.8rem, 1.8vw, 2.2rem); letter-spacing: -.01em; line-height: 1.2; color: #2a2622; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__all {
    flex: none; font-size: 1.3rem; font-weight: 500; color: #6a6255; text-decoration: none; white-space: nowrap;
    border-bottom: 1px solid currentColor; padding-bottom: .1rem; transition: color .15s ease;
  }
  #pf-catgrid-{{ section.id }} .pf-catgrid__all svg { display: none; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__all:hover { color: #1e8541; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__grid {
    display: grid; grid-template-columns: repeat({{ pf_cat_cols }}, minmax(0, 1fr)); gap: 2.4rem 1.6rem;
  }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-decoration: none; text-align: center; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img {
    width: 100%; max-width: 8.8rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: #efeae2; display: grid; place-items: center;
    transition: transform .25s ease, background-color .25s ease;
  }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img img { width: 100%; height: 100%; object-fit: cover; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img--contain img { object-fit: contain; padding: 16%; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__img .placeholder-svg { width: 100%; height: 100%; opacity: .5; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__emoji { font-size: 2.8rem; line-height: 1; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item:hover .pf-catgrid__img { transform: scale(1.05); background: #e6efe7; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__name { font-size: 1.3rem; font-weight: 500; line-height: 1.3; color: #4a443c; transition: color .15s ease; }
  #pf-catgrid-{{ section.id }} .pf-catgrid__item:hover .pf-catgrid__name { color: #1e8541; }
  @media (max-width: 989px) {
    #pf-catgrid-{{ section.id }} .pf-catgrid__head { margin-bottom: 1.6rem; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__grid {
      grid-auto-flow: column; grid-template-columns: none; grid-template-rows: repeat({{ section.settings.rows_mobile | default: 2 }}, auto);
      grid-auto-columns: 7.2rem; gap: 1.8rem 1.4rem; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: .4rem; scrollbar-width: none;
    }
    #pf-catgrid-{{ section.id }} .pf-catgrid__grid::-webkit-scrollbar { display: none; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__item { scroll-snap-align: start; gap: .8rem; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__emoji { font-size: 2.4rem; }
    #pf-catgrid-{{ section.id }} .pf-catgrid__name { font-size: 1.2rem; }
  }
</style>

{%- liquid
  if request.locale.iso_code == 'vi'
    assign all_label = section.settings.all_button_label | default: 'Xem tất cả danh mục'
  else
    assign all_label = 'View all'
  endif
-%}
<div id="pf-catgrid-{{ section.id }}">
  <div class="pf-catgrid__wrap">
    <div class="pf-catgrid__inner">
      <div class="pf-catgrid__head">
        {%- liquid
          assign cat_heading = section.settings.heading
          if request.locale.iso_code != 'vi' and cat_heading == 'Danh Mục Sản Phẩm'
            assign cat_heading = 'Shop by category'
          endif
        -%}
        <h2 class="pf-catgrid__title">{{ cat_heading }}</h2>
        {%- if section.settings.show_all_button -%}
          <a class="pf-catgrid__all" href="{{ section.settings.all_button_link | default: routes.collections_url }}">
            {{ all_label }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="pf-catgrid__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            if block.settings.label != blank
              assign cat_label = block.settings.label
              if request.locale.iso_code != 'vi'
                case cat_label
                  when 'Combo tiết kiệm'
                    assign cat_label = 'Value bundles'
                  when 'Đồ uống'
                    assign cat_label = 'Drinks'
                  when 'Gia vị và bột'
                    assign cat_label = 'Sauces & spices'
                  when 'Thực phẩm chế biến sẵn'
                    assign cat_label = 'Ready to eat'
                  when 'Bánh, kẹo và đồ ăn vặt'
                    assign cat_label = 'Snacks & sweets'
                  when 'Gạo, nếp các loại'
                    assign cat_label = 'Rice'
                  when 'Mì ăn liền'
                    assign cat_label = 'Instant noodles'
                  when 'Bánh tráng'
                    assign cat_label = 'Rice paper'
                  when 'Sữa'
                    assign cat_label = 'Milk & dairy'
                  when 'Bún, phở'
                    assign cat_label = 'Rice noodles & pho'
                endcase
              endif
            elsif col != blank
              assign cat_label = col.title
            else
              assign cat_label = 'Category'
            endif
            assign cat_url = col.url | default: routes.collections_url
            assign img = block.settings.image
            assign contain = false
            if img == blank and block.settings.image_url == blank and col != blank
              if col.featured_image
                assign img = col.featured_image
              elsif col.products.first.featured_image
                assign img = col.products.first.featured_image
                assign contain = true
              endif
            endif
          -%}
          <a class="pf-catgrid__item" href="{{ cat_url }}" {{ block.shopify_attributes }}>
            <span class="pf-catgrid__img{% if contain %} pf-catgrid__img--contain{% endif %}">
              {%- if block.settings.image_url != blank and block.settings.image == blank -%}
                <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="96" height="96">
              {%- elsif img != blank -%}
                {{ img | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, alt: '' }}
              {%- elsif block.settings.emoji != blank -%}
                <span class="pf-catgrid__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              {%- elsif col != blank -%}
                {%- liquid
                  assign h = col.handle
                  assign em = '🛒'
                  if h contains 'combo'
                    assign em = '🎁'
                  elsif h contains 'uống'
                    assign em = '🧃'
                  elsif h contains 'gia-vị'
                    assign em = '🧂'
                  elsif h contains 'chế-biến'
                    assign em = '🥘'
                  elsif h contains 'kẹo'
                    assign em = '🍬'
                  elsif h contains 'gạo'
                    assign em = '🍚'
                  elsif h contains 'mi-an'
                    assign em = '🍜'
                  elsif h contains 'banh-trang'
                    assign em = '🫓'
                  elsif h contains 'sữa'
                    assign em = '🥛'
                  elsif h contains 'phở'
                    assign em = '🍲'
                  elsif h contains 'ban-chay'
                    assign em = '🔥'
                  elsif h contains 'dộc-quyền'
                    assign em = '⭐'
                  endif
                -%}
                <span class="pf-catgrid__emoji" aria-hidden="true">{{ em }}</span>
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="pf-catgrid__name">{{ cat_label | strip }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Danh Mục Sản Phẩm",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Danh Mục Sản Phẩm" },
    { "type": "checkbox", "id": "show_all_button", "label": "Hiện link \"Xem tất cả danh mục\"", "default": true },
    { "type": "text", "id": "all_button_label", "label": "Chữ của link", "default": "Xem tất cả danh mục" },
    { "type": "url", "id": "all_button_link", "label": "Liên kết (mặc định: trang bộ sưu tập)" },
    { "type": "range", "id": "columns_desktop", "min": 4, "max": 12, "step": 1, "label": "Số cột trên máy tính", "default": 12 },
    { "type": "range", "id": "rows_mobile", "min": 1, "max": 2, "step": 1, "label": "Số hàng trên điện thoại", "default": 2 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Ô danh mục",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Bộ sưu tập" },
        { "type": "text", "id": "label", "label": "Tên hiển thị (nếu chưa chọn bộ sưu tập)" },
        { "type": "image_picker", "id": "image", "label": "Ảnh (tải lên)" },
        { "type": "text", "id": "image_url", "label": "Hoặc dán URL ảnh" },
        { "type": "text", "id": "emoji", "label": "Emoji dự phòng", "info": "Hiện trong vòng tròn khi không có ảnh nào (ảnh tải lên, URL, ảnh danh mục, ảnh sản phẩm đầu tiên)." },
        { "type": "text", "id": "price_text", "label": "Chữ badge giá (không dùng ở kiểu icon)" },
        { "type": "color", "id": "badge_color", "label": "Màu badge (không dùng ở kiểu icon)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Danh Mục Sản Phẩm",
      "blocks": [
        { "type": "category" }, { "type": "category" }, { "type": "category" },
        { "type": "category" }, { "type": "category" }, { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
