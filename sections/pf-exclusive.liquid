{%- comment -%}
  "Chỉ có tại Phomifood" — sản phẩm độc quyền (Vifon, đồ chay, combo…).
  Render theo danh sách handle trong cài đặt (mặc định đã điền sẵn). Sửa
  danh sách trong Theme editor, không cần chọn từng block.
{%- endcomment -%}
<style>
  #pf-ex-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-ex-{{ section.id }} .pf-wrap { max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: clamp(1.6rem, 3vw, 3rem); }
  #pf-ex-{{ section.id }} .pf-wrap {
    background: linear-gradient(180deg, #eaf6ee 0%, #d8ecdf 100%);
    border: 1px solid #bfe0c9;
    padding-block: clamp(2.4rem, 4vw, 4rem);
  }
  #pf-ex-{{ section.id }} .pf-ex { --cols: {{ section.settings.columns_desktop }}; }
  #pf-ex-{{ section.id }} .pf-ex__head { text-align: center; margin-bottom: 2.8rem; }
  #pf-ex-{{ section.id }} .pf-ex__eyebrow {
    display: inline-flex; align-items: center; gap: .5rem; font-size: 1.2rem; font-weight: 800;
    letter-spacing: .14em; text-transform: uppercase; color: #b8791a;
    background: #fff6e2; border: 1px solid #f0d99a; padding: .4rem 1rem; border-radius: 999px; margin-bottom: 1rem;
  }
  #pf-ex-{{ section.id }} .pf-ex__title { font-family: var(--font-heading-family, sans-serif); font-weight: 800; font-size: clamp(2.2rem, 3.4vw, 3.2rem); color: #2a2622; margin: 0; line-height: 1.15; }
  #pf-ex-{{ section.id }} .pf-ex__title::after { content: ""; display: block; width: 6rem; height: 4px; border-radius: 4px; margin: 1.2rem auto 0; background: linear-gradient(90deg, #1e8541, #63c98a); }
  #pf-ex-{{ section.id }} .pf-ex__sub { margin: 1rem auto 0; max-width: 56ch; color: #6b6357; font-size: 1.45rem; }

  #pf-ex-{{ section.id }} .pf-ex__grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 1.8rem; }
  #pf-ex-{{ section.id }} .pf-ex__card {
    position: relative; background: #fff; border: 1px solid #ece4d8; border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  #pf-ex-{{ section.id }} .pf-ex__card:hover { transform: translateY(-5px); box-shadow: 0 16px 36px rgba(20,103,47,.14); border-color: #bfe6cc; }
  #pf-ex-{{ section.id }} .pf-ex__badge {
    position: absolute; top: 0; left: 0; z-index: 3;
    display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; font-size: 1.1rem; color: #fff;
    background: linear-gradient(135deg, #1e8541, #14672f); padding: .45rem .9rem; border-radius: 16px 0 16px 0;
    box-shadow: 0 4px 10px rgba(0,0,0,.15);
  }
  #pf-ex-{{ section.id }} .pf-ex__media { position: relative; aspect-ratio: 1; background: #f7f1e9; display: grid; place-items: center; overflow: hidden; }
  #pf-ex-{{ section.id }} .pf-ex__media img, #pf-ex-{{ section.id }} .pf-ex__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  #pf-ex-{{ section.id }} .pf-ex__card:hover .pf-ex__media img { transform: scale(1.06); }
  #pf-ex-{{ section.id }} .pf-ex__sale { position: absolute; top: 1rem; right: 1rem; background: #d62828; color: #fff; font-size: 1.1rem; font-weight: 800; padding: .35rem .8rem; border-radius: 7px; }

  #pf-ex-{{ section.id }} .pf-ex__info { padding: 1.3rem 1.4rem 1.6rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  #pf-ex-{{ section.id }} .pf-ex__info .pf-card-actions { margin-top: auto; }
  #pf-ex-{{ section.id }} .pf-ex__nm { margin: 0; font-size: 1.4rem; font-weight: 600; line-height: 1.35; color: #2a2622; }
  #pf-ex-{{ section.id }} .pf-ex__nm a { color: inherit; text-decoration: none; }
  #pf-ex-{{ section.id }} .pf-ex__nm a:hover { color: #1e8541; }
  #pf-ex-{{ section.id }} .pf-ex__price { display: flex; align-items: baseline; gap: .8rem; font-variant-numeric: tabular-nums; }
  #pf-ex-{{ section.id }} .pf-ex__price .now { font-size: 1.65rem; font-weight: 800; color: #1e8541; }
  #pf-ex-{{ section.id }} .pf-ex__price .was { font-size: 1.2rem; color: #a79c8e; text-decoration: line-through; }

  #pf-ex-{{ section.id }} .pf-ex__card--hidden { display: none; }
  #pf-ex-{{ section.id }} .pf-ex.is-expanded .pf-ex__card--hidden { display: flex; }
  #pf-ex-{{ section.id }} .pf-ex__more-wrap { text-align: center; margin-top: 2.6rem; }
  #pf-ex-{{ section.id }} .pf-ex__more {
    display: inline-flex; align-items: center; gap: .6rem; cursor: pointer;
    background: #fff; border: 2px solid #1e8541; color: #14672f; font-weight: 800; font-size: 1.5rem;
    padding: 1rem 2.6rem; border-radius: 999px; transition: background .18s ease, color .18s ease;
  }
  #pf-ex-{{ section.id }} .pf-ex__more:hover { background: #1e8541; color: #fff; }
  #pf-ex-{{ section.id }} .pf-ex__more .arw { transition: transform .2s ease; }
  #pf-ex-{{ section.id }} .pf-ex.is-expanded .pf-ex__more .arw { transform: rotate(180deg); }

  @media (max-width: 989px) { #pf-ex-{{ section.id }} .pf-ex__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 599px) { #pf-ex-{{ section.id }} .pf-ex__grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; } }
</style>

{%- assign pf_handles = section.settings.product_handles | newline_to_br | split: '<br />' -%}
{%- assign pf_initial = section.settings.pf_initial | default: 10 -%}
{%- comment -%} Ưu tiên lấy sản phẩm từ Danh mục (collection). Mặc định = "Hàng độc quyền"; có thể đổi trong Theme editor. Nếu không có thì dùng danh sách handle. {%- endcomment -%}
{%- assign pf_col = section.settings.collection -%}
{%- if pf_col == blank -%}{%- assign pf_col = collections['hang-độc-quyền'] -%}{%- endif -%}
{%- assign pf_use_col = false -%}
{%- if pf_col != blank and pf_col.products_count > 0 -%}
  {%- assign pf_use_col = true -%}
  {%- assign pf_valid = pf_col.products_count -%}
{%- else -%}
  {%- assign pf_valid = 0 -%}
  {%- for h in pf_handles -%}
    {%- assign hh = h | strip | remove: '<br>' | strip -%}
    {%- if hh != blank and all_products[hh] != blank and all_products[hh].id -%}{%- assign pf_valid = pf_valid | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div id="pf-ex-{{ section.id }}" class="pf-boxed-section">
  <div class="pf-wrap">
    <div class="pf-ex">
      <div class="pf-ex__head">
        {%- if section.settings.eyebrow != blank -%}<span class="pf-ex__eyebrow">⭐ {% render 'pf-tr', s: section.settings.eyebrow %}</span>{%- endif -%}
        <h2 class="pf-ex__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        {%- if section.settings.subheading != blank -%}<p class="pf-ex__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>{%- endif -%}
      </div>

      {%- assign pf_shown = 0 -%}
      <div class="pf-ex__grid">
        {%- if pf_use_col -%}
          {%- for product in pf_col.products -%}
            {%- if product != blank and product.id -%}
              {%- assign pf_shown = pf_shown | plus: 1 -%}
              {%- if pf_shown > pf_initial -%}
                {% render 'pf-ex-card', product: product, section_id: section.id, hidden: true %}
              {%- else -%}
                {% render 'pf-ex-card', product: product, section_id: section.id %}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for h in pf_handles -%}
            {%- assign hh = h | strip | remove: '<br>' | strip -%}
            {%- assign product = all_products[hh] -%}
            {%- if hh != blank and product != blank and product.id -%}
              {%- assign pf_shown = pf_shown | plus: 1 -%}
              {%- if pf_shown > pf_initial -%}
                {% render 'pf-ex-card', product: product, section_id: section.id, hidden: true %}
              {%- else -%}
                {% render 'pf-ex-card', product: product, section_id: section.id %}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if pf_valid == 0 -%}
          <p class="pf-ex__sub">{% if request.locale.iso_code == "vi" %}Chưa có sản phẩm — chọn Danh mục hàng độc quyền hoặc thêm handle trong cài đặt section.{% else %}No products yet — pick a collection or add product handles in section settings.{% endif %}</p>
        {%- endif -%}
      </div>

      {%- if pf_valid > pf_initial -%}
        <div class="pf-ex__more-wrap">
          <button type="button" class="pf-ex__more" data-pf-ex-more>
            <span class="pf-ex__more-txt">{% if request.locale.iso_code == "vi" %}Xem thêm{% else %}View more{% endif %}</span>
            <span class="arw" aria-hidden="true">▾</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('pf-ex-{{ section.id }}');
    if (!root) return;
    var ex = root.querySelector('.pf-ex');
    var btn = root.querySelector('[data-pf-ex-more]');
    if (!ex || !btn) return;
    var txt = btn.querySelector('.pf-ex__more-txt');
    var vi = '{{ request.locale.iso_code }}' === 'vi';
    btn.addEventListener('click', function () {
      var expanded = ex.classList.toggle('is-expanded');
      if (txt) txt.textContent = expanded ? (vi ? 'Thu gọn' : 'View less') : (vi ? 'Xem thêm' : 'View more');
    });
  })();
</script>

{% schema %}
{
  "name": "Chỉ có tại Phomifood",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nhãn nhỏ", "default": "Sản phẩm độc quyền" },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Chỉ có tại Phomifood" },
    { "type": "text", "id": "subheading", "label": "Phụ đề", "default": "Những món độc quyền chỉ Phomifood mới có — không tìm thấy ở nơi nào khác tại châu Âu." },
    { "type": "collection", "id": "collection", "label": "Danh mục hàng độc quyền", "info": "Mặc định đã lấy danh mục 'Hàng độc quyền'. Chọn danh mục khác ở đây nếu muốn đổi. Để trống = dùng danh mục mặc định." },
    { "type": "textarea", "id": "product_handles", "label": "Danh sách sản phẩm (dự phòng — mỗi dòng 1 handle)", "info": "Chỉ dùng khi KHÔNG chọn danh mục ở trên. Handle lấy từ URL sản phẩm (phần sau /products/).", "default": "miến-lẩu-thai-vifon\ncombo-4-hộp-ca-thu-chien-sốt-tương-ớt-roza\nkho-quẹt-chay\ncốt-lếch-chay\nsườn-chay-xao-sả-ớt\nsườn-non-chay\nbun-bo-huế-vifon-thịt-thật\ncombo-5-goi-banh-da-trộn-vifon\nmỳ-quảng-hội-an-an-liền-cathifood-4-vị\ncanh-chua-isoup" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Số cột (desktop)", "default": 5 },
    { "type": "range", "id": "pf_initial", "min": 3, "max": 20, "step": 1, "label": "Số sản phẩm hiện ban đầu (còn lại ẩn sau nút Xem thêm)", "default": 10 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "presets": [
    { "name": "Chỉ có tại Phomifood" }
  ]
}
{% endschema %}
