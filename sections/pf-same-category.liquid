{%- comment -%}
  PHOMIFOOD — "Sản phẩm cùng danh mục" ở cuối trang sản phẩm.
  Tự chọn danh mục chính của sản phẩm:
    1) danh mục đầu tiên trong "Danh mục ưu tiên" mà sản phẩm thuộc về;
    2) nếu không có → bộ sưu tập đầu tiên của sản phẩm, bỏ qua các bộ sưu tập
       chung (bán chạy, sale, độc quyền...) trong "Bỏ qua".
  Hiện các sản phẩm khác trong danh mục đó (còn hàng trước) trên 1 hàng trượt ngang có nút trước/sau.
  Chọn "Bộ sưu tập cố định" → luôn hiện bộ sưu tập đó (dùng cho "Sản phẩm đang được quan tâm").
  Không tìm được danh mục → tự tải "Sản phẩm liên quan" do Shopify gợi ý, nên trang nào cũng có.
  Giao diện thẻ đồng bộ với trang chủ: nhãn -x% đỏ, giá mới xanh + giá gạch xám, nhãn Đã bán, nút xanh lá.
{%- endcomment -%}
{%- liquid
  assign vi = false
  if request.locale.iso_code == 'vi'
    assign vi = true
  endif
  assign limit = section.settings.products_to_show
  assign heading = section.settings.heading
  assign pick = nil
  assign src = nil

  if section.settings.fixed_collection != blank
    # Bộ sưu tập cố định (VD: "Sản phẩm đang được quan tâm" = Bán chạy nhất).
    assign pick = section.settings.fixed_collection
    assign src = pick.products
  elsif recommendations.performed
    # Lần tải thứ 2 (qua JS) khi không tìm được danh mục: lấy "Sản phẩm liên quan" do Shopify gợi ý.
    assign src = recommendations.products
    assign heading = section.settings.related_heading
  else
    assign prio = section.settings.category_handles | newline_to_br | strip_newlines | split: '<br />'
    assign skip = section.settings.exclude_handles | newline_to_br | strip_newlines | split: '<br />'
    for h in prio
      assign hh = h | strip
      for c in product.collections
        if c.handle == hh and c.products_count > 1
          assign pick = c
          break
        endif
      endfor
      if pick
        break
      endif
    endfor
    unless pick
      for c in product.collections
        assign is_skip = false
        for s in skip
          assign ss = s | strip
          if ss != blank and c.handle == ss
            assign is_skip = true
          endif
        endfor
        if is_skip == false and c.products_count > 1
          assign pick = c
          break
        endif
      endfor
    endunless
    if pick
      assign src = pick.products
    endif
  endif
-%}
{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- if src -%}
    {%- comment -%} Còn hàng trước, hết hàng sau. {%- endcomment -%}
    {%- for pass in (1..2) -%}
      {%- for p in src -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
        <div class="pf-sc__card{% unless p.available %} is-out{% endunless %}">
          <a class="pf-sc__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if p.compare_at_price > p.price -%}
              <span class="pf-sc__sale">-{{ p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round }}%</span>
            {%- endif -%}
            {%- unless p.available -%}<span class="pf-sc__oos">{% if vi %}Hết hàng{% else %}Sold out{% endif %}</span>{%- endunless -%}
            {%- if p.featured_image -%}
              <img src="{{ p.featured_image | image_url: width: 500 }}" srcset="{{ p.featured_image | image_url: width: 300 }} 300w, {{ p.featured_image | image_url: width: 500 }} 500w" sizes="(max-width: 749px) 45vw, 300px" alt="{{ p.title | escape }}" loading="lazy" width="500" height="500">
            {%- endif -%}
          </a>
          <div class="pf-sc__body">
            <h3 class="pf-sc__nm"><a href="{{ p.url }}" title="{{ p.title | escape }}">{% render 'pf-short-title', title: p.title %}</a></h3>
            <div class="pf-sc__sold">{% render 'pf-sold-badge', p: p %}</div>
            <div class="pf-sc__price">
              <span class="now">{{ p.price | money }}</span>
              {%- if p.compare_at_price > p.price -%}<s class="was">{{ p.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {% render 'pf-card-buttons', product: p, section_id: section.id %}
          </div>
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  if section.settings.fixed_collection != blank
    assign pf_eyebrow = '🔥 Được khách hàng săn đón'
    assign pf_eyebrow_en = '🔥 Trending now'
  elsif recommendations.performed
    assign pf_eyebrow = '✨ Gợi ý cho bạn'
    assign pf_eyebrow_en = '✨ Picked for you'
  else
    assign pf_eyebrow = '🧺 Cùng danh mục'
    assign pf_eyebrow_en = '🧺 Same category'
  endif
-%}

<div class="pf-sc-holder" data-pf-sc-holder>
  {%- if shown > 0 -%}
  <div class="pf-sc page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="pf-sc__box">
      <div class="pf-sc__head">
        <div class="pf-sc__htext">
          <span class="pf-sc__eyebrow">{% if vi %}{{ pf_eyebrow }}{% else %}{{ pf_eyebrow_en }}{% endif %}</span>
          <h2 class="pf-sc__title">{{ heading | remove: '🔥' | strip }}</h2>
        </div>
        {%- if pick -%}<a class="pf-sc__cat" href="{{ pick.url }}">{% if vi %}Xem tất cả{% else %}View all{% endif %} <b>{{ pick.title }}</b> <span aria-hidden="true">→</span></a>{%- endif -%}
      </div>
      <div class="pf-sc__slider">
        <button type="button" class="pf-sc__arrow pf-sc__arrow--prev" data-pf-sc-prev aria-label="{% if vi %}Sản phẩm trước{% else %}Previous{% endif %}" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="pf-sc__grid" data-pf-sc-track>{{ cards }}</div>
        <button type="button" class="pf-sc__arrow pf-sc__arrow--next" data-pf-sc-next aria-label="{% if vi %}Sản phẩm tiếp{% else %}Next{% endif %}" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>
  {%- elsif product and recommendations.performed != true and section.settings.fixed_collection == blank -%}
    {%- comment -%} Không có danh mục phù hợp → tải "Sản phẩm liên quan" của Shopify. {%- endcomment -%}
    <div data-pf-sc-rec="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"></div>
  {%- endif -%}
</div>

  <style>
    .pf-sc { --g: #1e8541; --g-d: #14672f; --y: #ffc61a; --r: #d62828; --ink: #2a2622; }
    /* Tràn viền: cùng bề ngang với phần chi tiết sản phẩm phía trên */
    .pf-sc.page-width { max-width: 150rem; padding-inline: clamp(1.6rem, 3vw, 4.8rem); }
    .pf-sc__box {
      position: relative; overflow: hidden; border-radius: 24px; border: 1px solid #dfeee3;
      background: radial-gradient(120% 140% at 0% 0%, #eef8f1 0%, #ffffff 45%, #fffbef 100%);
      padding: clamp(2.2rem, 3.2vw, 3.6rem) clamp(1.6rem, 3vw, 3.2rem); box-shadow: 0 14px 36px rgba(20, 103, 47, .08);
    }
    .pf-sc__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.2rem 2rem; margin-bottom: 2.4rem; }
    .pf-sc__eyebrow { display: inline-block; background: var(--y); color: var(--ink); font-size: 1.15rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: .45rem 1.2rem; border-radius: 999px; }
    .pf-sc__title { margin: 1rem 0 0; font-family: var(--font-heading-family, sans-serif); font-weight: 900; font-size: clamp(2.2rem, 2.8vw, 3rem); line-height: 1.15; color: var(--g); }
    .pf-sc__title::after { content: ""; display: block; width: 6rem; height: 4px; border-radius: 4px; margin-top: 1rem; background: linear-gradient(90deg, var(--g), var(--y)); }
    .pf-sc__cat { display: inline-flex; align-items: center; gap: .5rem; font-size: 1.35rem; font-weight: 700; color: var(--g-d); text-decoration: none; background: #fff; border: 2px solid var(--g); padding: .8rem 1.8rem; border-radius: 999px; transition: background .15s, color .15s; }
    .pf-sc__cat b { font-weight: 800; }
    .pf-sc__cat:hover { background: var(--g); color: #fff; }
    /* 1 hàng trượt ngang + nút trước/sau (không xếp nhiều hàng) */
    .pf-sc__slider { position: relative; --gap: clamp(1.2rem, 1.6vw, 2rem); --per: 5; }
    .pf-sc__grid {
      display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: .4rem .2rem 1rem;
    }
    .pf-sc__grid::-webkit-scrollbar { display: none; }
    .pf-sc__card {
      flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); scroll-snap-align: start;
      display: flex; flex-direction: column; min-width: 0; background: #fff; border: 1px solid #ece4d8; border-radius: 16px; overflow: hidden;
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .pf-sc__card:hover { transform: translateY(-4px); border-color: #bfe0c7; box-shadow: 0 14px 30px rgba(20, 103, 47, .12); }
    .pf-sc__arrow {
      position: absolute; top: 38%; transform: translateY(-50%); z-index: 3; width: 4.4rem; height: 4.4rem; border-radius: 50%;
      border: 0; padding: 0; cursor: pointer; display: grid; place-items: center; background: #fff; color: var(--ink);
      box-shadow: 0 6px 18px rgba(0,0,0,.16); transition: background .15s, color .15s;
    }
    .pf-sc__arrow:hover { background: var(--g); color: #fff; }
    .pf-sc__arrow[hidden] { display: none; }
    .pf-sc__arrow--prev { left: -1.2rem; }
    .pf-sc__arrow--next { right: -1.2rem; }
    .pf-sc__media { display: grid; place-items: center; aspect-ratio: 1; overflow: hidden; background: #fff; position: relative; }
    .pf-sc__media img { width: 100%; height: 100%; object-fit: contain; padding: 10px; transition: transform .3s ease; }
    .pf-sc__card:hover .pf-sc__media img { transform: scale(1.05); }
    .pf-sc__card.is-out .pf-sc__media img { opacity: .55; }
    .pf-sc__sale { position: absolute; top: 1rem; right: 1rem; z-index: 1; background: var(--r); color: #fff; font-weight: 800; font-size: 1.1rem; line-height: 1.2; padding: .35rem .8rem; border-radius: 7px; }
    .pf-sc__oos { position: absolute; top: 1rem; left: 1rem; z-index: 1; background: #6b6357; color: #fff; font-weight: 800; font-size: 1.05rem; padding: .35rem .8rem; border-radius: 7px; }
    .pf-sc__body { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .6rem; flex: 1; padding: 1.2rem 1.2rem 1.4rem; border-top: 1px solid #f3eee5; }
    .pf-sc__nm { margin: 0; width: 100%; font-size: 1.4rem; font-weight: 600; line-height: 1.35; min-height: 2.7em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pf-sc__nm a { color: var(--ink); text-decoration: none; }
    .pf-sc__nm a:hover { color: var(--g-d); }
    .pf-sc__sold { min-height: 2.6rem; display: flex; align-items: center; justify-content: center; }
    .pf-sc__price { display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; gap: .2rem .8rem; font-variant-numeric: tabular-nums; }
    .pf-sc__price .now { color: var(--g); font-weight: 800; font-size: 1.8rem; line-height: 1.2; }
    .pf-sc__price .was { color: #a79c8e; font-size: 1.3rem; }
    .pf-sc__body .pf-card-actions { width: 100%; margin-top: auto; padding-top: .4rem; gap: .6rem; }
    .pf-sc .pf-card-actions .pf-btn-cart, .pf-sc .pf-card-actions .pf-btn-view {
      border-radius: 999px !important; border: 1.5px solid var(--g) !important;
      font-size: 1.3rem !important; font-weight: 700 !important; padding: .9rem .6rem !important;
    }
    .pf-sc .pf-card-actions .pf-btn-cart { background: #ffc61a !important; border-color: #ffc61a !important; color: #14672f !important; }
    .pf-sc .pf-card-actions .pf-btn-cart:hover:not([disabled]) { background: #f5b400 !important; border-color: #f5b400 !important; color: #14672f !important; }
    .pf-sc .pf-card-actions .pf-btn-cart[disabled] { background: #b9b3a8 !important; border-color: #b9b3a8 !important; color: #fff !important; opacity: 1 !important; }
    .pf-sc .pf-card-actions .pf-btn-view { background: #fff !important; color: var(--g-d) !important; }
    .pf-sc .pf-card-actions .pf-btn-view:hover { background: #e9f5ed !important; }
    @media (max-width: 1199px) { .pf-sc__slider { --per: 4; } }
    @media (max-width: 989px) { .pf-sc__slider { --per: 3; } }
    @media (max-width: 749px) {
      .pf-sc__box { border-radius: 18px; padding: 2rem 1.2rem; }
      .pf-sc__head { margin-bottom: 1.8rem; }
      .pf-sc__title { font-size: 2.2rem; }
      .pf-sc__cat { font-size: 1.25rem; padding: .65rem 1.4rem; }
      .pf-sc__slider { --per: 2.2; --gap: 1rem; }
      .pf-sc__arrow { width: 3.6rem; height: 3.6rem; }
      .pf-sc__arrow--prev { left: -.4rem; }
      .pf-sc__arrow--next { right: -.4rem; }
      .pf-sc__body { padding: 1rem .8rem 1.2rem; }
      .pf-sc__nm { font-size: 1.3rem; }
      .pf-sc__price .now { font-size: 1.6rem; }
      .pf-sc__price .was { font-size: 1.2rem; }
      .pf-sc .pf-card-actions .pf-btn-cart, .pf-sc .pf-card-actions .pf-btn-view { font-size: 1.15rem !important; padding: .75rem .4rem !important; }
    }
  </style>
  <script>
    (function () {
      // Nút trước/sau: trượt đúng 1 khung nhìn, tự ẩn khi ở đầu/cuối hoặc khi không tràn.
      function bindSlider(root) {
        root.querySelectorAll('.pf-sc__slider:not([data-bound])').forEach(function (sl) {
          sl.setAttribute('data-bound', '1');
          var track = sl.querySelector('[data-pf-sc-track]');
          var prev = sl.querySelector('[data-pf-sc-prev]');
          var next = sl.querySelector('[data-pf-sc-next]');
          if (!track || !prev || !next) return;
          var update = function () {
            var max = track.scrollWidth - track.clientWidth;
            prev.hidden = max <= 4 || track.scrollLeft < 8;
            next.hidden = max <= 4 || track.scrollLeft > max - 8;
          };
          var step = function () {
            var c = track.querySelector('.pf-sc__card');
            if (!c) return track.clientWidth;
            var gap = parseFloat(getComputedStyle(track).columnGap) || 16;
            var per = Math.max(1, Math.floor((track.clientWidth + gap) / (c.offsetWidth + gap)));
            return per * (c.offsetWidth + gap);
          };
          next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
          prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
          track.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          window.addEventListener('load', update);
          update();
        });
      }
      bindSlider(document);
      document.querySelectorAll('[data-pf-sc-rec]:not([data-bound])').forEach(function (el) {
        el.setAttribute('data-bound', '1');
        fetch(el.getAttribute('data-pf-sc-rec'))
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var box = doc.querySelector('.pf-sc');
            var holder = el.closest('[data-pf-sc-holder]');
            if (box && holder) { holder.innerHTML = ''; holder.appendChild(box); bindSlider(holder); }
          })
          .catch(function () {});
      });
    })();
  </script>

{% schema %}
{
  "name": "Sản phẩm cùng danh mục",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Tự lấy danh mục chính của sản phẩm đang xem và hiện các sản phẩm khác trong danh mục đó (còn hàng trước) trên 1 hàng trượt ngang." },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Sản phẩm cùng danh mục" },
    { "type": "collection", "id": "fixed_collection", "label": "Bộ sưu tập cố định (để trống = tự lấy danh mục của sản phẩm)" },
    { "type": "text", "id": "related_heading", "label": "Tiêu đề khi không có danh mục (Shopify gợi ý)", "default": "Sản phẩm liên quan" },
    { "type": "textarea", "id": "category_handles", "label": "Danh mục ưu tiên (mỗi dòng 1 handle bộ sưu tập)", "default": "bun-phở-kho\nmi-an-liền\nbột-gia-vị\ndồ-uống\nsữa-cac-loại\nbanh-kẹo-dồ-an-vặt\nthực-phẩm-chế-biến-sẵn\ngạo-nếp-cac-loại\nbanh-trang-cac-loại\ncombo" },
    { "type": "textarea", "id": "exclude_handles", "label": "Bỏ qua các bộ sưu tập chung (mỗi dòng 1 handle)", "default": "ban-chay-nhat\nsieu-sale-10-10\nhang-dộc-quyền\nall\nfrontpage" },
    { "type": "range", "id": "products_to_show", "label": "Số sản phẩm tối đa", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "range", "id": "initial_count", "label": "(Không còn dùng — giờ hiện 1 hàng trượt ngang)", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Khoảng cách trên", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Khoảng cách dưới", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Sản phẩm cùng danh mục" } ]
}
{% endschema %}
