{%- comment -%}
  Section wrapper for the "Thường được mua kèm" (frequently bought together)
  block, so it can be ordered on the product template AFTER the reviews section.
  The actual markup lives in snippets/pf-bought-together.liquid.
{%- endcomment -%}
{% render 'pf-bought-together' %}

{% schema %}
{
  "name": "Thường được mua kèm",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Sản phẩm có trường Mua kèm (custom.bought_together) sẽ hiện 3 món mua kèm có ô tick, tổng tiền và nút thêm tất cả vào giỏ. Sản phẩm chưa có trường này hiện sản phẩm từ bộ sưu tập bán chạy (ban-chay-nhat). Đặt section này ngay dưới mục Đánh giá trên trang sản phẩm." }
  ],
  "presets": [ { "name": "Thường được mua kèm" } ]
}
{% endschema %}
