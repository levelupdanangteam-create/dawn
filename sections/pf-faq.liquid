{%- comment -%}
  Câu hỏi thường gặp dạng xổ xuống (kiểu HuongViet): nhóm tiêu đề + câu hỏi/đáp.
  Dùng <details> gốc của trình duyệt nên chạy không cần JS.
{%- endcomment -%}
<style>
  #pf-faq-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-faq-{{ section.id }} .pf-faq__wrap { max-width: 78rem; margin-inline: auto; }
  #pf-faq-{{ section.id }} .pf-faq__title { text-align: center; margin: 0 0 2rem; font-family: var(--font-heading-family, sans-serif); font-weight: 800; font-size: clamp(2.2rem, 2.8vw, 2.8rem); color: #2a2622; }
  #pf-faq-{{ section.id }} .pf-faq__group { margin: 2.4rem 0 .6rem; font-size: 1.7rem; font-weight: 800; color: #1e8541; }
  #pf-faq-{{ section.id }} .pf-faq__group:first-of-type { margin-top: 0; }
  #pf-faq-{{ section.id }} details { border-bottom: 1px solid #ece3d4; }
  #pf-faq-{{ section.id }} summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem;
    padding: 1.4rem .2rem; font-size: 1.5rem; font-weight: 600; color: #2a2622;
  }
  #pf-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #pf-faq-{{ section.id }} summary::after {
    content: "+"; flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center;
    background: #f7f1e9; color: #1e8541; font-size: 1.8rem; font-weight: 700; line-height: 1; transition: transform .2s ease;
  }
  #pf-faq-{{ section.id }} details[open] summary::after { content: "–"; background: #1e8541; color: #fff; }
  #pf-faq-{{ section.id }} summary:hover { color: #1e8541; }
  #pf-faq-{{ section.id }} .pf-faq__a { padding: 0 .2rem 1.6rem; font-size: 1.45rem; line-height: 1.6; color: #4a443c; }
  #pf-faq-{{ section.id }} .pf-faq__a p { margin: 0 0 .8rem; }
  #pf-faq-{{ section.id }} .pf-faq__a p:last-child { margin-bottom: 0; }
</style>

<div id="pf-faq-{{ section.id }}">
  <div class="pf-panel{% unless section.settings.boxed %} pf-panel--flat{% endunless %}">
    <div class="pf-panel__inner">
      <div class="pf-faq__wrap">
        {%- if section.settings.heading != blank -%}<h2 class="pf-faq__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'group' -%}
            <h3 class="pf-faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
          {%- else -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="pf-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Câu hỏi thường gặp",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "boxed", "label": "Đặt trong khung trắng", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 12 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 12 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Nhóm câu hỏi",
      "settings": [{ "type": "text", "id": "title", "label": "Tên nhóm", "default": "Shipping" }]
    },
    {
      "type": "question",
      "name": "Câu hỏi",
      "settings": [
        { "type": "text", "id": "question", "label": "Câu hỏi", "default": "Which countries do you ship to?" },
        { "type": "richtext", "id": "answer", "label": "Trả lời", "default": "<p>Write your answer here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Câu hỏi thường gặp", "blocks": [{ "type": "group" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
