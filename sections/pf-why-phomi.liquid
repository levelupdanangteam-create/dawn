{%- comment -%}
  "Vì sao chọn Phomifood" — HÀNH TRÌNH GỌN (vừa 1 khung hình).
  Con đường nối các chặng: Tổng kho Praha → … → bếp nhà khách. Khi khách lướt qua, đường tô xanh dần,
  xe giao hàng chạy theo và từng chặng sáng lên.
  Máy tính: 4 chặng nằm ngang, đường chạy ngang phía trên. Điện thoại: chặng xếp dọc gọn, đường bên trái.
{%- endcomment -%}
<style>
  #pf-jr-{{ section.id }} {
    --g: #1e8541; --g-d: #14672f; --y: #ffc61a; --ink: #2a2622; --mut: #5a5346;
    position: relative; overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #pf-jr-{{ section.id }} .pf-jr__wrap { max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: clamp(1.6rem, 4vw, 5rem); }
  #pf-jr-{{ section.id }} .pf-jr__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.4rem; }
  #pf-jr-{{ section.id }} .pf-jr__eyebrow { margin: 0 0 .6rem; color: var(--g); font-size: 1.2rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  #pf-jr-{{ section.id }} .pf-jr__title { margin: 0; font-family: var(--font-heading-family, sans-serif); font-weight: 900; font-size: clamp(2.2rem, 2.8vw, 3.2rem); line-height: 1.15; color: var(--g-d); }
  #pf-jr-{{ section.id }} .pf-jr__title span { color: var(--ink); }
  #pf-jr-{{ section.id }} .pf-jr__cta {
    flex: none; display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; white-space: nowrap;
    background: linear-gradient(90deg, var(--g), var(--g-d)); color: #fff; font-weight: 800; font-size: 1.4rem;
    padding: 1.1rem 2rem; border-radius: 999px; box-shadow: 0 6px 16px rgba(20, 103, 47, .25); transition: transform .15s ease;
  }
  #pf-jr-{{ section.id }} .pf-jr__cta:hover { transform: translateY(-2px); color: #fff; }

  /* Đường + chặng */
  #pf-jr-{{ section.id }} .pf-jr__road { position: relative; display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 1.6rem; padding-top: 4.4rem; }
  #pf-jr-{{ section.id }} .pf-jr__track, #pf-jr-{{ section.id }} .pf-jr__fill { position: absolute; border-radius: 4px; }
  #pf-jr-{{ section.id }} .pf-jr__track { background: repeating-linear-gradient(90deg, #ddd5c4 0 10px, transparent 10px 18px); }
  #pf-jr-{{ section.id }} .pf-jr__fill { background: linear-gradient(90deg, var(--g), var(--g-d)); }
  #pf-jr-{{ section.id }} .pf-jr__truck {
    position: absolute; left: 0; top: 0; z-index: 3; width: 4.4rem; height: 4.4rem; margin: -2.2rem 0 0 -2.2rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--y); color: var(--g-d);
    box-shadow: 0 0 0 5px rgba(255,198,26,.28), 0 8px 16px rgba(20,103,47,.25);
  }
  #pf-jr-{{ section.id }} .pf-jr__truck svg { width: 2.2rem; height: 2.2rem; }
  #pf-jr-{{ section.id }} .pf-jr__stop { position: relative; display: flex; flex-direction: column; min-width: 0; }
  #pf-jr-{{ section.id }} .pf-jr__dot {
    position: absolute; left: 50%; top: -2.8rem; width: 1.8rem; height: 1.8rem; margin: -.9rem 0 0 -.9rem; border-radius: 50%; z-index: 2;
    background: #fff; border: 3px solid #d9d1c0; transition: border-color .3s ease, background .3s ease, transform .3s ease;
  }
  #pf-jr-{{ section.id }} .pf-jr__stop.is-in .pf-jr__dot { border-color: var(--g); background: var(--y); transform: scale(1.15); }
  #pf-jr-{{ section.id }} .pf-jr__card {
    flex: 1 1 auto; display: flex; flex-direction: column; background: #fff; border: 1px solid #e6eadf; border-radius: 16px; overflow: hidden;
    box-shadow: 0 8px 22px rgba(20, 90, 45, .07);
    opacity: .35; transform: translateY(1.2rem); filter: grayscale(.6); transition: opacity .5s ease, transform .5s ease, filter .5s ease;
  }
  #pf-jr-{{ section.id }} .pf-jr__stop.is-in .pf-jr__card { opacity: 1; transform: none; filter: none; }
  #pf-jr-{{ section.id }} .pf-jr__img { flex: none; aspect-ratio: 16 / 9; background: #eef4ef; overflow: hidden; }
  #pf-jr-{{ section.id }} .pf-jr__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #pf-jr-{{ section.id }} .pf-jr__body { flex: 1 1 auto; display: flex; flex-direction: column; padding: 1.3rem 1.5rem 1.5rem; min-width: 0; }
  #pf-jr-{{ section.id }} .pf-jr__kicker { display: flex; align-items: center; gap: .6rem; margin: 0 0 .5rem; font-size: 1.15rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--g); }
  #pf-jr-{{ section.id }} .pf-jr__kicker b { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--g); color: #fff; font-size: 1.1rem; letter-spacing: 0; }
  #pf-jr-{{ section.id }} .pf-jr__st { margin: 0 0 .4rem; font-size: 1.6rem; font-weight: 800; line-height: 1.3; color: var(--g-d); }
  #pf-jr-{{ section.id }} .pf-jr__sd { margin: 0; font-size: 1.35rem; line-height: 1.45; color: var(--mut); }
  #pf-jr-{{ section.id }} .pf-jr__link { margin-top: auto; padding-top: .8rem; font-size: 1.3rem; font-weight: 800; color: var(--g); text-decoration: none; white-space: nowrap; }
  #pf-jr-{{ section.id }} .pf-jr__link:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Điện thoại: chặng xếp dọc, ảnh nhỏ bên trái, đường dọc bên trái */
  @media screen and (max-width: 749px) {
    #pf-jr-{{ section.id }} .pf-jr__head { display: block; margin-bottom: 1.6rem; }
    #pf-jr-{{ section.id }} .pf-jr__head .pf-jr__cta { display: none; }
    #pf-jr-{{ section.id }} .pf-jr__road { grid-template-columns: 1fr; gap: 1rem; padding: 0 0 0 3.6rem; }
    #pf-jr-{{ section.id }} .pf-jr__track { background: repeating-linear-gradient(180deg, #ddd5c4 0 8px, transparent 8px 14px); }
    #pf-jr-{{ section.id }} .pf-jr__fill { background: linear-gradient(180deg, var(--g), var(--g-d)); }
    #pf-jr-{{ section.id }} .pf-jr__truck { width: 3.4rem; height: 3.4rem; margin: -1.7rem 0 0 -1.7rem; box-shadow: 0 0 0 4px rgba(255,198,26,.28), 0 6px 12px rgba(20,103,47,.25); }
    #pf-jr-{{ section.id }} .pf-jr__truck svg { width: 1.7rem; height: 1.7rem; }
    #pf-jr-{{ section.id }} .pf-jr__dot { left: -2.2rem; top: 50%; width: 1.4rem; height: 1.4rem; margin: -.7rem 0 0 -.7rem; }
    #pf-jr-{{ section.id }} .pf-jr__card { flex-direction: row; align-items: center; border-radius: 14px; transform: translateX(1rem); }
    #pf-jr-{{ section.id }} .pf-jr__img { width: 7.2rem; aspect-ratio: 1 / 1; align-self: stretch; }
    #pf-jr-{{ section.id }} .pf-jr__body { padding: 1rem 1.2rem; }
    #pf-jr-{{ section.id }} .pf-jr__kicker { display: none; }
    #pf-jr-{{ section.id }} .pf-jr__st { font-size: 1.45rem; margin-bottom: .2rem; }
    #pf-jr-{{ section.id }} .pf-jr__sd { font-size: 1.2rem; line-height: 1.4; }
    #pf-jr-{{ section.id }} .pf-jr__link { padding-top: .3rem; font-size: 1.2rem; }
    #pf-jr-{{ section.id }} .pf-jr__end { margin-top: 1.4rem; }
    #pf-jr-{{ section.id }} .pf-jr__end .pf-jr__cta { display: flex; justify-content: center; width: 100%; }
  }
  @media screen and (min-width: 750px) { #pf-jr-{{ section.id }} .pf-jr__end { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    #pf-jr-{{ section.id }} .pf-jr__card { opacity: 1 !important; transform: none !important; filter: none !important; transition: none; }
  }
  .shopify-design-mode #pf-jr-{{ section.id }} .pf-jr__card { opacity: 1; transform: none; filter: none; }
</style>

{%- capture pf_cta -%}
  {%- if section.settings.button_label != blank -%}
    <a class="pf-jr__cta" href="{{ section.settings.button_link | default: '/pages/ve-chung-toi' }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
  {%- endif -%}
{%- endcapture -%}

<div id="pf-jr-{{ section.id }}" class="pf-jr">
  <div class="pf-jr__wrap">
    <header class="pf-jr__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pf-jr__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="pf-jr__title">{{ section.settings.heading_1 }}{% if section.settings.heading_2 != blank %} <span>{{ section.settings.heading_2 }}</span>{% endif %}</h2>
      </div>
      {{ pf_cta }}
    </header>

    <div class="pf-jr__road" data-pf-jr-road>
      <div class="pf-jr__track" aria-hidden="true"></div>
      <div class="pf-jr__fill" aria-hidden="true"></div>
      <div class="pf-jr__truck" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </div>
      {%- for block in section.blocks -%}
        <div class="pf-jr__stop" data-pf-jr-stop {{ block.shopify_attributes }}>
          <span class="pf-jr__dot" aria-hidden="true"></span>
          <article class="pf-jr__card">
            {%- if block.settings.image != blank -%}
              <div class="pf-jr__img">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 750px) 25vw, 80px', alt: block.settings.title }}</div>
            {%- elsif block.settings.image_url != blank -%}
              <div class="pf-jr__img"><img src="{{ block.settings.image_url }}" loading="lazy" alt="{{ block.settings.title | escape }}"></div>
            {%- endif -%}
            <div class="pf-jr__body">
              <p class="pf-jr__kicker"><b>{{ forloop.index }}</b> {{ block.settings.kicker }}</p>
              <h3 class="pf-jr__st">{{ block.settings.title }}</h3>
              <p class="pf-jr__sd">{{ block.settings.text }}</p>
              {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                <a class="pf-jr__link" href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>
              {%- endif -%}
            </div>
          </article>
        </div>
      {%- endfor -%}
    </div>

    <div class="pf-jr__end">{{ pf_cta }}</div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('pf-jr-{{ section.id }}');
    if (!root) return;
    var road = root.querySelector('[data-pf-jr-road]');
    var track = root.querySelector('.pf-jr__track'), fill = root.querySelector('.pf-jr__fill'), truck = root.querySelector('.pf-jr__truck');
    var stops = Array.prototype.slice.call(root.querySelectorAll('[data-pf-jr-stop]'));
    if (!road || !stops.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var raf = 0;
    function update() {
      raf = 0;
      var rr = road.getBoundingClientRect(), vh = window.innerHeight;
      var pts = stops.map(function (s) {
        var d = s.querySelector('.pf-jr__dot').getBoundingClientRect();
        return { x: d.left + d.width / 2 - rr.left, y: d.top + d.height / 2 - rr.top };
      });
      var a = pts[0], b = pts[pts.length - 1];
      var vertical = Math.abs(b.y - a.y) > Math.abs(b.x - a.x);
      // Tiến độ: 0 khi đầu khối ở 85% màn hình, 1 khi đầu khối lên tới 25% màn hình
      var p = reduce ? 1 : (vh * 0.85 - rr.top) / (vh * 0.6);
      p = Math.max(0, Math.min(1, p));
      var len = vertical ? (b.y - a.y) : (b.x - a.x);
      if (vertical) {
        track.style.cssText = 'left:' + (a.x - 2) + 'px;top:' + a.y + 'px;width:4px;height:' + len + 'px';
        fill.style.cssText = 'left:' + (a.x - 2) + 'px;top:' + a.y + 'px;width:4px;height:' + (len * p) + 'px';
        truck.style.transform = 'translate(' + a.x + 'px,' + (a.y + len * p) + 'px)';
      } else {
        track.style.cssText = 'left:' + a.x + 'px;top:' + (a.y - 2) + 'px;height:4px;width:' + len + 'px';
        fill.style.cssText = 'left:' + a.x + 'px;top:' + (a.y - 2) + 'px;height:4px;width:' + (len * p) + 'px';
        truck.style.transform = 'translate(' + (a.x + len * p) + 'px,' + a.y + 'px)';
      }
      var n = stops.length;
      stops.forEach(function (s, i) {
        var at = n > 1 ? i / (n - 1) : 0;
        s.classList.toggle('is-in', p >= at - 0.04);
      });
    }
    function later() { if (!raf) raf = requestAnimationFrame(update); }
    window.addEventListener('scroll', later, { passive: true });
    window.addEventListener('resize', later);
    window.addEventListener('load', later);
    update();
  })();
</script>

{% schema %}
{
  "name": "Hành trình Phomifood",
  "tag": "section",
  "class": "pf-why-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Dòng nhỏ phía trên", "default": "Vì sao chọn Phomifood" },
    { "type": "text", "id": "heading_1", "label": "Tiêu đề (phần xanh)", "default": "Từ tổng kho Praha" },
    { "type": "text", "id": "heading_2", "label": "Tiêu đề (phần đậm)", "default": "tới bếp nhà bạn" },
    { "type": "text", "id": "subheading", "label": "Mô tả ngắn (không hiển thị)" },
    { "type": "text", "id": "button_label", "label": "Chữ nút", "default": "Đọc câu chuyện Phomifood" },
    { "type": "url", "id": "button_link", "label": "Liên kết nút (để trống = Về chúng tôi)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 36 }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "Chặng",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Nhãn nhỏ", "default": "Chặng" },
        { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Tiêu đề chặng" },
        { "type": "textarea", "id": "text", "label": "Mô tả (nên 1 câu ngắn)" },
        { "type": "image_picker", "id": "image", "label": "Ảnh" },
        { "type": "text", "id": "image_url", "label": "Hoặc URL ảnh" },
        { "type": "url", "id": "link", "label": "Liên kết (tuỳ chọn)" },
        { "type": "text", "id": "link_label", "label": "Chữ liên kết" }
      ]
    }
  ],
  "presets": [ { "name": "Hành trình Phomifood", "blocks": [ { "type": "stop" }, { "type": "stop" }, { "type": "stop" }, { "type": "stop" } ] } ]
}
{% endschema %}
