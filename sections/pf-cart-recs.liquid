{%- comment -%}
  Trang giỏ hàng — dải "Có thể bạn quan tâm".
  Nguồn: gợi ý Shopify theo sản phẩm đầu tiên trong giỏ (tải bằng JS); nếu chưa có thì lấy từ danh mục chọn sẵn.
  Bỏ qua sản phẩm đã có trong giỏ và sản phẩm hết hàng. Thêm giỏ bằng AJAX rồi tải lại trang giỏ để cập nhật tổng tiền.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign in_cart = ''
  for it in cart.items
    assign in_cart = in_cart | append: ',' | append: it.product_id | append: ','
  endfor
  assign items = blank
  if recommendations.performed? and recommendations.products_count > 0
    assign items = recommendations.products
  elsif section.settings.collection != blank
    assign items = section.settings.collection.products
  endif
  assign shown = 0
-%}
<style>
  #pfcr-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pfcr-{{ section.id }} .pfcr__wrap { max-width: var(--page-width, 120rem); margin: 0 auto; padding: 0 5rem; }
  #pfcr-{{ section.id }} .pfcr__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
  #pfcr-{{ section.id }} .pfcr__title { margin: 0; font-size: clamp(2rem, 2vw, 2.6rem); font-weight: 900; color: #2a2622; }
  #pfcr-{{ section.id }} .pfcr__nav { display: flex; gap: .6rem; }
  #pfcr-{{ section.id }} .pfcr__nav button { width: 4rem; height: 4rem; border-radius: 50%; border: 1px solid #d9d4ca; background: #fff; color: #1e8541; font-size: 1.8rem; font-weight: 800; cursor: pointer; }
  #pfcr-{{ section.id }} .pfcr__nav button:hover { background: #1e8541; color: #fff; border-color: #1e8541; }
  #pfcr-{{ section.id }} .pfcr__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 4 * 1.6rem) / 5); gap: 1.6rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding: .4rem .2rem 1.2rem;
  }
  #pfcr-{{ section.id }} .pfcr__track::-webkit-scrollbar { display: none; }
  #pfcr-{{ section.id }} .pfcr__card { scroll-snap-align: start; display: flex; flex-direction: column; min-width: 0; background: #fff; border: 1px solid #ece5d8; border-radius: 16px; padding: 1.2rem; transition: box-shadow .2s ease; }
  #pfcr-{{ section.id }} .pfcr__card:hover { box-shadow: 0 10px 24px rgba(20, 40, 25, .1); }
  #pfcr-{{ section.id }} .pfcr__media { position: relative; display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #f7f7f5; }
  #pfcr-{{ section.id }} .pfcr__media img, #pfcr-{{ section.id }} .pfcr__media svg { width: 100%; height: 100%; object-fit: contain; display: block; }
  #pfcr-{{ section.id }} .pfcr__badge { position: absolute; top: .6rem; left: .6rem; padding: .25rem .7rem; border-radius: 999px; background: #d62828; color: #fff; font-size: 1.1rem; font-weight: 800; }
  #pfcr-{{ section.id }} .pfcr__name { margin: 1rem 0 0; font-size: 1.4rem; font-weight: 700; line-height: 1.35; color: #2a2622; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.7em; }
  #pfcr-{{ section.id }} .pfcr__name:hover { color: #1e8541; }
  #pfcr-{{ section.id }} .pfcr__price { margin-top: .6rem; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  #pfcr-{{ section.id }} .pfcr__now { font-size: 1.7rem; font-weight: 900; color: #2a2622; }
  #pfcr-{{ section.id }} .pfcr__now.is-sale { color: #d62828; }
  #pfcr-{{ section.id }} .pfcr__was { font-size: 1.35rem; font-weight: 600; color: #6b6b6b; text-decoration-color: #d62828; text-decoration-thickness: 1.5px; }
  #pfcr-{{ section.id }} .pfcr__form { margin-top: auto; padding-top: 1rem; }
  #pfcr-{{ section.id }} .pfcr__add { width: 100%; border: 0; border-radius: 999px; padding: 1rem; cursor: pointer; background: #1e8541; color: #fff; font: inherit; font-size: 1.35rem; font-weight: 800; transition: background .15s ease; }
  #pfcr-{{ section.id }} .pfcr__add:hover { background: #166a33; }
  #pfcr-{{ section.id }} .pfcr__add[disabled] { opacity: .65; cursor: default; }
  @media screen and (max-width: 989px) { #pfcr-{{ section.id }} .pfcr__track { grid-auto-columns: calc((100% - 2 * 1.6rem) / 3); } }
  @media screen and (max-width: 749px) {
    #pfcr-{{ section.id }} .pfcr__wrap { padding: 0 1.6rem; }
    #pfcr-{{ section.id }} .pfcr__nav { display: none; }
    #pfcr-{{ section.id }} .pfcr__track { grid-auto-columns: 46%; gap: 1rem; }
    #pfcr-{{ section.id }} .pfcr__card { padding: .9rem; }
  }
</style>

<div id="pfcr-{{ section.id }}"
  {%- if cart.item_count > 0 %} data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product_id }}&limit={{ limit | plus: 6 }}&intent=related"{% endif %}>
  {%- if items != blank -%}
    <div class="pfcr__wrap">
      <div class="pfcr__head">
        <h2 class="pfcr__title">{{ section.settings.heading }}</h2>
        <div class="pfcr__nav">
          <button type="button" data-dir="-1" aria-label="Trước">‹</button>
          <button type="button" data-dir="1" aria-label="Sau">›</button>
        </div>
      </div>
      <div class="pfcr__track">
        {%- for p in items -%}
          {%- assign pid = ',' | append: p.id | append: ',' -%}
          {%- if p.available == false or in_cart contains pid -%}{%- continue -%}{%- endif -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            assign pct = 0
            capture pf_c
              render 'pf-cmp', v: v
            endcapture
            assign pf_c = pf_c | plus: 0
            if pf_c > v.price
              assign pct = pf_c | minus: v.price | times: 100 | divided_by: pf_c
            endif
          -%}
          <div class="pfcr__card">
            <a class="pfcr__media" href="{{ p.url }}">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 990px) 220px, 46vw', alt: p.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if pct > 0 -%}<span class="pfcr__badge">-{{ pct }}%</span>{%- endif -%}
            </a>
            <a class="pfcr__name" href="{{ p.url }}">{{ p.title }}</a>
            <div class="pfcr__price">
              <span class="pfcr__now{% if pct > 0 %} is-sale{% endif %}">{{ v.price | money }}</span>
              {%- if pct > 0 -%}<s class="pfcr__was">{{ pf_c | money }}</s>{%- endif -%}
            </div>
            <form class="pfcr__form" data-pfcr-add>
              <input type="hidden" name="id" value="{{ v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pfcr__add">+ {% render 'pf-ui', k: 'add' %}</button>
            </form>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('pfcr-{{ section.id }}');
    if (!root || root.dataset.pfInit) return;
    root.dataset.pfInit = '1';
    var base = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    if (root.dataset.url) {
      fetch(root.dataset.url).then(function (r) { return r.text(); }).then(function (t) {
        var tmp = document.createElement('div'); tmp.innerHTML = t;
        var fresh = tmp.querySelector('#pfcr-{{ section.id }}');
        if (fresh && fresh.querySelectorAll('.pfcr__card').length >= 3) root.innerHTML = fresh.innerHTML;
      }).catch(function () {});
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('.pfcr__nav button');
      if (!b) return;
      var tr = root.querySelector('.pfcr__track');
      if (tr) tr.scrollBy({ left: tr.clientWidth * 0.8 * Number(b.dataset.dir), behavior: 'smooth' });
    });
    root.addEventListener('submit', function (e) {
      var form = e.target.closest('[data-pfcr-add]');
      if (!form) return;
      e.preventDefault();
      var btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = '✓';
      fetch(base + 'cart/add.js', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw r; return r.json(); })
        .then(function () { window.location.reload(); })
        .catch(function () { btn.disabled = false; btn.textContent = '+'; });
    });
  })();
</script>

{% schema %}
{
  "name": "SP gợi ý (giỏ hàng)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Có thể bạn quan tâm" },
    { "type": "collection", "id": "collection", "label": "Danh mục dự phòng", "info": "Dùng khi Shopify chưa có gợi ý cho sản phẩm trong giỏ, hoặc giỏ trống." },
    { "type": "range", "id": "limit", "min": 4, "max": 16, "step": 1, "label": "Số sản phẩm", "default": 10 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 48 }
  ],
  "presets": [{ "name": "SP gợi ý (giỏ hàng)" }]
}
{% endschema %}
