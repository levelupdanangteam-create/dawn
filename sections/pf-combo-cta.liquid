{%- comment -%}
  Ô gợi ý Combo ở cuối trang bộ sưu tập.
  "Chỉ hiện ở bộ sưu tập": danh sách handle, cách nhau bằng dấu phẩy (mặc định: all = trang Tất cả sản phẩm).
  Để trống = hiện ở mọi bộ sưu tập. Không bao giờ hiện trên chính bộ sưu tập được liên kết tới.
{%- endcomment -%}
{%- liquid
  assign pf_show = true
  assign pf_cur = collection.handle | default: 'all'
  if section.settings.only_handles != blank
    assign pf_list = section.settings.only_handles | remove: ' ' | split: ','
    unless pf_list contains pf_cur
      assign pf_show = false
    endunless
  endif
  if section.settings.button_link != blank and section.settings.button_link contains pf_cur and pf_cur != 'all'
    assign pf_show = false
  endif
-%}
{%- if pf_show -%}
<style>
  #pf-cc-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-cc-{{ section.id }} .pf-cc__wrap { max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: clamp(1.6rem, 4vw, 5rem); }
  #pf-cc-{{ section.id }} .pf-cc__box {
    position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 3.2rem;
    padding: clamp(3.2rem, 5vw, 6.4rem) clamp(2.4rem, 6vw, 9.6rem); border-radius: 32px;
    background: linear-gradient(120deg, #1e8541 0%, #14672f 100%); color: #fff;
  }
  #pf-cc-{{ section.id }} .pf-cc__deco { position: absolute; pointer-events: none; color: #ffc61a; opacity: .16; }
  #pf-cc-{{ section.id }} .pf-cc__deco--a { top: -5rem; left: -4rem; width: 26rem; }
  #pf-cc-{{ section.id }} .pf-cc__deco--b { bottom: -7rem; right: 18%; width: 30rem; }
  #pf-cc-{{ section.id }} .pf-cc__text { position: relative; max-width: 62rem; }
  #pf-cc-{{ section.id }} .pf-cc__title { margin: 0 0 1.2rem; font-family: var(--font-heading-family, sans-serif); font-weight: 900; font-size: clamp(2.6rem, 4vw, 4.4rem); line-height: 1.12; color: #ffc61a; }
  #pf-cc-{{ section.id }} .pf-cc__sub { margin: 0; font-size: clamp(1.5rem, 1.6vw, 1.9rem); line-height: 1.5; color: #fff; }
  #pf-cc-{{ section.id }} .pf-cc__btn {
    position: relative; flex: none; display: inline-flex; align-items: center; gap: .8rem; white-space: nowrap; text-decoration: none;
    padding: 1.6rem 3.2rem; border-radius: 999px; background: #ffc61a; color: #14672f; font-weight: 800; font-size: 1.7rem;
    box-shadow: 0 10px 22px rgba(0, 0, 0, .18); transition: transform .15s ease, box-shadow .15s ease;
  }
  #pf-cc-{{ section.id }} .pf-cc__btn:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(0, 0, 0, .22); color: #14672f; }
  @media screen and (max-width: 749px) {
    #pf-cc-{{ section.id }} .pf-cc__box { flex-direction: column; align-items: flex-start; gap: 2rem; border-radius: 22px; }
    #pf-cc-{{ section.id }} .pf-cc__btn { width: 100%; justify-content: center; font-size: 1.6rem; padding: 1.4rem 2rem; }
    #pf-cc-{{ section.id }} .pf-cc__deco--b { right: -8rem; width: 22rem; }
  }
</style>
<div id="pf-cc-{{ section.id }}">
  <div class="pf-cc__wrap">
    <div class="pf-cc__box">
      <svg class="pf-cc__deco pf-cc__deco--a" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="5" aria-hidden="true"><circle cx="100" cy="100" r="40"/><circle cx="100" cy="100" r="64"/><circle cx="100" cy="100" r="88"/></svg>
      <svg class="pf-cc__deco pf-cc__deco--b" viewBox="0 0 240 160" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" aria-hidden="true"><path d="M20 120c30-70 90-90 140-60s60 70 60 70"/><path d="M50 140c20-40 60-55 95-35"/><path d="M160 60c10-25 30-40 55-42"/></svg>
      <div class="pf-cc__text">
        <h2 class="pf-cc__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="pf-cc__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="pf-cc__btn" href="{{ section.settings.button_link | default: '/collections/combo' }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Ô gợi ý Combo",
  "tag": "section",
  "class": "pf-combo-cta-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Chưa biết chọn món gì?" },
    { "type": "textarea", "id": "text", "label": "Mô tả", "default": "Phomifood có sẵn combo để bạn chọn." },
    { "type": "text", "id": "button_label", "label": "Chữ nút", "default": "Xem combo" },
    { "type": "url", "id": "button_link", "label": "Liên kết nút" },
    { "type": "text", "id": "only_handles", "label": "Chỉ hiện ở bộ sưu tập (handle, cách nhau dấu phẩy)", "default": "all", "info": "Để trống = hiện ở mọi bộ sưu tập." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 48 }
  ],
  "presets": [ { "name": "Ô gợi ý Combo" } ]
}
{% endschema %}
