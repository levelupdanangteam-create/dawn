{%- comment -%}
  "Combo Phomifood". Kiểu đơn giản (26/10): tiêu đề xanh căn trái + "Xem tất cả", lưới thẻ pf-flash-card, nút "Xem thêm" mở phần còn lại.
  CSS chung ở snippet pf-flash-card (.pf-simple). Giữ class pf-cb__grid / pf-cb__card / pf-cb__more cho script "Xem thêm" mobile.
  Bản cũ lưu ở scratchpad: simple/pf-combo.orig.liquid.
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- assign initial = section.settings.initial_count -%}
{%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

<div id="pf-cb-{{ section.id }}" class="pf-simple" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width pf-simple__full">
    <div class="pf-cb" style="--cols: {{ section.settings.columns_desktop }};">
      <div class="pf-simple__head">
        <h2 class="pf-cb__title pf-simple__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        {%- if col != blank -%}<a class="pf-simple__all" href="{{ col.url }}">{% if vi %}Xem tất cả{% else %}View all{% endif %}</a>{%- endif -%}
      </div>
      {%- if section.settings.subheading != blank -%}<p class="pf-simple__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>{%- endif -%}

      <div class="pf-cb__grid pf-simple__grid">
        {%- if col != blank and col.products_count > 0 -%}
          {%- for product in col.products limit: section.settings.products_to_show -%}
            {%- assign pf_hide = false -%}{%- if forloop.index > initial -%}{%- assign pf_hide = true -%}{%- endif -%}
            {%- render 'pf-flash-card', p: product, section_id: section.id, extra_class: 'pf-cb__card', hidden: pf_hide -%}
          {%- endfor -%}
        {%- else -%}
          <p class="pf-simple__sub">{% if vi %}Chọn bộ sưu tập Combo trong cài đặt section{% else %}Pick the Combo collection in section settings{% endif %}</p>
        {%- endif -%}
      </div>

      {%- liquid
        assign rendered = 0
        if col != blank
          assign rendered = col.products_count
          if rendered > section.settings.products_to_show
            assign rendered = section.settings.products_to_show
          endif
        endif
      -%}
      {%- if section.settings.show_view_all and rendered > initial -%}
        <div class="pf-cb__morewrap pf-simple__more-wrap">
          <button type="button" class="pf-cb__more pf-simple__more">
            {{ section.settings.view_all_label | default: 'Xem thêm' }} <span class="arw" aria-hidden="true">▾</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('pf-cb-{{ section.id }}');
    if (!root) return;
    var btn = root.querySelector('.pf-cb__more');
    if (!btn || btn.dataset.pfInit) return;
    btn.dataset.pfInit = '1';
    btn.addEventListener('click', function () {
      root.querySelectorAll('.pf-cb__card.pf-s10__card--hidden').forEach(function (c) { c.classList.remove('pf-s10__card--hidden'); });
      var wrap = btn.closest('.pf-cb__morewrap');
      if (wrap) wrap.remove();
    });
  })();
</script>

{% schema %}
{
  "name": "Combo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Combo Phomifood" },
    { "type": "text", "id": "subheading", "label": "Phụ đề", "default": "Gói trọn theo nhu cầu — tiết kiệm hơn mua lẻ!" },
    { "type": "collection", "id": "collection", "label": "Bộ sưu tập Combo" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 30, "step": 1, "label": "Số sản phẩm tối đa", "default": 12 },
    { "type": "range", "id": "initial_count", "min": 4, "max": 30, "step": 1, "label": "Số sản phẩm hiện ban đầu", "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Hiện nút Xem thêm", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Nhãn nút Xem thêm", "default": "Xem thêm" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Số cột (desktop)", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "presets": [{ "name": "Combo" }]
}
{% endschema %}
