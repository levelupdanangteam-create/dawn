{%- comment -%}
  PHOMIFOOD — Trà Sâm Thổ Hào: section kể chuyện thương hiệu, dùng riêng cho template sản phẩm này.
  Mỗi block là 1 khối nội dung độc lập, có thể sắp xếp lại / ẩn / nhân bản trong trình chỉnh sửa theme.
{%- endcomment -%}
<div class="pfts" id="pfts-{{ section.id }}">
{%- for block in section.blocks -%}
  {%- case block.type -%}

  {%- when 'pain' -%}
  <div class="pfts-wrap pfts-pain" {{ block.shopify_attributes }}>
    {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--red">{{ block.settings.eyebrow }}</div>{%- endif -%}
    {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    {%- if block.settings.body != blank -%}<div class="pfts-body">{{ block.settings.body }}</div>{%- endif -%}
  </div>

  {%- when 'photo_band' -%}
  <div class="pfts-photoband" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'pfts-photoband__img' }}
    {%- else -%}
      <div class="pfts-pending pfts-pending--band"><span>🖼️</span><em>Ảnh đang chờ cập nhật</em></div>
    {%- endif -%}
    <div class="pfts-photoband__overlay"></div>
    <div class="pfts-photoband__text">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-eyebrow pfts-eyebrow--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<div class="pfts-h3-serif">{{ block.settings.heading }}</div>{%- endif -%}
    </div>
  </div>

  {%- when 'origin' -%}
  <div class="pfts-wrap pfts-origin" {{ block.shopify_attributes }}>
    <div class="pfts-center pfts-intro">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--green">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-body pfts-body--sm">{{ block.settings.body }}</div>{%- endif -%}
    </div>
    <div class="pfts-origin__grid">
      <div class="pfts-origin__main">
        {%- if block.settings.image_main != blank -%}
          {{ block.settings.image_main | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <div class="pfts-pending"><span>🌱</span><em>Toàn cảnh vườn — đang chờ ảnh thật</em></div>
        {%- endif -%}
      </div>
      <div class="pfts-origin__side">
        <div class="pfts-origin__small">
          {%- if block.settings.image_root != blank -%}
            {{ block.settings.image_root | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>🫚</span><em>Cận cảnh củ sâm</em></div>
          {%- endif -%}
        </div>
        <div class="pfts-origin__small">
          {%- if block.settings.image_harvest != blank -%}
            {{ block.settings.image_harvest | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>👩‍🌾</span><em>Người thu hoạch</em></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- when 'timeline' -%}
  <div class="pfts-timeline" {{ block.shopify_attributes }}>
    <div class="pfts-timeline__inner">
      <div class="pfts-center" style="margin-bottom:40px;">
        {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h2 class="pfts-h2 pfts-h2--light">{{ block.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="pfts-tl">
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--gold"></div>
          {%- if block.settings.y1_label != blank -%}<div class="pfts-chip pfts-chip--gold pfts-chip--sm">{{ block.settings.y1_label }}</div>{%- endif -%}
          {%- if block.settings.y1_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y1_title }}</div>{%- endif -%}
          <div class="pfts-tl__row">
            {%- if block.settings.y1_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y1_body }}</div>{%- endif -%}
            <div class="pfts-tl__thumb">
              {%- if block.settings.y1_image != blank -%}
                {{ block.settings.y1_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </div>
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--green"></div>
          {%- if block.settings.y2_label != blank -%}<div class="pfts-chip pfts-chip--green pfts-chip--sm">{{ block.settings.y2_label }}</div>{%- endif -%}
          {%- if block.settings.y2_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y2_title }}</div>{%- endif -%}
          {%- if block.settings.y2_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y2_body }}</div>{%- endif -%}
        </div>
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--gold"></div>
          {%- if block.settings.y3_label != blank -%}<div class="pfts-chip pfts-chip--gold pfts-chip--sm">{{ block.settings.y3_label }}</div>{%- endif -%}
          {%- if block.settings.y3_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y3_title }}</div>{%- endif -%}
          <div class="pfts-tl__row">
            {%- if block.settings.y3_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y3_body }}</div>{%- endif -%}
            <div class="pfts-tl__thumb">
              {%- if block.settings.y3_image != blank -%}
                {{ block.settings.y3_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- when 'trust' -%}
  <div class="pfts-wrap pfts-trust" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:36px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-eyebrow-line">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="pfts-trust__grid">
      {%- for i in (1..4) -%}
        {%- assign icon_key = 'icon' | append: i -%}
        {%- assign title_key = 'title' | append: i -%}
        {%- assign body_key = 'body' | append: i -%}
        {%- assign icon_val = block.settings[icon_key] -%}
        {%- assign title_val = block.settings[title_key] -%}
        {%- assign body_val = block.settings[body_key] -%}
        {%- if title_val != blank -%}
        <div class="pfts-trust__item">
          <div class="pfts-trust__ico">{{ icon_val }}</div>
          <div class="pfts-trust__title">{{ title_val }}</div>
          <div class="pfts-trust__body">{{ body_val }}</div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- when 'howto' -%}
  <div class="pfts-wrap pfts-howto" {{ block.shopify_attributes }}>
    {%- if block.settings.eyebrow != blank -%}<div class="pfts-center"><div class="pfts-chip pfts-chip--green">{{ block.settings.eyebrow }}</div></div>{%- endif -%}
    <div class="pfts-howto__grid">
      <div class="pfts-howto__step">
        <div class="pfts-howto__ico">{{ block.settings.step1_icon }}</div>
        <div class="pfts-howto__title">{{ block.settings.step1_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step1_text }}</div>
      </div>
      <div class="pfts-howto__step">
        <div class="pfts-howto__photo">
          {%- if block.settings.step2_image != blank -%}
            {{ block.settings.step2_image | image_url: width: 300 | image_tag: loading: 'lazy' }}
          {%- endif -%}
        </div>
        <div class="pfts-howto__title">{{ block.settings.step2_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step2_text }}</div>
      </div>
      <div class="pfts-howto__step">
        <div class="pfts-howto__ico">{{ block.settings.step3_icon }}</div>
        <div class="pfts-howto__title">{{ block.settings.step3_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step3_text }}</div>
      </div>
    </div>
  </div>

  {%- when 'gift_band' -%}
  <div class="pfts-giftband" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'pfts-giftband__img' }}
    {%- else -%}
      <div class="pfts-pending pfts-pending--band"><span>🎁</span><em>Ảnh đang chờ cập nhật</em></div>
    {%- endif -%}
    <div class="pfts-giftband__overlay"></div>
    <div class="pfts-giftband__text">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<div class="pfts-h3-serif">{{ block.settings.heading }}</div>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-giftband__body">{{ block.settings.body }}</div>{%- endif -%}
      {%- if block.settings.cta_label != blank -%}<a href="#pfts-{{ section.id }}" class="pfts-btn pfts-btn--red">{{ block.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>

  {%- when 'lifestyle_grid' -%}
  <div class="pfts-wrap pfts-life" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:28px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold2">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="pfts-life__grid">
      {%- for i in (1..4) -%}
        {%- assign img_key = 'image' | append: i -%}
        {%- assign img_val = block.settings[img_key] -%}
        <div class="pfts-life__cell">
          {%- if img_val != blank -%}
            {{ img_val | image_url: width: 500 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>📷</span></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if block.settings.caption != blank -%}<div class="pfts-life__caption">{{ block.settings.caption }}</div>{%- endif -%}
  </div>

  {%- when 'combo' -%}
  <div class="pfts-wrap pfts-combo" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:32px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--red">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.subheading != blank -%}<p class="pfts-combo__sub">{{ block.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="pfts-combo__grid">
      <div class="pfts-combo__card">
        <div class="pfts-combo__t">{{ block.settings.c1_title }}</div>
        <div class="pfts-combo__s">{{ block.settings.c1_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--green">{{ block.settings.c1_note }}</div>
      </div>
      <div class="pfts-combo__card pfts-combo__card--mid">
        <div class="pfts-combo__badge">{{ block.settings.c2_badge }}</div>
        <div class="pfts-combo__t pfts-combo__t--light">{{ block.settings.c2_title }}</div>
        <div class="pfts-combo__s pfts-combo__s--light">{{ block.settings.c2_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--gold">{{ block.settings.c2_note }}</div>
      </div>
      <div class="pfts-combo__card">
        <div class="pfts-combo__t">{{ block.settings.c3_title }}</div>
        <div class="pfts-combo__s">{{ block.settings.c3_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--gold2">{{ block.settings.c3_note }}</div>
      </div>
    </div>
  </div>

  {%- when 'commitment' -%}
  <div class="pfts-wrap pfts-commit-wrap" {{ block.shopify_attributes }}>
    <div class="pfts-commit">
      {%- if block.settings.heading != blank -%}<div class="pfts-commit__h">{{ block.settings.heading }}</div>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-commit__b">{{ block.settings.body }}</div>{%- endif -%}
    </div>
  </div>

  {%- endcase -%}
{%- endfor -%}
</div>

{% style %}
  .pfts { background:#F8F3E9; color:#2B241C; font-family: inherit; }
  .pfts-wrap { max-width:1040px; margin:0 auto; padding:52px 32px; }
  .pfts-center { text-align:center; max-width:720px; margin:0 auto; }
  .pfts-chip { display:inline-flex; align-items:center; gap:8px; border-radius:999px; font-weight:700; font-size:11px; letter-spacing:.3px; padding:6px 16px; margin-bottom:16px; }
  .pfts-chip--sm { padding:4px 12px; margin-bottom:10px; }
  .pfts-chip--red { background:#FDE3E6; color:#B4182A; }
  .pfts-chip--green { background:#E7F3EA; color:#1C7A42; }
  .pfts-chip--gold { background:#D4A017; color:#1F2A22; }
  .pfts-chip--gold2 { background:#FBF0D4; color:#A3780F; }
  .pfts-eyebrow { font-size:11px; font-weight:700; letter-spacing:.4px; margin-bottom:6px; }
  .pfts-eyebrow--gold { color:#D4A017; }
  .pfts-eyebrow-line { font-size:12px; font-weight:700; color:#8A7A66; letter-spacing:.5px; margin-bottom:8px; }
  .pfts-h2 { font-size:26px; line-height:1.3; margin:0 0 14px; color:#2B241C; font-weight:700; }
  .pfts-h2--light { color:#FBF5E9; margin:0; }
  .pfts-h3-serif { font-size:19px; font-weight:700; }
  .pfts-body { font-size:14px; line-height:1.8; color:#6B5F4D; }
  .pfts-body--sm { font-size:13px; }
  .pfts-pain { text-align:center; }
  .pfts-photoband { position:relative; margin:0 20px; height:240px; overflow:hidden; border-radius:18px; }
  .pfts-photoband__img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-photoband__overlay { position:absolute; inset:0; background:linear-gradient(0deg, rgba(30,43,32,.65) 0%, rgba(30,43,32,0) 55%); }
  .pfts-photoband__text { position:absolute; left:32px; bottom:20px; color:#fff; }
  .pfts-origin__grid { max-width:1000px; margin:24px auto 0; display:flex; gap:16px; flex-wrap:wrap; }
  .pfts-origin__main { flex:1.4 1 380px; min-height:260px; border-radius:14px; overflow:hidden; }
  .pfts-origin__main img { width:100%; height:100%; object-fit:cover; display:block; min-height:260px; }
  .pfts-origin__side { flex:1 1 220px; display:flex; flex-direction:column; gap:16px; }
  .pfts-origin__small { min-height:122px; border-radius:14px; overflow:hidden; }
  .pfts-origin__small img { width:100%; height:100%; object-fit:cover; display:block; min-height:122px; }
  .pfts-pending { background:#FBF8F1; border:1.5px dashed #D9CBAE; border-radius:14px; width:100%; height:100%; min-height:120px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; color:#A4927A; padding:16px; gap:4px; font-size:11px; font-weight:700; }
  .pfts-pending span { font-size:22px; }
  .pfts-pending--band { position:absolute; inset:0; }
  .pfts-timeline { background:#1E2B20; padding:60px 24px; color:#FBF5E9; }
  .pfts-timeline__inner { max-width:800px; margin:0 auto; }
  .pfts-tl { position:relative; padding-left:28px; border-left:2px solid #37452F; display:flex; flex-direction:column; gap:28px; }
  .pfts-tl__dot { width:14px; height:14px; border-radius:999px; position:absolute; left:-36px; margin-top:4px; }
  .pfts-tl__dot--gold { background:#D4A017; }
  .pfts-tl__dot--green { background:#1C7A42; }
  .pfts-tl__title { font-weight:700; font-size:16px; margin-bottom:8px; }
  .pfts-tl__body { font-size:14px; line-height:1.8; color:#D6DBC9; flex:1; }
  .pfts-tl__row { display:flex; gap:18px; align-items:flex-start; flex-wrap:wrap; }
  .pfts-tl__thumb { width:88px; height:88px; border-radius:14px; overflow:hidden; flex:0 0 88px; }
  .pfts-tl__thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-trust__grid { display:flex; gap:26px; justify-content:center; flex-wrap:wrap; max-width:880px; margin:0 auto; }
  .pfts-trust__item { flex:1 1 160px; text-align:center; }
  .pfts-trust__ico { width:84px; height:84px; border-radius:999px; background:#F1EADC; display:flex; align-items:center; justify-content:center; font-size:30px; margin:0 auto 12px; }
  .pfts-trust__title { font-weight:700; font-size:14px; margin-bottom:6px; }
  .pfts-trust__body { font-size:12px; color:#8A7A66; line-height:1.6; }
  .pfts-howto__grid { display:flex; gap:28px; justify-content:center; flex-wrap:wrap; max-width:740px; margin:24px auto 0; text-align:center; }
  .pfts-howto__step { flex:1 1 180px; }
  .pfts-howto__ico { width:80px; height:80px; border-radius:999px; background:#fff; border:3px solid #E7F3EA; display:flex; align-items:center; justify-content:center; font-size:32px; margin:0 auto 12px; }
  .pfts-howto__photo { width:110px; height:110px; border-radius:999px; overflow:hidden; margin:0 auto 12px; border:5px solid #fff; box-shadow:0 8px 20px rgba(0,0,0,.12); }
  .pfts-howto__photo img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-howto__title { font-weight:700; font-size:14px; margin-bottom:6px; }
  .pfts-howto__text { font-size:12px; color:#8A7A66; }
  .pfts-giftband { position:relative; height:400px; overflow:hidden; }
  .pfts-giftband__img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-giftband__overlay { position:absolute; inset:0; background:linear-gradient(90deg, rgba(30,43,32,.82) 0%, rgba(30,43,32,.45) 45%, rgba(30,43,32,.05) 72%); }
  .pfts-giftband__text { position:absolute; left:40px; top:50%; transform:translateY(-50%); max-width:420px; color:#fff; }
  .pfts-giftband__body { font-size:14px; line-height:1.8; color:#E9E4D6; margin:10px 0 20px; }
  .pfts-btn { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; font-weight:700; cursor:pointer; border:none; text-decoration:none; padding:13px 26px; font-size:13px; }
  .pfts-btn--red { background:#B4182A; color:#fff; }
  .pfts-life__grid { max-width:980px; margin:0 auto; display:grid; grid-template-columns:repeat(4, 1fr); gap:14px; }
  .pfts-life__cell { min-height:150px; border-radius:14px; overflow:hidden; background:#FBF8F1; }
  .pfts-life__cell img { width:100%; height:100%; object-fit:cover; display:block; min-height:150px; }
  .pfts-life__caption { text-align:center; font-size:11px; color:#B9A88C; margin-top:16px; max-width:900px; margin-left:auto; margin-right:auto; }
  .pfts-combo__sub { font-size:13px; color:#8A7A66; margin:6px 0 0; }
  .pfts-combo__grid { display:flex; gap:22px; flex-wrap:wrap; max-width:1040px; margin:0 auto; }
  .pfts-combo__card { flex:1 1 280px; background:#fff; border-radius:18px; padding:28px; border:1px solid #EFE6D8; border-top:4px solid #1C7A42; }
  .pfts-combo__card--mid { background:#1E2B20; border:2px solid #B4182A; position:relative; }
  .pfts-combo__card:last-child { border-top-color:#D4A017; }
  .pfts-combo__badge { position:absolute; top:-12px; right:22px; background:#B4182A; color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:999px; }
  .pfts-combo__t { font-weight:700; font-size:16px; margin-bottom:8px; }
  .pfts-combo__t--light { color:#fff; }
  .pfts-combo__s { font-size:12px; color:#8A7A66; margin-bottom:18px; }
  .pfts-combo__s--light { color:#D6DBC9; }
  .pfts-combo__n { font-size:12px; font-weight:600; }
  .pfts-combo__n--green { color:#1C7A42; }
  .pfts-combo__n--gold { color:#D4A017; }
  .pfts-combo__n--gold2 { color:#A3780F; }
  .pfts-commit-wrap { padding-top:0; padding-bottom:52px; max-width:900px; }
  .pfts-commit { background:#fff; border:1px solid #EFE6D8; border-radius:18px; padding:32px; text-align:center; }
  .pfts-commit__h { font-weight:700; font-size:15px; margin-bottom:10px; color:#2B241C; }
  .pfts-commit__b { font-size:13px; color:#6B5F4D; line-height:1.8; }
  @media (max-width:749px) {
    .pfts-origin__grid, .pfts-trust__grid, .pfts-howto__grid, .pfts-combo__grid { flex-direction:column; }
    .pfts-life__grid { grid-template-columns:repeat(2,1fr); }
    .pfts-giftband__text { left:24px; max-width:260px; }
    .pfts-tl__row { flex-direction:column; }
  }
{% endstyle %}

{% schema %}
{
  "name": "PF — Câu chuyện Trà Sâm",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
