<script>
(function(){var r=document.getElementById('pfts-{{ section.id }}');if(!r||!('IntersectionObserver' in window))return;
if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
if(window.Shopify&&Shopify.designMode)return;
var els=r.children;r.classList.add('pfts--anim');
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px'});
Array.prototype.forEach.call(els,function(el){io.observe(el);});})();
</script>

<script>
/* Dự phòng cho trình duyệt cũ: nối 2 chữ cuối bằng khoảng trắng không ngắt để không rớt 1 chữ */
(function(){var r=document.getElementById('pfts-{{ section.id }}');if(!r)return;
var sel='.pfts-h2,.pfts-h3-serif,.pfts-tl__title,.pfts-trust__title,.pfts-trust__body,.pfts-howto__title,.pfts-howto__text,.pfts-combo__t,.pfts-combo__s,.pfts-combo__n,.pfts-combo__sub,.pfts-commit__h,.pfts-commit__b,.pfts-body p,.pfts-tl__body p,.pfts-giftband__body p,.pfts-giftband__body,.pfts-brand__body,.pfts-brand__closing,.pfts-product__note,.pfts-life__caption,.pfts-chip,.pfts-ben__ut,.pfts-ben__ud,.pfts-ben__note,.pfts-ben__spec span,.pfts-ben__ing li';
r.querySelectorAll(sel).forEach(function(el){var w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),n,last=null;while(n=w.nextNode()){if(/\S/.test(n.nodeValue))last=n;}
if(!last)return;var t=last.nodeValue.replace(/\s+$/,''),i=t.lastIndexOf(' ');if(i>0)last.nodeValue=t.slice(0,i)+'\u00A0'+t.slice(i+1)+last.nodeValue.slice(t.length);});
r.querySelectorAll(sel).forEach(function(el){var w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT),n;while(n=w.nextNode()){n.nodeValue=n.nodeValue.replace(/([A-Za-z0-9])([-–])([A-Za-z0-9])/g,'$1\u2060$2\u2060$3');}});})();
</script>
<script>
(function(){var r=document.getElementById('pfts-{{ section.id }}');if(!r)return;
r.querySelectorAll('.pfts-eyebrow-line').forEach(function(el){el.innerHTML=el.innerHTML.replace(/^(\s*[—–-])\s+/,'$1\u00A0').replace(/\s+([—–-]\s*)$/,'\u00A0$1');});})();
</script>

