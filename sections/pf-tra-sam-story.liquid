{%- comment -%}
  PHOMIFOOD — Trà Sâm Thổ Hào: section kể chuyện thương hiệu, dùng riêng cho template sản phẩm này.
  Mỗi block là 1 khối nội dung độc lập, có thể sắp xếp lại / ẩn / nhân bản trong trình chỉnh sửa theme.
{%- endcomment -%}
<div class="pfts" id="pfts-{{ section.id }}">
{%- for block in section.blocks -%}
  {%- case block.type -%}

  {%- when 'pain' -%}
  <div class="pfts-wrap pfts-pain" {{ block.shopify_attributes }}>
    {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--red">{{ block.settings.eyebrow }}</div>{%- endif -%}
    {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    {%- if block.settings.body != blank -%}<div class="pfts-body">{{ block.settings.body }}</div>{%- endif -%}
  </div>

  {%- when 'photo_band' -%}
  <div class="pfts-photoband" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'pfts-photoband__img' }}
    {%- else -%}
      <div class="pfts-pending pfts-pending--band"><span>🖼️</span><em>Ảnh đang chờ cập nhật</em></div>
    {%- endif -%}
    <div class="pfts-photoband__overlay"></div>
    <div class="pfts-photoband__text">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-eyebrow pfts-eyebrow--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<div class="pfts-h3-serif">{{ block.settings.heading }}</div>{%- endif -%}
    </div>
  </div>

  {%- when 'origin' -%}
  <div class="pfts-wrap pfts-origin" {{ block.shopify_attributes }}>
    <div class="pfts-center pfts-intro">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--green">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-body pfts-body--sm">{{ block.settings.body }}</div>{%- endif -%}
    </div>
    <div class="pfts-origin__grid">
      <div class="pfts-origin__main">
        {%- if block.settings.image_main != blank -%}
          {{ block.settings.image_main | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <div class="pfts-pending"><span>🌱</span><em>Toàn cảnh vườn — đang chờ ảnh thật</em></div>
        {%- endif -%}
      </div>
      <div class="pfts-origin__side">
        <div class="pfts-origin__small">
          {%- if block.settings.image_root != blank -%}
            {{ block.settings.image_root | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>🫚</span><em>Cận cảnh củ sâm</em></div>
          {%- endif -%}
        </div>
        <div class="pfts-origin__small">
          {%- if block.settings.image_harvest != blank -%}
            {{ block.settings.image_harvest | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>👩‍🌾</span><em>Người thu hoạch</em></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- when 'timeline' -%}
  <div class="pfts-timeline" {{ block.shopify_attributes }}>
    <div class="pfts-timeline__inner">
      <div class="pfts-center" style="margin-bottom:40px;">
        {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h2 class="pfts-h2 pfts-h2--light">{{ block.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="pfts-tl">
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--gold"></div>
          {%- if block.settings.y1_label != blank -%}<div class="pfts-chip pfts-chip--gold pfts-chip--sm">{{ block.settings.y1_label }}</div>{%- endif -%}
          {%- if block.settings.y1_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y1_title }}</div>{%- endif -%}
          <div class="pfts-tl__row">
            {%- if block.settings.y1_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y1_body }}</div>{%- endif -%}
            <div class="pfts-tl__thumb">
              {%- if block.settings.y1_image != blank -%}
                {{ block.settings.y1_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </div>
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--green"></div>
          {%- if block.settings.y2_label != blank -%}<div class="pfts-chip pfts-chip--green pfts-chip--sm">{{ block.settings.y2_label }}</div>{%- endif -%}
          {%- if block.settings.y2_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y2_title }}</div>{%- endif -%}
          <div class="pfts-tl__row">
            {%- if block.settings.y2_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y2_body }}</div>{%- endif -%}
            {%- if block.settings.y2_image != blank -%}
            <div class="pfts-tl__thumb">{{ block.settings.y2_image | image_url: width: 300 | image_tag: loading: 'lazy' }}</div>
            {%- endif -%}
          </div>
        </div>
        <div class="pfts-tl__item">
          <div class="pfts-tl__dot pfts-tl__dot--gold"></div>
          {%- if block.settings.y3_label != blank -%}<div class="pfts-chip pfts-chip--gold pfts-chip--sm">{{ block.settings.y3_label }}</div>{%- endif -%}
          {%- if block.settings.y3_title != blank -%}<div class="pfts-tl__title">{{ block.settings.y3_title }}</div>{%- endif -%}
          <div class="pfts-tl__row">
            {%- if block.settings.y3_body != blank -%}<div class="pfts-tl__body">{{ block.settings.y3_body }}</div>{%- endif -%}
            <div class="pfts-tl__thumb">
              {%- if block.settings.y3_image != blank -%}
                {{ block.settings.y3_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- when 'benefits' -%}
  <div class="pfts-ben" {{ block.shopify_attributes }}>
    <div class="pfts-ben__inner">
      <div class="pfts-center pfts-ben__head">
        {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
        {%- if block.settings.intro != blank -%}<div class="pfts-body">{{ block.settings.intro }}</div>{%- endif -%}
      </div>
      <div class="pfts-ben__grid">
        <div class="pfts-ben__media">
          {%- assign bimg = block.settings.image | default: product.featured_image -%}
          {%- if bimg != blank -%}{{ bimg | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}
          <div class="pfts-ben__specs">
            {%- for i in (1..3) -%}
              {%- assign sv_key = 'spec' | append: i | append: '_value' -%}
              {%- assign sl_key = 'spec' | append: i | append: '_label' -%}
              {%- if block.settings[sv_key] != blank -%}
              <div class="pfts-ben__spec"><b>{{ block.settings[sv_key] }}</b><span>{{ block.settings[sl_key] }}</span></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="pfts-ben__info">
          <div class="pfts-ben__card">
            <div class="pfts-ben__label">{{ block.settings.ing_title }}</div>
            <div class="pfts-ben__ing">{{ block.settings.ingredients }}</div>
          </div>
          <div class="pfts-ben__label pfts-ben__label--use">{{ block.settings.use_title }}</div>
          <div class="pfts-ben__uses">
            {%- for i in (1..4) -%}
              {%- assign t_key = 'use' | append: i | append: '_title' -%}
              {%- assign d_key = 'use' | append: i | append: '_text' -%}
              {%- if block.settings[t_key] != blank -%}
              <div class="pfts-ben__use">
                <div class="pfts-ben__ico">{%- case i -%}{%- when 1 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c-4-3-7-6-7-10a7 7 0 0 1 14 0c0 4-3 7-7 10z"/><path d="M12 8v6M9 11h6"/></svg>{%- when 2 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>{%- when 3 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"/></svg>{%- when 4 -%}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 15.5c.6-.3 1.3-.5 2-.5 2.2 0 4 1.8 4 4"/></svg>{%- endcase -%}</div>
                <div><div class="pfts-ben__ut">{{ block.settings[t_key] }}</div><div class="pfts-ben__ud">{{ block.settings[d_key] }}</div></div>
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if block.settings.note != blank -%}<div class="pfts-ben__note">{{ block.settings.note }}</div>{%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- when 'trust' -%}
  <div class="pfts-wrap pfts-trust" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:36px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-eyebrow-line">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="pfts-trust__grid">
      {%- for i in (1..4) -%}
        {%- assign icon_key = 'icon' | append: i -%}
        {%- assign title_key = 'title' | append: i -%}
        {%- assign body_key = 'body' | append: i -%}
        {%- assign icon_val = block.settings[icon_key] -%}
        {%- assign title_val = block.settings[title_key] -%}
        {%- assign body_val = block.settings[body_key] -%}
        {%- if title_val != blank -%}
        <div class="pfts-trust__item">
          <div class="pfts-trust__ico">{%- case i -%}{%- when 1 -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21V11"/><path d="M12 11C12 7 9 4 4 4c0 4 3 7 8 7z"/><path d="M12 13c0-4 3-7 8-7 0 4-3 7-8 7z"/></svg>{%- when 2 -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7 15h10"/></svg>{%- when 3 -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{%- when 4 -%}<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>{%- endcase -%}</div>
          <div class="pfts-trust__title">{{ title_val }}</div>
          <div class="pfts-trust__body">{{ body_val }}</div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- when 'howto' -%}
  <div class="pfts-wrap pfts-howto" {{ block.shopify_attributes }}>
    {%- if block.settings.eyebrow != blank -%}<div class="pfts-center"><div class="pfts-chip pfts-chip--green">{{ block.settings.eyebrow }}</div></div>{%- endif -%}
    <div class="pfts-howto__grid">
      <div class="pfts-howto__step">
        <div class="pfts-howto__num">01</div>{%- if block.settings.step1_image != blank -%}<div class="pfts-howto__photo">{{ block.settings.step1_image | image_url: width: 300 | image_tag: loading: 'lazy' }}</div>{%- else -%}<div class="pfts-howto__ico"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18H6z"/><path d="M6 7h12"/><path d="M10 12h4"/></svg></div>{%- endif -%}
        <div class="pfts-howto__title">{{ block.settings.step1_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step1_text }}</div>
      </div>
      <div class="pfts-howto__step">
        <div class="pfts-howto__num">02</div><div class="pfts-howto__photo">
          {%- if block.settings.step2_image != blank -%}
            {{ block.settings.step2_image | image_url: width: 300 | image_tag: loading: 'lazy' }}
          {%- endif -%}
        </div>
        <div class="pfts-howto__title">{{ block.settings.step2_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step2_text }}</div>
      </div>
      <div class="pfts-howto__step">
        <div class="pfts-howto__num">03</div>{%- if block.settings.step3_image != blank -%}<div class="pfts-howto__photo">{{ block.settings.step3_image | image_url: width: 300 | image_tag: loading: 'lazy' }}</div>{%- else -%}<div class="pfts-howto__ico"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"/></svg></div>{%- endif -%}
        <div class="pfts-howto__title">{{ block.settings.step3_title }}</div>
        <div class="pfts-howto__text">{{ block.settings.step3_text }}</div>
      </div>
    </div>
  </div>

  {%- when 'gift_band' -%}
  <div class="pfts-giftband" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'pfts-giftband__img' }}
    {%- else -%}
      <div class="pfts-pending pfts-pending--band"><span>🎁</span><em>Ảnh đang chờ cập nhật</em></div>
    {%- endif -%}
    <div class="pfts-giftband__overlay"></div>
    <div class="pfts-giftband__text">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<div class="pfts-h3-serif">{{ block.settings.heading }}</div>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-giftband__body">{{ block.settings.body }}</div>{%- endif -%}
      {%- if block.settings.cta_label != blank -%}<a href="#pfts-{{ section.id }}" class="pfts-btn pfts-btn--red">{{ block.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>

  {%- when 'lifestyle_grid' -%}
  <div class="pfts-wrap pfts-life" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:28px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--gold2">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="pfts-life__grid">
      {%- for i in (1..4) -%}
        {%- assign img_key = 'image' | append: i -%}
        {%- assign img_val = block.settings[img_key] -%}
        <div class="pfts-life__cell">
          {%- if img_val != blank -%}
            {{ img_val | image_url: width: 500 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div class="pfts-pending"><span>📷</span></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if block.settings.caption != blank -%}<div class="pfts-life__caption">{{ block.settings.caption }}</div>{%- endif -%}
  </div>

  {%- when 'combo' -%}
  <div class="pfts-wrap pfts-combo" {{ block.shopify_attributes }}>
    <div class="pfts-center" style="margin-bottom:32px;">
      {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--red">{{ block.settings.eyebrow }}</div>{%- endif -%}
      {%- if block.settings.heading != blank -%}<h2 class="pfts-h2">{{ block.settings.heading }}</h2>{%- endif -%}
      {%- if block.settings.subheading != blank -%}<p class="pfts-combo__sub">{{ block.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="pfts-combo__grid">
      <div class="pfts-combo__card">
        <div class="pfts-combo__t">{{ block.settings.c1_title }}</div>
        <div class="pfts-combo__s">{{ block.settings.c1_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--green">{{ block.settings.c1_note }}</div>
      </div>
      <div class="pfts-combo__card pfts-combo__card--mid">
        <div class="pfts-combo__badge">{{ block.settings.c2_badge }}</div>
        <div class="pfts-combo__t pfts-combo__t--light">{{ block.settings.c2_title }}</div>
        <div class="pfts-combo__s pfts-combo__s--light">{{ block.settings.c2_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--gold">{{ block.settings.c2_note }}</div>
      </div>
      <div class="pfts-combo__card">
        <div class="pfts-combo__t">{{ block.settings.c3_title }}</div>
        <div class="pfts-combo__s">{{ block.settings.c3_sub }}</div>
        <div class="pfts-combo__n pfts-combo__n--gold2">{{ block.settings.c3_note }}</div>
      </div>
    </div>
  </div>

  {%- when 'commitment' -%}
  <div class="pfts-wrap pfts-commit-wrap" {{ block.shopify_attributes }}>
    <div class="pfts-commit">
      {%- if block.settings.heading != blank -%}<div class="pfts-commit__h">{{ block.settings.heading }}</div>{%- endif -%}
      {%- if block.settings.body != blank -%}<div class="pfts-commit__b">{{ block.settings.body }}</div>{%- endif -%}
    </div>
  </div>

  {%- when 'product' -%}
  {%- assign pv = product.selected_or_first_available_variant -%}
  <div class="pfts-product" {{ block.shopify_attributes }}>
    <div class="pfts-product__inner">
      <div class="pfts-product__media">
        {%- assign pimg = block.settings.image | default: product.featured_image -%}
        {%- if pimg != blank -%}
          {{ pimg | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
        {%- endif -%}
      </div>
      <div class="pfts-product__info">
        {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--cream">{{ block.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="pfts-h2">{{ block.settings.heading | default: product.title }}</h2>
        {%- if block.settings.body != blank -%}<div class="pfts-body">{{ block.settings.body }}</div>{%- endif -%}
        <div class="pfts-product__price">
          {%- if product.price_varies -%}{{ product.price_min | money }} – {{ product.price_max | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
        </div>
        {%- if block.settings.note != blank -%}<div class="pfts-product__note">{{ block.settings.note }}</div>{%- endif -%}
        <div class="pfts-product__btns">
          {%- if pv.available -%}
            <a class="pfts-btn pfts-btn--red" href="/cart/{{ pv.id }}:1">{{ block.settings.buy_label }}</a>
            {%- form 'product', product, class: 'pfts-product__form' -%}
              <input type="hidden" name="id" value="{{ pv.id }}">
              <button type="submit" class="pfts-btn pfts-btn--ghost">{{ block.settings.cart_label }}</button>
            {%- endform -%}
          {%- else -%}
            <span class="pfts-btn pfts-btn--ghost" aria-disabled="true">{{ 'products.product.sold_out' | t }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- when 'brand' -%}
  <div class="pfts-brand" {{ block.shopify_attributes }}>
    <div class="pfts-brand__inner">
      <div class="pfts-center" style="margin-bottom:36px;">
        {%- if block.settings.eyebrow != blank -%}<div class="pfts-chip pfts-chip--solidred">{{ block.settings.eyebrow }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h2 class="pfts-h2 pfts-h2--light">{{ block.settings.heading }}</h2>{%- endif -%}
        {%- if block.settings.body != blank -%}<div class="pfts-brand__body">{{ block.settings.body }}</div>{%- endif -%}
      </div>
      <div class="pfts-brand__btns">
        {%- if block.settings.messenger_url != blank -%}<a class="pfts-btn pfts-btn--gold" href="{{ block.settings.messenger_url }}" target="_blank" rel="noopener">Nhắn Messenger</a>{%- endif -%}
        {%- if block.settings.zalo_url != blank -%}<a class="pfts-btn pfts-btn--red" href="{{ block.settings.zalo_url }}" target="_blank" rel="noopener">Zalo</a>{%- endif -%}
        {%- if block.settings.whatsapp_url != blank -%}<a class="pfts-btn pfts-btn--dark" href="{{ block.settings.whatsapp_url }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
      </div>
      <div class="pfts-brand__cols">
        {%- if block.settings.col1 != blank -%}<div>{{ block.settings.col1 }}</div>{%- endif -%}
        {%- if block.settings.col2 != blank -%}<div>{{ block.settings.col2 }}</div>{%- endif -%}
      </div>
      {%- if block.settings.closing != blank -%}<div class="pfts-brand__closing">{{ block.settings.closing }}</div>{%- endif -%}
    </div>
  </div>

  {%- endcase -%}
{%- endfor -%}
</div>

{% style %}
  .pfts { background:#F8F3E9; color:#2B241C; font-family: inherit; }
  .pfts-wrap { max-width:1040px; margin:0 auto; padding:52px 32px; }
  .pfts-center { text-align:center; max-width:720px; margin:0 auto; }
  .pfts-chip { display:inline-flex; align-items:center; gap:8px; border-radius:999px; font-weight:700; font-size:11px; letter-spacing:.3px; padding:6px 16px; margin-bottom:16px; }
  .pfts-chip--sm { padding:4px 12px; margin-bottom:10px; }
  .pfts-chip--red { background:#FDE3E6; color:#B4182A; }
  .pfts-chip--green { background:#E7F3EA; color:#1C7A42; }
  .pfts-chip--gold { background:#D4A017; color:#1F2A22; }
  .pfts-chip--gold2 { background:#FBF0D4; color:#A3780F; }
  .pfts-eyebrow { font-size:11px; font-weight:700; letter-spacing:.4px; margin-bottom:6px; }
  .pfts-eyebrow--gold { color:#D4A017; }
  .pfts-eyebrow-line { font-size:12px; font-weight:700; color:#8A7A66; letter-spacing:.5px; margin-bottom:8px; }
  .pfts-h2 { font-size:26px; line-height:1.3; margin:0 0 14px; color:#2B241C; font-weight:700; }
  .pfts-h2--light { color:#FBF5E9; margin:0; }
  .pfts-h3-serif { font-size:19px; font-weight:700; }
  .pfts-body { font-size:14px; line-height:1.8; color:#6B5F4D; }
  .pfts-body--sm { font-size:13px; }
  .pfts-pain { text-align:center; }
  .pfts-photoband { position:relative; margin:0 20px; height:240px; overflow:hidden; border-radius:18px; }
  .pfts-photoband__img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-photoband__overlay { position:absolute; inset:0; background:linear-gradient(0deg, rgba(30,43,32,.65) 0%, rgba(30,43,32,0) 55%); }
  .pfts-photoband__text { position:absolute; left:32px; bottom:20px; color:#fff; }
  .pfts-origin__grid { max-width:1000px; margin:24px auto 0; display:flex; gap:16px; flex-wrap:wrap; }
  .pfts-origin__main { flex:1.4 1 380px; min-height:260px; border-radius:14px; overflow:hidden; }
  .pfts-origin__main img { width:100%; height:100%; object-fit:cover; display:block; min-height:260px; }
  .pfts-origin__side { flex:1 1 220px; display:flex; flex-direction:column; gap:16px; }
  .pfts-origin__small { min-height:122px; border-radius:14px; overflow:hidden; }
  .pfts-origin__small img { width:100%; height:100%; object-fit:cover; display:block; min-height:122px; }
  .pfts-pending { background:#FBF8F1; border:1.5px dashed #D9CBAE; border-radius:14px; width:100%; height:100%; min-height:120px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; color:#A4927A; padding:16px; gap:4px; font-size:11px; font-weight:700; }
  .pfts-pending span { font-size:22px; }
  .pfts-pending--band { position:absolute; inset:0; }
  .pfts-timeline { background:#1E2B20; padding:60px 24px; color:#FBF5E9; }
  .pfts-timeline__inner { max-width:800px; margin:0 auto; }
  .pfts-tl { position:relative; padding-left:28px; border-left:2px solid #37452F; display:flex; flex-direction:column; gap:28px; }
  .pfts-tl__dot { width:14px; height:14px; border-radius:999px; position:absolute; left:-36px; margin-top:4px; }
  .pfts-tl__dot--gold { background:#D4A017; }
  .pfts-tl__dot--green { background:#1C7A42; }
  .pfts-tl__title { font-weight:700; font-size:16px; margin-bottom:8px; }
  .pfts-tl__body { font-size:14px; line-height:1.8; color:#D6DBC9; flex:1; }
  .pfts-tl__row { display:flex; gap:18px; align-items:flex-start; flex-wrap:wrap; }
  .pfts-tl__thumb { width:88px; height:88px; border-radius:14px; overflow:hidden; flex:0 0 88px; }
  .pfts-tl__thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-trust__grid { display:flex; gap:26px; justify-content:center; flex-wrap:wrap; max-width:880px; margin:0 auto; }
  .pfts-trust__item { flex:1 1 160px; text-align:center; }
  .pfts-trust__ico { width:84px; height:84px; border-radius:999px; background:#F1EADC; display:flex; align-items:center; justify-content:center; font-size:30px; margin:0 auto 12px; }
  .pfts-trust__title { font-weight:700; font-size:14px; margin-bottom:6px; }
  .pfts-trust__body { font-size:12px; color:#8A7A66; line-height:1.6; }
  .pfts-howto__grid { display:flex; gap:28px; justify-content:center; flex-wrap:wrap; max-width:740px; margin:24px auto 0; text-align:center; }
  .pfts-howto__step { flex:1 1 180px; }
  .pfts-howto__ico { width:80px; height:80px; border-radius:999px; background:#fff; border:3px solid #E7F3EA; display:flex; align-items:center; justify-content:center; font-size:32px; margin:0 auto 12px; }
  .pfts-howto__photo { width:110px; height:110px; border-radius:999px; overflow:hidden; margin:0 auto 12px; border:5px solid #fff; box-shadow:0 8px 20px rgba(0,0,0,.12); }
  .pfts-howto__photo img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-howto__title { font-weight:700; font-size:14px; margin-bottom:6px; }
  .pfts-howto__text { font-size:12px; color:#8A7A66; }
  .pfts-giftband { position:relative; height:400px; overflow:hidden; }
  .pfts-giftband__img { width:100%; height:100%; object-fit:cover; display:block; }
  .pfts-giftband__overlay { position:absolute; inset:0; background:linear-gradient(90deg, rgba(30,43,32,.82) 0%, rgba(30,43,32,.45) 45%, rgba(30,43,32,.05) 72%); }
  .pfts-giftband__text { position:absolute; left:40px; top:50%; transform:translateY(-50%); max-width:420px; color:#fff; }
  .pfts-giftband__body { font-size:14px; line-height:1.8; color:#E9E4D6; margin:10px 0 20px; }
  .pfts-btn { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; font-weight:700; cursor:pointer; border:none; text-decoration:none; padding:13px 26px; font-size:13px; }
  .pfts-btn--red { background:#B4182A; color:#fff; }
  .pfts-life__grid { max-width:980px; margin:0 auto; display:grid; grid-template-columns:repeat(4, 1fr); gap:14px; }
  .pfts-life__cell { min-height:150px; border-radius:14px; overflow:hidden; background:#FBF8F1; }
  .pfts-life__cell img { width:100%; height:100%; object-fit:cover; display:block; min-height:150px; }
  .pfts-life__caption { text-align:center; font-size:11px; color:#B9A88C; margin-top:16px; max-width:900px; margin-left:auto; margin-right:auto; }
  .pfts-combo__sub { font-size:13px; color:#8A7A66; margin:6px 0 0; }
  .pfts-combo__grid { display:flex; gap:22px; flex-wrap:wrap; max-width:1040px; margin:0 auto; }
  .pfts-combo__card { flex:1 1 280px; background:#fff; border-radius:18px; padding:28px; border:1px solid #EFE6D8; border-top:4px solid #1C7A42; }
  .pfts-combo__card--mid { background:#1E2B20; border:2px solid #B4182A; position:relative; }
  .pfts-combo__card:last-child { border-top-color:#D4A017; }
  .pfts-combo__badge { position:absolute; top:-12px; right:22px; background:#B4182A; color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:999px; }
  .pfts-combo__t { font-weight:700; font-size:16px; margin-bottom:8px; }
  .pfts-combo__t--light { color:#fff; }
  .pfts-combo__s { font-size:12px; color:#8A7A66; margin-bottom:18px; }
  .pfts-combo__s--light { color:#D6DBC9; }
  .pfts-combo__n { font-size:12px; font-weight:600; }
  .pfts-combo__n--green { color:#1C7A42; }
  .pfts-combo__n--gold { color:#D4A017; }
  .pfts-combo__n--gold2 { color:#A3780F; }
  .pfts-commit-wrap { padding-top:0; padding-bottom:52px; max-width:900px; }
  .pfts-commit { background:#fff; border:1px solid #EFE6D8; border-radius:18px; padding:32px; text-align:center; }
  .pfts-commit__h { font-weight:700; font-size:15px; margin-bottom:10px; color:#2B241C; }
  .pfts-commit__b { font-size:13px; color:#6B5F4D; line-height:1.8; }
  @media (max-width:749px) {
    .pfts-origin__grid, .pfts-trust__grid, .pfts-howto__grid, .pfts-combo__grid { flex-direction:column; }
    .pfts-life__grid { grid-template-columns:repeat(2,1fr); }
    .pfts-giftband__text { left:24px; max-width:260px; }
    .pfts-tl__row { flex-direction:column; }
  }
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #pfts-{{ section.id }} .pfts-h2, #pfts-{{ section.id }} .pfts-h3-serif { font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }} !important; font-weight: {{ section.settings.heading_font.weight }}; letter-spacing: 0; }
  .pfts-h2 { font-size:27px; }
  .pfts-chip--cream { background:#F8F3E9; color:#B4182A; }
  .pfts-chip--solidred { background:#B4182A; color:#fff; }
  .pfts-product { background:#fff; border-top:1px solid #EFE6D8; border-bottom:1px solid #EFE6D8; padding:60px 32px; }
  .pfts-product__inner { max-width:1040px; margin:0 auto; display:flex; gap:48px; align-items:center; flex-wrap:wrap; }
  .pfts-product__media { flex:1 1 360px; min-width:260px; background:#F8F3E9; border-radius:24px; padding:28px; }
  .pfts-product__media img { width:100%; max-height:380px; object-fit:contain; display:block; margin:0 auto; border-radius:14px; }
  .pfts-product__info { flex:1 1 360px; min-width:260px; }
  .pfts-product__info .pfts-body { margin-bottom:20px; }
  .pfts-product__price { font-size:28px; font-weight:800; color:#B4182A; margin-bottom:6px; }
  .pfts-product__note { font-size:12px; color:#1C7A42; font-weight:600; margin-bottom:22px; }
  .pfts-product__btns { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
  .pfts-product__form { margin:0; }
  .pfts-btn--ghost { background:#fff; color:#2B241C; border:1.5px solid #EFE6D8; }
  .pfts-btn--gold { background:#D4A017; color:#1F2A22; }
  .pfts-btn--dark { background:#2F3E31; color:#FBF5E9; border:1px solid #42513F; }
  .pfts-btn { min-height:44px; }
  .pfts-brand { background:#1E2B20; color:#FBF5E9; padding:68px 32px 44px; }
  .pfts-brand__inner { max-width:880px; margin:0 auto; }
  .pfts-brand__body { font-size:13px; color:#D6DBC9; max-width:560px; margin:14px auto 0; line-height:1.8; }
  .pfts-brand__btns { display:flex; justify-content:center; gap:14px; flex-wrap:wrap; margin-bottom:36px; }
  .pfts-brand__cols { border-top:1px solid #33402F; padding-top:28px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; font-size:12px; color:#AEBDA8; line-height:1.9; }
  .pfts-brand__cols strong { color:#FBF5E9; }
  .pfts-brand__cols p { margin:0; }
  .pfts-brand__closing { margin-top:24px; padding-top:18px; border-top:1px solid #33402F; text-align:center; font-size:12px; color:#9FB09A; line-height:1.8; }
  @media (max-width:749px) {
    .pfts-brand__cols { grid-template-columns:1fr; }
    .pfts-product { padding:44px 20px; }
    .pfts-h2 { font-size:23px; }
  }
  /* ===== v2 — giao diện cao cấp: đỏ son · vàng kim · ngà (đồng bộ bao bì Hào Sâm) ===== */
  #pfts-{{ section.id }} { --ts-red:#8E1525; --ts-red-d:#5A0A14; --ts-ink:#1A100D; --ts-gold:#C9A24A; --ts-gold-l:#E9D196; --ts-ivory:#FBF6EC; --ts-text:#33241D; --ts-muted:#7D6A5A;
    background:var(--ts-ivory); color:var(--ts-text); overflow:hidden; }
  #pfts-{{ section.id }} .pfts-wrap { padding:88px 32px; max-width:1120px; }
  #pfts-{{ section.id }} .pfts-h2 { font-size:clamp(28px,3.6vw,44px); line-height:1.2; color:var(--ts-ink); margin-bottom:18px; }
  #pfts-{{ section.id }} .pfts-h2--light { color:var(--ts-ivory); }
  #pfts-{{ section.id }} .pfts-body { font-size:16px; line-height:1.85; color:var(--ts-muted); }
  #pfts-{{ section.id }} .pfts-body--sm { font-size:15px; }

  /* Nhãn nhỏ: chữ vàng kim giãn rộng, 2 vạch hai bên thay cho viên thuốc màu */
  #pfts-{{ section.id }} .pfts-chip, #pfts-{{ section.id }} .pfts-eyebrow-line { background:none !important; color:#A07A22; border-radius:0; padding:0; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; margin-bottom:18px; gap:14px; display:inline-flex; align-items:center; }
  #pfts-{{ section.id }} .pfts-chip::before, #pfts-{{ section.id }} .pfts-chip::after { content:""; width:36px; height:1px; background:linear-gradient(90deg,transparent,currentColor); }
  #pfts-{{ section.id }} .pfts-chip::after { transform:scaleX(-1); }
  #pfts-{{ section.id }} .pfts-timeline .pfts-chip, #pfts-{{ section.id }} .pfts-brand .pfts-chip, #pfts-{{ section.id }} .pfts-pain .pfts-chip, #pfts-{{ section.id }} .pfts-product .pfts-chip, #pfts-{{ section.id }} .pfts-giftband .pfts-chip { color:var(--ts-gold-l); }
  #pfts-{{ section.id }} .pfts-eyebrow-line { color:#A07A22; }

  /* Mở đầu: nền đỏ son, dấu ngoặc kép lớn */
  #pfts-{{ section.id }} .pfts-pain { max-width:none; background:radial-gradient(ellipse at 50% 0%, rgba(163,27,46,.9) 0%, rgba(163,27,46,0) 60%), linear-gradient(180deg, #6A0C18 0%, #3A060D 100%); color:var(--ts-ivory); padding:96px 24px 104px; position:relative; }
  #pfts-{{ section.id }} .pfts-pain::before { content:"“"; display:block; font-family:Georgia,serif; font-size:120px; line-height:.6; color:var(--ts-gold); opacity:.55; margin-bottom:18px; }
  #pfts-{{ section.id }} .pfts-pain .pfts-h2 { color:#fff; max-width:820px; margin-left:auto; margin-right:auto; }
  #pfts-{{ section.id }} .pfts-pain .pfts-body { color:#F1DCCB; max-width:720px; margin:0 auto; font-size:17px; }

  /* Ảnh cầu nối: cao, tràn viền */
  #pfts-{{ section.id }} .pfts-photoband { margin:0; height:clamp(320px,46vw,560px); border-radius:0; }
  #pfts-{{ section.id }} .pfts-photoband__overlay { background:linear-gradient(0deg, rgba(26,16,13,.85) 0%, rgba(26,16,13,.25) 50%, rgba(26,16,13,0) 70%); }
  #pfts-{{ section.id }} .pfts-photoband__text { left:50%; transform:translateX(-50%); bottom:56px; text-align:center; width:90%; }
  #pfts-{{ section.id }} .pfts-photoband .pfts-eyebrow { color:var(--ts-gold-l); letter-spacing:3px; font-size:12px; margin-bottom:12px; }
  #pfts-{{ section.id }} .pfts-h3-serif { font-size:clamp(26px,3.4vw,42px); line-height:1.2; color:#fff; }

  /* Nguồn gốc: ảnh bo tròn, viền vàng mảnh, hover phóng nhẹ */
  #pfts-{{ section.id }} .pfts-origin__grid { gap:20px; margin-top:44px; max-width:1120px; }
  #pfts-{{ section.id }} .pfts-origin__main, #pfts-{{ section.id }} .pfts-origin__small, #pfts-{{ section.id }} .pfts-life__cell { border-radius:22px; box-shadow:0 18px 40px -18px rgba(58,6,13,.35); outline:1px solid rgba(201,162,74,.35); outline-offset:-1px; }
  #pfts-{{ section.id }} .pfts-origin__main { min-height:420px; }
  #pfts-{{ section.id }} .pfts-origin__main img { min-height:420px; }
  #pfts-{{ section.id }} .pfts-origin__small img { min-height:200px; }
  #pfts-{{ section.id }} .pfts-origin img, #pfts-{{ section.id }} .pfts-life img { transition:transform .8s cubic-bezier(.2,.7,.2,1); }
  #pfts-{{ section.id }} .pfts-origin__main:hover img, #pfts-{{ section.id }} .pfts-origin__small:hover img, #pfts-{{ section.id }} .pfts-life__cell:hover img { transform:scale(1.05); }

  /* Hành trình 300 năm: nền mực, năm số lớn vàng kim */
  #pfts-{{ section.id }} .pfts-timeline { background:radial-gradient(ellipse at 85% 10%, rgba(142,21,37,.55) 0%, transparent 55%), var(--ts-ink); padding:100px 24px; }
  #pfts-{{ section.id }} .pfts-timeline__inner { max-width:880px; }
  #pfts-{{ section.id }} .pfts-tl { border-left:1px solid transparent; border-image:linear-gradient(180deg, var(--ts-gold), rgba(201,162,74,.15)) 1; padding-left:40px; gap:48px; }
  #pfts-{{ section.id }} .pfts-tl__dot { left:-48px; width:15px; height:15px; background:var(--ts-gold) !important; box-shadow:0 0 0 6px rgba(201,162,74,.18), 0 0 22px rgba(201,162,74,.6); }
  #pfts-{{ section.id }} .pfts-tl .pfts-chip { font-family:{{ section.settings.heading_font.family }}, serif; font-size:44px; letter-spacing:0; line-height:1; margin-bottom:10px; color:var(--ts-gold-l); text-shadow:0 0 24px rgba(201,162,74,.45); }
  #pfts-{{ section.id }} .pfts-tl .pfts-chip::before, #pfts-{{ section.id }} .pfts-tl .pfts-chip::after { display:none; }
  #pfts-{{ section.id }} .pfts-tl__title { font-size:19px; color:#fff; }
  #pfts-{{ section.id }} .pfts-tl__body { font-size:15px; color:#CDBFB2; }
  #pfts-{{ section.id }} .pfts-tl__thumb { width:120px; height:120px; flex-basis:120px; border-radius:16px; outline:1px solid rgba(201,162,74,.5); }

  /* 4 điều đảm bảo: thẻ trắng, icon tròn đỏ son nét vàng */
  #pfts-{{ section.id }} .pfts-trust__grid { gap:20px; max-width:1080px; }
  #pfts-{{ section.id }} .pfts-trust__item { background:#fff; border-radius:22px; padding:34px 22px 28px; border:1px solid #EFE3CC; box-shadow:0 16px 36px -24px rgba(58,6,13,.4); transition:transform .35s, box-shadow .35s; }
  #pfts-{{ section.id }} .pfts-trust__item:hover { transform:translateY(-6px); box-shadow:0 26px 46px -24px rgba(58,6,13,.45); }
  #pfts-{{ section.id }} .pfts-trust__ico { width:72px; height:72px; background:linear-gradient(145deg,#A31B2E,var(--ts-red-d)); color:var(--ts-gold-l); margin-bottom:18px; box-shadow:0 0 0 5px #F7EBD3; }
  #pfts-{{ section.id }} .pfts-trust__title { font-size:16px; color:var(--ts-ink); margin-bottom:8px; }
  #pfts-{{ section.id }} .pfts-trust__body { font-size:13.5px; color:var(--ts-muted); }

  /* Khối mua giữa trang: nền đỏ son sang trọng */
  #pfts-{{ section.id }} .pfts-product { background:radial-gradient(ellipse at 20% 50%, #A31B2E 0%, var(--ts-red-d) 60%, #3A060D 100%); border:0; padding:96px 32px; color:var(--ts-ivory); }
  #pfts-{{ section.id }} .pfts-product__media { background:rgba(255,255,255,.06); border:1px solid rgba(233,209,150,.45); border-radius:28px; padding:32px; box-shadow:0 40px 80px -30px rgba(0,0,0,.6); }
  #pfts-{{ section.id }} .pfts-product__media img { max-height:440px; }
  #pfts-{{ section.id }} .pfts-product .pfts-h2 { color:#fff; }
  #pfts-{{ section.id }} .pfts-product .pfts-body { color:#F1DCCB; }
  #pfts-{{ section.id }} .pfts-product__price { font-size:clamp(30px,3.4vw,42px); color:var(--ts-gold-l); }
  #pfts-{{ section.id }} .pfts-product__note { color:#F3DFA6; font-size:13px; }

  /* Nút: vàng kim có vệt sáng chạy */
  #pfts-{{ section.id }} .pfts-btn { padding:16px 32px; font-size:14px; letter-spacing:.4px; min-height:52px; transition:transform .25s, box-shadow .25s; position:relative; overflow:hidden; }
  #pfts-{{ section.id }} .pfts-btn:hover { transform:translateY(-2px); }
  #pfts-{{ section.id }} .pfts-btn--red, #pfts-{{ section.id }} .pfts-btn--gold { background:linear-gradient(135deg,#F3DFA6 0%,#C9A24A 50%,#A9802A 100%); color:#3A060D; box-shadow:0 12px 28px -10px rgba(201,162,74,.8); }
