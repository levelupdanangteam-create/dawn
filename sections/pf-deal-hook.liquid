{%- comment -%}
  "Ưu đãi đặc biệt" — a small showcase of loss-leader products at deal prices.
  Products come from product-picker blocks. Each card shows a big deal
  price and a "1 per order" note. Actual price + the 1-per-order limit
  are controlled in Shopify (variant price + quantity rule Max = 1).
{%- endcomment -%}
{%- comment -%}
  Nguồn sản phẩm deal:
  1) Nếu section này có "khối sản phẩm" (blocks) → dùng danh sách tự thêm ở đây.
  2) Nếu không có khối nào → tự động dùng danh sách chung ở Theme settings
     (pf_deal_rows) để không phá các trang khác.
{%- endcomment -%}
{%- assign pf_dh_rows = settings.pf_deal_rows | split: ';;' -%}
{%- assign pf_gm = settings.pf_gift_min | default: 100 -%}
{%- if section.blocks.size > 0 -%}
  {%- assign pf_dh_count = section.blocks.size -%}
{%- else -%}
  {%- assign pf_dh_count = pf_dh_rows.size -%}
{%- endif -%}

<div class="pf-deal color-scheme-1" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="pf-deal__head">
      <h2 class="pf-deal__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pf-deal__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>
      {%- endif -%}
    </div>

    <div class="pf-deal__grid">
      {%- if section.blocks.size > 0 -%}
        {%- comment -%}Danh sách tự thêm trong section này (mỗi khối = 1 sản phẩm).{%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank and p.id -%}
            {%- render 'pf-deal-card', p: p, deal_price: block.settings.deal_price, is_gift: block.settings.is_gift, gift_min: pf_gm, section_id: section.id, block_attrs: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}Danh sách chung: Theme settings → pf_deal_rows (handle||giá).{%- endcomment -%}
        {%- for row in pf_dh_rows -%}
          {%- assign parts = row | split: '||' -%}
          {%- assign p = all_products[parts[0]] -%}
          {%- if p != blank and p.id -%}
            {%- assign pf_is_gift = false -%}
            {%- if settings.pf_gift_handle != blank and parts[0] == settings.pf_gift_handle -%}{%- assign pf_is_gift = true -%}{%- endif -%}
            {%- render 'pf-deal-card', p: p, deal_price: parts[1], is_gift: pf_is_gift, gift_min: pf_gm, section_id: section.id -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .pf-deal__head { text-align: center; margin-bottom: 2.4rem; }
  .pf-deal__title { margin: 0; font-size: 2.8rem; font-weight: 800; color: #d62828; letter-spacing: .3px; }
  .pf-deal__sub { margin: .6rem 0 0; font-size: 1.5rem; color: #6a6255; }
  /* Desktop: all deal cards on one row, no scroll */
  .pf-deal__grid { display: grid; grid-template-columns: repeat({{ pf_dh_count }}, 1fr); gap: 1.6rem; }
  .pf-deal__card {
    position: relative;
    display: flex; flex-direction: column; background: #fff;
    border: 2px solid #f2c14e; border-radius: 16px; padding: 1.2rem; overflow: hidden;
    box-shadow: 0 6px 18px rgba(214, 40, 40, .08);
  }
  .pf-deal__ribbon {
    position: absolute; top: 1.1rem; left: -3.4rem; z-index: 2;
    background: #d62828; color: #fff; font-size: 1.15rem; font-weight: 800; letter-spacing: 1px;
    padding: .4rem 4rem; transform: rotate(-45deg); box-shadow: 0 2px 6px rgba(0,0,0,.2);
  }
  .pf-deal__media {
    display: block; aspect-ratio: 1/1; border-radius: 10px; overflow: hidden;
    background: #f6f1e6; margin-bottom: 1rem;
  }
  .pf-deal__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pf-deal__name {
    font-size: 1.4rem; line-height: 1.35; color: #3d3a33; font-weight: 700; text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    min-height: 3.8rem;
  }
  .pf-deal__name:hover { color: #14672f; }
  .pf-deal__price { margin: .5rem 0 .2rem; display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap; }
  .pf-deal__now { font-size: 2.4rem; font-weight: 800; color: #d62828; }
  .pf-deal__was { font-size: 1.4rem; color: #9a9384; text-decoration: line-through; }
  .pf-deal__limit {
    font-size: 1.2rem; font-weight: 700; color: #b8791a; background: #fff6e2;
    border: 1px solid #f0d99a; border-radius: 8px; padding: .5rem .7rem; margin-bottom: 1rem;
  }
  .pf-deal__card .pf-card-actions { margin-top: auto; }
  /* Gift card (bánh gạo — free with orders over threshold) */
  .pf-deal__card--gift { border-color: #a9dcb9; box-shadow: 0 6px 18px rgba(20,133,65,.12); }
  .pf-deal__ribbon--gift { background: #1e8541 !important; }
  .pf-deal__now--gift { color: #1e8541 !important; }
  .pf-deal__limit--gift { color: #14672f !important; background: #e9f7ee !important; border-color: #bfe0c7 !important; }
  .pf-deal__limit--gift b { color: #1e8541; }
  .pf-deal__giftbtn {
    display: block; text-align: center; margin-top: auto;
    background: linear-gradient(90deg, #1e8541, #14672f); color: #fff;
    font-weight: 800; font-size: 1.4rem; padding: 1rem; border-radius: 10px;
    text-decoration: none; transition: filter .15s ease;
  }
  .pf-deal__giftbtn:hover { filter: brightness(1.08); color: #fff; }
  /* Mobile: horizontal scroll carousel */
  @media (max-width: 749px) {
    .pf-deal__grid {
      display: flex; grid-template-columns: none; gap: 1.2rem; overflow-x: auto;
      scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; padding-bottom: 1.2rem;
      scrollbar-width: thin; scrollbar-color: #e0c98e transparent;
    }
    .pf-deal__grid::-webkit-scrollbar { height: 8px; }
    .pf-deal__grid::-webkit-scrollbar-thumb { background: #e0c98e; border-radius: 999px; }
    .pf-deal__card { flex: 0 0 74vw; max-width: 30rem; scroll-snap-align: start; }
    .pf-deal__title { font-size: 2.3rem; }
  }
</style>

{% schema %}
{
  "name": "Ưu đãi đặc biệt",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Tự thêm sản phẩm: bấm “Thêm khối → Sản phẩm deal” bên dưới, chọn sản phẩm và nhập giá deal. Nếu KHÔNG thêm khối nào, section sẽ tự dùng danh sách chung ở Theme settings → 🔥 Ưu đãi đặc biệt (Deal)." },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "🔥 ƯU ĐÃI ĐẶC BIỆT — Giá cực rẻ" },
    { "type": "text", "id": "subheading", "label": "Mô tả ngắn", "default": "Số lượng có hạn · mỗi khách chỉ mua 1 sản phẩm mỗi loại!" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "product",
      "name": "Sản phẩm deal",
      "settings": [
        { "type": "product", "id": "product", "label": "Chọn sản phẩm" },
        { "type": "text", "id": "deal_price", "label": "Giá deal (chỉ nhập số, vd: 0 hoặc 1.9)", "info": "€ tự thêm. Để trống = hiển thị giá gốc. Giá tính tiền thật vẫn set trong Shopify (variant + giới hạn mua 1)." },
        { "type": "checkbox", "id": "is_gift", "label": "Đây là quà tặng (hiển thị 0€)", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Ưu đãi đặc biệt" } ]
}
{% endschema %}
