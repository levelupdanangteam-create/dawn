{%- comment -%}
  "Mua 1 tặng 1" (13/11).
  - Trang chủ: 1 hàng thẻ trượt ngang, ngay dưới "Duy Nhất Hôm Nay"; có đồng hồ đếm ngược + nút "Xem tất cả" → /pages/mua-1-tang-1.
  - Trang riêng /pages/mua-1-tang-1 (template page.mua-1-tang-1): lưới hiện hết sản phẩm + nút "Xem thêm các sản phẩm khác".
  Nguồn sản phẩm: danh mục ở cài đặt section (mặc định: collection "mua-1-tang-1"); variant hiển thị = variant có
  metafield custom.mua_1_tang_1 = true (không có thì variant đầu tiên còn hàng). Nếu không chọn danh mục thì dùng các khối "Sản phẩm 1+1".
  Nút thêm ĐÚNG variant đó với số lượng 2 vào giỏ (AJAX qua .pf-card-actions__form / pf-cart-ajax.js) → discount 1+1 tự động trừ sản phẩm thứ 2.
  CSS thẻ dùng chung .pf-simple / .pf-fs__card trong snippet pf-flash-card.
{%- endcomment -%}
{%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
{%- assign pf_page = false -%}
{%- if section.settings.layout == 'grid' -%}{%- assign pf_page = true -%}
{%- elsif section.settings.layout != 'slider' and template.name == 'page' -%}{%- assign pf_page = true -%}{%- endif -%}
{%- assign pf_col = section.settings.collection -%}
{%- if pf_col == blank -%}{%- assign pf_col = collections['mua-1-tang-1'] -%}{%- endif -%}
{%- assign pf_use_col = false -%}
{%- if section.blocks.size == 0 and pf_col != blank and pf_col.products_count > 0 -%}{%- assign pf_use_col = true -%}{%- endif -%}
{%- assign pf_all = section.settings.view_all_link | default: '/pages/mua-1-tang-1' -%}

<div id="pf-bogo-{{ section.id }}" class="pf-simple pf-bogo{% if pf_page %} pf-bogo--page{% endif %}" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width pf-simple__full">
    <div class="pf-bogo__box" style="--cols: {{ section.settings.columns_desktop }};">
      <div class="pf-simple__head">
        <div class="pf-bogo__title-wrap">
          <span class="pf-bogo__pill" aria-hidden="true">1+1</span>
          <h2 class="pf-bogo__title pf-simple__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        </div>
        {%- if section.settings.show_countdown -%}
          <div class="pf-bogo__timer" data-pf-bogo-timer{% if section.settings.countdown_end != blank %} data-end="{{ section.settings.countdown_end | escape }}"{% endif %} hidden>
            <span class="pf-bogo__timer-label">{% render 'pf-tr', s: section.settings.countdown_label %}</span>
            <b data-d>0</b><span class="pf-bogo__unit">{% if vi %}ngày{% else %}d{% endif %}</span>
            <b data-h>00</b><span class="pf-bogo__colon" aria-hidden="true">:</span><b data-m>00</b><span class="pf-bogo__colon" aria-hidden="true">:</span><b data-s>00</b>
          </div>
        {%- endif -%}
        {%- if pf_page == false and section.settings.view_all_label != blank -%}
          <a class="pf-simple__all" href="{{ pf_all }}">{% render 'pf-tr', s: section.settings.view_all_label %}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.subheading != blank -%}<p class="pf-simple__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>{%- endif -%}

      <div class="pf-simple__slider">
        <button type="button" class="pf-simple__arrow pf-simple__arrow--prev" aria-label="{% if vi %}Trước{% else %}Previous{% endif %}" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="pf-ex__grid pf-simple__track" data-pf-sl-track>
          {%- if pf_use_col -%}
            {%- for p in pf_col.products limit: 100 -%}
              {%- render 'pf-bogo-card', p: p, want: '', section_id: section.id, vi: vi -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- render 'pf-bogo-card', p: block.settings.product, want: block.settings.variant_title, section_id: section.id, vi: vi, block_attrs: block.shopify_attributes -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="pf-simple__arrow pf-simple__arrow--next" aria-label="{% if vi %}Sau{% else %}Next{% endif %}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>

      {%- if pf_page and section.settings.more_label != blank -%}
        <div class="pf-bogo__more-wrap">
          <a class="pf-bogo__more" href="{{ section.settings.more_link | default: '/collections/all' }}">{% render 'pf-tr', s: section.settings.more_label %} <span aria-hidden="true">›</span></a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* CSS thẻ + bố cục .pf-simple chép từ khối stylesheet của snippet pf-flash-card, gói trong section để không phụ thuộc file CSS gộp của Shopify (13/11) */
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__price { flex-direction: row !important; align-items: baseline !important; flex-wrap: wrap; gap: .1rem .7rem; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__row { flex: 1 1 auto; align-items: flex-start !important; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__addform { width: 100%; margin: 1rem 0 0 !important; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__add.pf-fs__add--text {
    display: block !important; box-sizing: border-box; width: 100% !important; height: auto !important; margin: 0;
    border: 1.5px solid #ffc61a !important; border-radius: 999px !important; background: #ffc61a !important; color: #14672f !important;
    font-family: inherit; font-size: 1.4rem !important; font-weight: 700; line-height: 1.2; padding: .9rem .6rem !important;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; transition: background .15s ease;
  }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__add.pf-fs__add--text:hover:not([disabled]) { background: #f5b400 !important; border-color: #f5b400 !important; color: #14672f !important; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__add.pf-fs__add--text[disabled] { opacity: .85; cursor: default; }
#pf-bogo-{{ section.id }} .pf-fs__card > .pf-fs__add.pf-fs__add--text[disabled] { margin-top: 1rem; background: #b9b3a8 !important; border-color: #b9b3a8 !important; color: #fff !important; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__add.pf-fs__add--text::after { content: none !important; }
#pf-bogo-{{ section.id }} .pf-fs__card .pf-fs__bar { margin-top: .9rem !important; }
#pf-bogo-{{ section.id }} { --g: #1e8541; --g-d: #14672f; --g-soft: #eef6f0; --line: #ececec; --ink: #2a2622; --mut: #8a8173; --r: #d62828; }
#pf-bogo-{{ section.id }} .pf-simple__full { max-width: none; padding-inline: clamp(1.6rem, 3vw, 4.8rem); }
#pf-bogo-{{ section.id }} .pf-simple__head { display: flex; align-items: center; gap: 1.2rem 2.4rem; flex-wrap: wrap; padding: 0 0 1.4rem; border-bottom: 1px solid var(--line); }
#pf-bogo-{{ section.id }} .pf-simple__head .pf-simple__title {
    margin: 0; color: var(--g) !important; font-family: var(--font-heading-family, sans-serif) !important; font-weight: 900 !important;
    font-size: clamp(2.4rem, 2.8vw, 3.4rem) !important; line-height: 1.15 !important; text-transform: none !important; letter-spacing: 0 !important; text-align: left;
  }
#pf-bogo-{{ section.id }} .pf-simple__head .pf-simple__title::after { content: none !important; }
#pf-bogo-{{ section.id }} .pf-simple__all {
    margin-left: auto; background: #fff; color: var(--g-d); border: 1.5px solid var(--g); text-decoration: none; font-size: 1.4rem; font-weight: 700;
    padding: .8rem 2rem; border-radius: 999px; white-space: nowrap; transition: background .15s ease, color .15s ease;
  }
#pf-bogo-{{ section.id }} .pf-simple__all:hover { background: var(--g); color: #fff; }
#pf-bogo-{{ section.id }} .pf-simple__sub { margin: 1rem 0 0; font-size: 1.4rem; color: var(--mut); }
#pf-bogo-{{ section.id }} .pf-simple__grid { display: grid; grid-template-columns: repeat(var(--cols, 6), minmax(0, 1fr)); gap: 1.2rem; margin-top: 1.6rem; }
#pf-bogo-{{ section.id }} .pf-simple__slider { position: relative; margin-top: 1.6rem; }
#pf-bogo-{{ section.id }} .pf-simple__track { --per: var(--cols, 6); --gap: 1.2rem; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0; }
#pf-bogo-{{ section.id }} .pf-simple__track::-webkit-scrollbar { display: none; }
#pf-bogo-{{ section.id }} .pf-simple__track > .pf-fs__card { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); scroll-snap-align: start; }
#pf-bogo-{{ section.id }} .pf-simple__arrow {
    position: absolute; top: 40%; z-index: 2; width: 4rem; height: 4rem; border-radius: 50%; border: 1px solid #e6e6e6; padding: 0; cursor: pointer;
    display: grid; place-items: center; background: #fff; color: var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,.12);
  }
#pf-bogo-{{ section.id }} .pf-simple__arrow:hover { color: #fff; background: var(--g); border-color: var(--g); }
#pf-bogo-{{ section.id }} .pf-simple__arrow[disabled] { opacity: 0; pointer-events: none; }
#pf-bogo-{{ section.id }} .pf-simple__arrow--prev { left: -1rem; }
#pf-bogo-{{ section.id }} .pf-simple__arrow--next { right: -1rem; }
#pf-bogo-{{ section.id }} .pf-simple__more-wrap { text-align: center; margin-top: 2.4rem; }
@keyframes pf-arrow-blink{
    0%, 100% { transform: scale(1); box-shadow: 0 2px 10px rgba(0,0,0,.22), 0 0 0 0 rgba(255, 198, 26, .85); }
    50% { transform: scale(1.12); box-shadow: 0 2px 10px rgba(0,0,0,.22), 0 0 0 9px rgba(255, 198, 26, 0); }
  }
@media (prefers-reduced-motion: reduce) {
#pf-bogo-{{ section.id }} .pf-simple__arrow--next, #pf-bogo-{{ section.id }} .pf-fs__arrow--next { animation: none !important; }
}
#pf-bogo-{{ section.id }} .pf-simple__more {
    display: inline-flex; align-items: center; gap: .6rem; cursor: pointer; font-family: inherit;
    background: #fff; border: 1.5px solid var(--g); color: var(--g-d); font-weight: 700; font-size: 1.5rem;
    padding: .9rem 2.6rem; border-radius: 999px; transition: background .15s ease, color .15s ease;
  }
#pf-bogo-{{ section.id }} .pf-simple__more:hover { background: var(--g); color: #fff; }
#pf-bogo-{{ section.id }} .pf-s10__card--hidden { display: none !important; }
#pf-bogo-{{ section.id }} .is-expanded .pf-s10__card--hidden { display: flex !important; }
#pf-bogo-{{ section.id }} .pf-fs__card { display: flex; flex-direction: column; min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1rem 1.1rem; overflow: visible; transform: none; box-shadow: none; }
#pf-bogo-{{ section.id }} .pf-fs__media { position: relative; display: block; aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #fff; }
