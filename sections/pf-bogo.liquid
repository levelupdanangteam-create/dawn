#pf-bogo-{{ section.id }} .pf-fs__badge { position: absolute; top: .4rem; left: .4rem; background: #fdecec; color: var(--r); font-size: 1.2rem; font-weight: 700; line-height: 1; padding: .45rem .6rem; border-radius: 6px; }
#pf-bogo-{{ section.id }} .pf-fs__name { display: block; margin-top: 1rem; font-size: 1.5rem; line-height: 1.35; color: var(--ink); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
