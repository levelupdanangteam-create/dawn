    #pf-bogo-{{ section.id }} .pf-bogo__colon { font-size: 1.3rem; }
    #pf-bogo-{{ section.id }} .pf-bogo__variant { font-size: 1.1rem; }
    #pf-bogo-{{ section.id }} .pf-bogo__more { width: 100%; justify-content: center; font-size: 1.45rem; padding: 1.1rem 1.6rem; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pf-bogo-{{ section.id }}');
    if (!root) return;

    /* Đồng hồ đếm ngược tới "Thời điểm kết thúc" (mặc định hết 30/11); qua mốc thì ẩn */
    var timer = root.querySelector('[data-pf-bogo-timer]');
    if (timer && timer.getAttribute('data-end')) {
      var end = new Date(timer.getAttribute('data-end'));
      if (!isNaN(end)) {
        var d = timer.querySelector('[data-d]'), du = timer.querySelector('.pf-bogo__unit');
        var h = timer.querySelector('[data-h]'), m = timer.querySelector('[data-m]'), s = timer.querySelector('[data-s]');
        var pad = function (n) { return (n < 10 ? '0' : '') + n; };
        var iv;
        var tick = function () {
          var left = Math.floor((end - new Date()) / 1000);
          if (left <= 0) { timer.hidden = true; clearInterval(iv); return; }
          var days = Math.floor(left / 86400);
          d.hidden = du.hidden = days < 1;
          d.textContent = days;
          left = left % 86400;
          h.textContent = pad(Math.floor(left / 3600));
          m.textContent = pad(Math.floor(left % 3600 / 60));
          s.textContent = pad(left % 60);
        };
        timer.hidden = false;
        tick();
        iv = setInterval(tick, 1000);
      }
    }

    /* Hàng trượt ngang: nút trước/sau (trang chủ) */
    var track = root.querySelector('[data-pf-sl-track]');
    var prev = root.querySelector('.pf-simple__arrow--prev'), next = root.querySelector('.pf-simple__arrow--next');
    if (track && prev && next && !root.classList.contains('pf-bogo--page')) {
      var step = function () {
        var c = track.querySelector('.pf-fs__card'); var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        if (!c) return track.clientWidth;
        var w = c.getBoundingClientRect().width + gap;
        return w * Math.max(1, Math.floor(track.clientWidth / w));
      };
      var update = function () { var max = track.scrollWidth - track.clientWidth - 2; prev.disabled = track.scrollLeft <= 2; next.disabled = track.scrollLeft >= max; };
      prev.addEventListener('click', function () { track.scrollBy({ left: -step() }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step() }); });
      var t; track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(update, 60); }, { passive: true });
      window.addEventListener('resize', update); window.addEventListener('load', update); update();
    }
  })();
</script>

