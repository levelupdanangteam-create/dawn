{%- comment -%}
  "Mua 1 tặng 1" (13/11) — đặt ngay dưới "Duy Nhất Hôm Nay" trên trang chủ.
  Mỗi khối = 1 sản phẩm + tên variant được discount Buy X Get Y (vd. "Lẻ", "Lốc (6)").
  Nút trên thẻ thêm ĐÚNG variant đó với số lượng 2 vào giỏ (AJAX qua .pf-card-actions__form / pf-cart-ajax.js),
  nên discount 1+1 (tự động) khớp ngay. Để trống tên variant = lấy variant có metafield custom.mua_1_tang_1.
  CSS thẻ dùng chung .pf-simple / .pf-fs__card trong snippet pf-flash-card.
{%- endcomment -%}
{%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

<div id="pf-bogo-{{ section.id }}" class="pf-simple pf-bogo" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width pf-simple__full">
    <div class="pf-bogo__box" style="--cols: {{ section.settings.columns_desktop }};">
      <div class="pf-simple__head">
        <span class="pf-bogo__pill" aria-hidden="true">1+1</span>
        <h2 class="pf-bogo__title pf-simple__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a class="pf-simple__all" href="{{ section.settings.view_all_link }}">{% render 'pf-tr', s: section.settings.view_all_label %}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.subheading != blank -%}<p class="pf-simple__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>{%- endif -%}

      <div class="pf-simple__slider">
        <button type="button" class="pf-simple__arrow pf-simple__arrow--prev" aria-label="{% if vi %}Trước{% else %}Previous{% endif %}" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="pf-ex__grid pf-simple__track" data-pf-sl-track>
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p == blank or p.id == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign want = block.settings.variant_title | strip | downcase
              assign v = p.selected_or_first_available_variant
              if want == blank
                for vv in p.variants
                  if vv.metafields.custom.mua_1_tang_1.value == true
                    assign v = vv
                    break
                  endif
                endfor
              else
                for vv in p.variants
                  assign t = vv.title | strip | downcase
                  if t == want
                    assign v = vv
                    break
                  endif
                endfor
              endif
              assign was_cents = v.price | times: 2
            -%}
            <div class="pf-fs__card pf-ex__card pf-bogo__card" {{ block.shopify_attributes }}>
              <a href="{{ v.url | default: p.url }}" class="pf-fs__media" tabindex="-1" aria-hidden="true">
                {%- assign img = v.featured_image | default: p.featured_image -%}
                {%- if img -%}
                  <img src="{{ img | image_url: width: 400 }}" srcset="{{ img | image_url: width: 240 }} 240w, {{ img | image_url: width: 400 }} 400w" sizes="(max-width: 749px) 42vw, 220px" alt="{{ p.title | escape }}" loading="lazy" width="400" height="400">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
                <span class="pf-fs__badge pf-bogo__badge">{% if vi %}Mua 1 tặng 1{% else %}Buy 1 get 1{% endif %}</span>
              </a>

              <a class="pf-fs__name" href="{{ v.url | default: p.url }}" title="{{ p.title | escape }}">{% render 'pf-short-title', title: p.title %}</a>
              {%- unless p.has_only_default_variant -%}<span class="pf-bogo__variant">{{ v.title }}</span>{%- endunless -%}

              <div class="pf-fs__row">
                <div class="pf-fs__price">
                  <span class="pf-fs__now">{{ v.price | money }}</span>
                  <s class="pf-fs__was">{{ was_cents | money }}</s>
                </div>
              </div>

              <div class="pf-fs__bar{% unless v.available %} pf-fs__bar--out{% endunless %}">
                <i style="width: 100%"></i>
                <span>{%- if v.available -%}{% if vi %}Nhận 2, trả tiền 1{% else %}Get 2, pay for 1{% endif %}{%- else -%}{% if vi %}Đã hết hàng{% else %}Sold out{% endif %}{%- endif -%}</span>
              </div>

              {%- if v.available -%}
                {%- assign pf_add_id = 'pf-bogo-' | append: section.id | append: '-' | append: v.id -%}
                {%- form 'product', p, id: pf_add_id, class: 'pf-card-actions__form pf-fs__addform' -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <input type="hidden" name="quantity" value="2">
                  <button type="submit" class="pf-fs__add pf-fs__add--text">{% if vi %}Thêm 2 vào giỏ{% else %}Add 2 to cart{% endif %}</button>
                {%- endform -%}
              {%- else -%}
                <button type="button" class="pf-fs__add pf-fs__add--text" disabled>{% if vi %}Hết hàng{% else %}Sold out{% endif %}</button>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="pf-simple__arrow pf-simple__arrow--next" aria-label="{% if vi %}Sau{% else %}Next{% endif %}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>
</div>

<style>
  #pf-bogo-{{ section.id }} .pf-simple__head { gap: 1rem 1.2rem; }
  #pf-bogo-{{ section.id }} .pf-bogo__pill {
    flex: 0 0 auto; display: inline-grid; place-items: center; min-width: 4.6rem; height: 4.6rem; padding: 0 .8rem; box-sizing: border-box;
    border-radius: 999px; background: #d62828; color: #fff; font-weight: 900; font-size: 1.8rem; line-height: 1; box-shadow: 0 4px 12px rgba(214, 40, 40, .28);
  }
  #pf-bogo-{{ section.id }} .pf-bogo__badge { background: #d62828 !important; color: #fff !important; }
  #pf-bogo-{{ section.id }} .pf-bogo__variant { display: block; margin-top: .2rem; font-size: 1.25rem; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #pf-bogo-{{ section.id }} .pf-fs__bar i { background: #fde2a6; }
  #pf-bogo-{{ section.id }} .pf-fs__bar { background: #fff5dc; margin-top: .9rem; }
  #pf-bogo-{{ section.id }} .pf-fs__bar span { color: #b45309; }
  #pf-bogo-{{ section.id }} .pf-simple__track { --per: var(--cols, 6); }
  @media (max-width: 1199px) { #pf-bogo-{{ section.id }} .pf-simple__track { --per: 5; } }
  @media (max-width: 989px) { #pf-bogo-{{ section.id }} .pf-simple__track { --per: 4; } }
  @media (max-width: 749px) {
    #pf-bogo-{{ section.id }} .pf-simple__track { --per: 2.3; }
    #pf-bogo-{{ section.id }} .pf-bogo__pill { min-width: 3.6rem; height: 3.6rem; font-size: 1.4rem; }
    #pf-bogo-{{ section.id }} .pf-bogo__variant { font-size: 1.1rem; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pf-bogo-{{ section.id }}');
    if (!root) return;

    /* Hàng trượt ngang: nút trước/sau */
    var track = root.querySelector('[data-pf-sl-track]');
    var prev = root.querySelector('.pf-simple__arrow--prev'), next = root.querySelector('.pf-simple__arrow--next');
    if (track && prev && next) {
      var step = function () {
        var c = track.querySelector('.pf-fs__card'); var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        if (!c) return track.clientWidth;
        var w = c.getBoundingClientRect().width + gap;
        return w * Math.max(1, Math.floor(track.clientWidth / w));
      };
      var update = function () { var max = track.scrollWidth - track.clientWidth - 2; prev.disabled = track.scrollLeft <= 2; next.disabled = track.scrollLeft >= max; };
      prev.addEventListener('click', function () { track.scrollBy({ left: -step() }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step() }); });
      var t; track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(update, 60); }, { passive: true });
      window.addEventListener('resize', update); window.addEventListener('load', update); update();
    }

  })();
</script>

{% schema %}
{
  "name": "Mua 1 tặng 1",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Mỗi khối = 1 sản phẩm có discount Mua 1 tặng 1. Nút trên thẻ thêm 2 sản phẩm (đúng variant) vào giỏ để discount tự khớp." },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Mua 1 Tặng 1" },
    { "type": "text", "id": "subheading", "label": "Mô tả ngắn", "default": "Thêm 2 vào giỏ, chỉ trả tiền 1 — quà tặng tự trừ trong giỏ hàng" },
    { "type": "text", "id": "view_all_label", "label": "Chữ nút bên phải tiêu đề", "default": "Xem tất cả" },
    { "type": "url", "id": "view_all_link", "label": "Link nút (để trống = ẩn nút)" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Số thẻ / hàng (desktop)", "default": 6 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "product",
      "name": "Sản phẩm 1+1",
      "settings": [
        { "type": "product", "id": "product", "label": "Chọn sản phẩm" },
        { "type": "text", "id": "variant_title", "label": "Tên variant được tặng", "info": "Đúng tên variant trong discount, vd: Lẻ, Lốc (6). Để trống = variant có tick Mua 1 tặng 1 (metafield), không có thì variant đầu tiên còn hàng." }
      ]
    }
  ],
  "presets": [ { "name": "Mua 1 tặng 1" } ]
}
{% endschema %}
