#pf-bogo-{{ section.id }} .pf-fs__bar span { position: relative; display: block; text-align: center; font-size: 1.2rem; font-weight: 700; line-height: 2rem; color: var(--g-d); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 .6rem; }
#pf-bogo-{{ section.id }} .pf-fs__bar--out { background: #f0f0f0; }
#pf-bogo-{{ section.id }} .pf-fs__bar--out i { background: #e0e0e0; }
#pf-bogo-{{ section.id }} .pf-fs__bar--out span { color: var(--mut); }
@media (min-width: 1600px) {
#pf-bogo-{{ section.id }} .pf-simple__grid { gap: 1.6rem; }
}
@media (max-width: 1199px) {
