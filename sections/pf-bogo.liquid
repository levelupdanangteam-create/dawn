#pf-bogo-{{ section.id }} .pf-fs__was { font-size: 1.3rem; color: var(--mut); line-height: 1.3; white-space: nowrap; }
#pf-bogo-{{ section.id }} .pf-fs__bar { position: relative; height: 2rem; border-radius: 999px; background: var(--g-soft); overflow: hidden; }
