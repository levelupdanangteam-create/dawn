{%- comment -%}
  "Ưu đãi tuần" — a homepage section showcasing hand-picked products.
  Products come from product-picker blocks (falls back to a default list
  of handles when no blocks are configured).
{%- endcomment -%}

{%- liquid
  assign pf_default_handles = "gia-bao-bun-hoa-hong-1mm-500gx20-goi,chinsu-pho-story-truyen-thong-nuoc-trong,nuoc-mam-chinsu-ca-hoi-500ml-15chai,hat-nem-knor-900g-x-10,tufoco-banh-trang-cuon-tron-size-22-340g-x-44-goi" | split: ","
-%}

<div class="pf-wd color-scheme-1" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pf-wd__wrap page-width">
    <div class="pf-wd__head">
      <h2 class="pf-wd__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pf-wd__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>
      {%- endif -%}
    </div>

    <div class="pf-wd__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank and p.id -%}
            {%- render 'pf-wd-card', p: p, section_id: section.id -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for h in pf_default_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id -%}
            {%- render 'pf-wd-card', p: p, section_id: section.id -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="pf-wd__cta-wrap">
        <a class="pf-wd__cta" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">
          {{ section.settings.view_all_label | default: 'Xem tất cả sản phẩm' }} →
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .pf-wd__wrap { }
  .pf-wd__head { text-align: center; margin-bottom: 2.4rem; }
  .pf-wd__title {
    margin: 0; font-size: 2.8rem; font-weight: 800; color: #d62828; letter-spacing: .3px;
  }
  .pf-wd__sub { margin: .6rem 0 0; font-size: 1.5rem; color: #6a6255; }
  .pf-wd__grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem;
  }
  .pf-wd-card {
    display: flex; flex-direction: column; background: #fff;
    border: 1px solid #ece0c6; border-radius: 14px; padding: 1rem; overflow: hidden;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .pf-wd-card:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(0, 0, 0, .12); }
  .pf-wd-card__media {
    position: relative; aspect-ratio: 1 / 1; border-radius: 10px; overflow: hidden;
    background: #f6f1e6; margin-bottom: 1rem;
  }
  .pf-wd-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pf-wd-card__badge {
    position: absolute; top: .7rem; left: .7rem; z-index: 1;
    background: #d62828; color: #fff; font-size: 1.15rem; font-weight: 800;
    padding: .3rem .7rem; border-radius: 999px;
  }
  .pf-wd-card__new {
    position: absolute; top: .7rem; right: .7rem; z-index: 1;
    background: #1e8541; color: #fff; font-size: 1.1rem; font-weight: 800;
    padding: .3rem .7rem; border-radius: 999px; box-shadow: 0 2px 6px rgba(20, 103, 47, .3);
  }
  .pf-wd-card__title {
    font-size: 1.35rem; line-height: 1.35; color: #3d3a33; font-weight: 600; text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    min-height: 3.6rem;
  }
  .pf-wd-card__title:hover { color: #14672f; }
  .pf-wd-card__price { margin: .6rem 0 1rem; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .pf-wd-card__now { font-size: 1.6rem; font-weight: 800; color: #d62828; }
  .pf-wd-card__old { font-size: 1.25rem; color: #9a9384; text-decoration: line-through; }
  .pf-wd-card .pf-card-actions { margin-top: auto; }
  .pf-wd__cta-wrap { text-align: center; margin-top: 2.6rem; }
  .pf-wd__cta {
    display: inline-block; text-decoration: none;
    background: linear-gradient(180deg, #1e8541, #14672f); color: #fff;
    font-size: 1.5rem; font-weight: 800; padding: 1.1rem 2.8rem; border-radius: 999px;
    box-shadow: 0 6px 16px rgba(20, 103, 47, .3); transition: filter .15s ease;
  }
  .pf-wd__cta:hover { filter: brightness(1.07); }
  @media (max-width: 989px) { .pf-wd__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 749px) {
    .pf-wd__grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
    .pf-wd__title { font-size: 2.3rem; }
  }
</style>

{% schema %}
{
  "name": "Ưu đãi tuần",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "🔥 Ưu đãi tuần này" },
    { "type": "text", "id": "subheading", "label": "Mô tả ngắn", "default": "Giá tốt nhất trong tuần — số lượng có hạn!" },
    { "type": "checkbox", "id": "show_view_all", "label": "Hiện nút xem tất cả", "default": false },
    { "type": "text", "id": "view_all_label", "label": "Chữ trên nút", "default": "Xem tất cả sản phẩm" },
    { "type": "url", "id": "view_all_link", "label": "Link nút (để trống = tất cả sản phẩm)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Sản phẩm",
      "settings": [
        { "type": "product", "id": "product", "label": "Chọn sản phẩm" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Ưu đãi tuần" }
  ]
}
{% endschema %}
