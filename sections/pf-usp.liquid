{%- comment -%}
  4 ô USP của Phomifood, đặt ngay dưới hero. Màu theo brand: xanh lá + vàng.
  CSS gắn với id section nên không ảnh hưởng section khác.
{%- endcomment -%}
<style>
  #pf-usp-{{ section.id }} {
    --pf-usp-green: #1f8a43;
    --pf-usp-green-dark: #176a33;
    --pf-usp-yellow: #ffc61a;
    --pf-usp-dark: #22201c;
    --pf-usp-muted: #57534b;
    --pf-usp-card: #f1f8ee;
    --pf-usp-border: #dfe8da;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #pf-usp-{{ section.id }} .pf-usp__wrap { max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: clamp(1.6rem, 3vw, 3rem); }
  #pf-usp-{{ section.id }} .pf-usp__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.6rem; }
  #pf-usp-{{ section.id }} .pf-usp__card {
    display: flex; align-items: flex-start; gap: 1.4rem;
    background: var(--pf-usp-card); border: 1px solid var(--pf-usp-border); border-radius: 18px;
    padding: 2rem 2.2rem; min-height: 12rem; text-decoration: none; color: inherit;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  #pf-usp-{{ section.id }} a.pf-usp__card:hover { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(31,138,67,.14); border-color: #9bbfa6; }
  #pf-usp-{{ section.id }} .pf-usp__icon {
    flex: none; width: 5.6rem; height: 5.6rem; border-radius: 14px; display: grid; place-items: center;
    background: linear-gradient(135deg, var(--pf-usp-green), var(--pf-usp-green-dark)); color: var(--pf-usp-yellow);
    box-shadow: 0 6px 14px rgba(31,138,67,.25);
  }
  #pf-usp-{{ section.id }} .pf-usp__icon svg { width: 2.8rem; height: 2.8rem; }
  #pf-usp-{{ section.id }} .pf-usp__body { display: flex; flex-direction: column; gap: .5rem; min-width: 0; }
  #pf-usp-{{ section.id }} .pf-usp__title {
    margin: 0; font-family: var(--font-heading-family, sans-serif); font-weight: 800;
    font-size: clamp(1.6rem, 1.4vw, 1.9rem); line-height: 1.25; color: var(--pf-usp-green-dark);
  }
  #pf-usp-{{ section.id }} .pf-usp__text { margin: 0; font-size: 1.4rem; line-height: 1.5; color: var(--pf-usp-muted); }

  @media (max-width: 989px) {
    #pf-usp-{{ section.id }} .pf-usp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
    #pf-usp-{{ section.id }} .pf-usp__card { padding: 1.6rem 1.6rem; min-height: 0; }
  }
  @media (max-width: 599px) {
    #pf-usp-{{ section.id }} .pf-usp__grid { grid-template-columns: 1fr; gap: 1rem; }
    #pf-usp-{{ section.id }} .pf-usp__card { align-items: center; padding: 1.3rem 1.5rem; border-radius: 14px; }
    #pf-usp-{{ section.id }} .pf-usp__icon { width: 4.6rem; height: 4.6rem; border-radius: 12px; }
    #pf-usp-{{ section.id }} .pf-usp__icon svg { width: 2.3rem; height: 2.3rem; }
    #pf-usp-{{ section.id }} .pf-usp__title { font-size: 1.5rem; }
    #pf-usp-{{ section.id }} .pf-usp__text { font-size: 1.3rem; }
  }
</style>

<div id="pf-usp-{{ section.id }}">
  <div class="pf-usp__wrap">
    <div class="pf-usp__grid">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }} class="pf-usp__card" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="pf-usp__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
              {%- when 'box' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/><path d="M3.5 7.5 12 12l8.5-4.5"/><path d="M12 12v9"/></svg>
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4h8l9 9-8 8z"/><circle cx="7.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v6c0 4.2 3 7.6 7 9 4-1.4 7-4.8 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="m12 3 2.8 5.9 6.2.8-4.5 4.4 1.1 6.3L12 17.4l-5.6 3 1.1-6.3L3 9.7l6.2-.8z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
            {%- endcase -%}
          </span>
          <span class="pf-usp__body">
            <h3 class="pf-usp__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="pf-usp__text">{{ block.settings.text }}</p>{%- endif -%}
          </span>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "USP Phomifood (4 ô)",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 8 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Ô USP",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Biểu tượng", "default": "truck",
          "options": [
            { "value": "truck", "label": "Xe giao hàng" },
            { "value": "box", "label": "Thùng hàng" },
            { "value": "tag", "label": "Nhãn giá" },
            { "value": "shield", "label": "Khiên bảo vệ" },
            { "value": "clock", "label": "Đồng hồ" },
            { "value": "chat", "label": "Tin nhắn" },
            { "value": "star", "label": "Ngôi sao" },
            { "value": "check", "label": "Dấu tích" }
          ]
        },
        { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Giao toàn châu Âu" },
        { "type": "text", "id": "text", "label": "Mô tả ngắn", "default": "24 nước EU, phí theo cân hàng" },
        { "type": "url", "id": "link", "label": "Liên kết (tuỳ chọn)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Phomifood (4 ô)",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Giao toàn châu Âu", "text": "24 nước EU, phí theo cân hàng" } },
        { "type": "usp", "settings": { "icon": "box", "title": "Tổng kho tại EU", "text": "Có sẵn hàng, gửi trong 24 giờ" } },
        { "type": "usp", "settings": { "icon": "tag", "title": "Giá kho, mua thùng rẻ hơn", "text": "Mỗi gói rẻ hơn khi lấy nguyên thùng" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Trả tiền khi nhận", "text": "COD, thanh toán online hoặc VietQR" } }
      ]
    }
  ]
}
{% endschema %}
