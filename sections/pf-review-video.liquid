{%- comment -%}
  PHOMIFOOD — Product review video(s).
  Shows review video(s) on a product page. Supports MULTIPLE videos via the
  list metafield custom.review_videos (list.url); falls back to the single
  custom.review_video_url. To add videos to any product, set that product's
  "Review videos" metafield (Shopify admin → product → Metafields) — no code
  change needed.
{%- endcomment -%}
{%- assign pf_videos = product.metafields.custom.review_videos.value -%}
{%- assign pf_single = product.metafields.custom.review_video_url -%}
{%- assign pf_has = false -%}
{%- if pf_videos != blank and pf_videos.size > 0 -%}{%- assign pf_has = true -%}
{%- elsif pf_single != blank -%}{%- assign pf_has = true -%}{%- endif -%}

{%- if pf_has -%}
  {%- assign vi = false -%}
  {%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
  {%- comment -%}Build a unified list of video URLs.{%- endcomment -%}
  {%- assign pf_list = pf_videos -%}
  {%- unless pf_videos != blank and pf_videos.size > 0 -%}{%- assign pf_list = pf_single | split: '|||' -%}{%- endunless -%}
  {%- assign pf_multi = false -%}{%- if pf_list.size > 1 -%}{%- assign pf_multi = true -%}{%- endif -%}
  <div class="pf-rv color-scheme-1" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <div class="pf-rv__head">
        <span class="pf-rv__badge">🎥 {% if vi %}VIDEO{% else %}VIDEO{% endif %}</span>
        <h2 class="pf-rv__title">{% if vi %}Video đánh giá sản phẩm{% else %}Product review video{% endif %}</h2>
        <p class="pf-rv__sub">{% if vi %}Xem cận cảnh sản phẩm trước khi đặt mua{% else %}A closer look before you order{% endif %}</p>
      </div>
      <div class="pf-rv__grid{% if pf_multi %} pf-rv__grid--multi{% endif %}">
        {%- for vurl in pf_list -%}
          <div class="pf-rv__frame">
            <video
              class="pf-rv__video"
              controls
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              {% if forloop.first and section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 900 }}"{% endif %}>
              <source src="{{ vurl }}" type="video/mp4">
            </video>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <style>
    .pf-rv__head { text-align: center; margin-bottom: 1.8rem; }
    .pf-rv__badge {
      display: inline-block; background: #d62828; color: #fff; font-size: 1.15rem; font-weight: 800;
      letter-spacing: .12em; padding: .35rem .9rem; border-radius: 999px; margin-bottom: .8rem;
    }
    .pf-rv__title { margin: 0; font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 800; color: #14672f; }
    .pf-rv__sub { margin: .5rem 0 0; font-size: 1.5rem; color: #6a6255; }
    .pf-rv__grid { display: flex; justify-content: center; }
    .pf-rv__grid--multi {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.6rem;
      max-width: 82rem; margin: 0 auto;
    }
    .pf-rv__frame {
      max-width: 46rem; width: 100%; margin: 0 auto; border-radius: 18px; overflow: hidden;
      background: #000; box-shadow: 0 12px 34px rgba(0,0,0,.18); border: 1px solid #e6dcc4;
    }
    .pf-rv__grid--multi .pf-rv__frame { max-width: none; }
    .pf-rv__video { display: block; width: 100%; height: auto; max-height: 78vh; background: #000; }
    @media (max-width: 749px) {
      .pf-rv__grid--multi { grid-template-columns: 1fr; gap: 1.2rem; }
    }
  </style>

  <script>
    (function () {
      var vids = document.querySelectorAll('#shopify-section-{{ section.id }} .pf-rv__video');
      vids.forEach(function (v) {
        v.muted = true; // required for autoplay in most browsers
        var tryPlay = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
        if (v.readyState >= 2) tryPlay(); else v.addEventListener('loadeddata', tryPlay, { once: true });
        // Play when it scrolls into view (helps browsers that defer offscreen autoplay).
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (es) {
            es.forEach(function (e) { if (e.isIntersecting) tryPlay(); });
          }, { threshold: 0.25 }).observe(v);
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Video đánh giá SP",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Video chỉ hiển thị khi sản phẩm có metafield custom.review_video_url. Gắn link video cho từng sản phẩm ở: Sản phẩm → Metafields → Review video URL." },
    { "type": "image_picker", "id": "poster", "label": "Ảnh bìa video (tuỳ chọn)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 32 }
  ]
}
{% endschema %}
