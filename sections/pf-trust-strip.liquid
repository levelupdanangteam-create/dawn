{%- comment -%}
  PHOMIFOOD — Dải cam kết màu xanh ngay trên footer (trang sản phẩm), chạy ngang liên tục trên 1 dòng.
  Mỗi ý là 1 block: tiêu đề đậm + dòng phụ.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{%- comment -%} Chạy ngang liên tục trên 1 dòng: nội dung lặp 2 lần, trượt -50% rồi lặp lại liền mạch. {%- endcomment -%}
{%- capture pf_ts_items -%}
  {%- for block in section.blocks -%}
    <div class="pf-tstrip__it" {{ block.shopify_attributes }}>
      <span class="pf-tstrip__ic" aria-hidden="true">{{ block.settings.icon }}</span>
      <span><b>{{ block.settings.title }}</b>{% if block.settings.text != blank %} <span class="pf-tstrip__s">{{ block.settings.text }}</span>{% endif %}</span>
    </div>
  {%- endfor -%}
{%- endcapture -%}
<div class="pf-tstrip" style="margin-top: {{ section.settings.margin_top }}px; --pf-ts-dur: {{ section.settings.speed }}s;">
  <div class="pf-tstrip__track">
    {%- comment -%} Mỗi nhóm chứa nội dung 2 lần để luôn rộng hơn màn hình lớn (không hở khoảng trống khi lặp). {%- endcomment -%}
    <div class="pf-tstrip__group">{{ pf_ts_items }}{{ pf_ts_items }}</div>
    <div class="pf-tstrip__group" aria-hidden="true">{{ pf_ts_items }}{{ pf_ts_items }}</div>
  </div>
</div>
<style>
  .pf-tstrip { background: #1e8541; color: #fff; overflow: hidden; }
  .pf-tstrip__track { display: flex; width: max-content; animation: pf-ts-scroll var(--pf-ts-dur, 30s) linear infinite; }
  .pf-tstrip:hover .pf-tstrip__track { animation-play-state: paused; }
  .pf-tstrip__group { display: flex; flex: none; align-items: center; gap: 5rem; padding: 1.3rem 2.5rem; }
  .pf-tstrip__it { display: flex; align-items: center; gap: 1rem; flex: none; white-space: nowrap; font-size: 1.4rem; line-height: 1.35; }
  .pf-tstrip__ic { flex: none; width: 3.2rem; height: 3.2rem; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.16); font-size: 1.6rem; }
  .pf-tstrip__s { opacity: .85; }
  @keyframes pf-ts-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (max-width: 749px) {
    .pf-tstrip__group { gap: 3.2rem; padding: 1.1rem 1.6rem; }
    .pf-tstrip__it { font-size: 1.3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-tstrip { overflow-x: auto; }
    .pf-tstrip__track { animation: none; }
    .pf-tstrip__group[aria-hidden] { display: none; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Dải cam kết (trên footer)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "range", "id": "margin_top", "label": "Khoảng cách trên", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "speed", "label": "Thời gian chạy hết 1 vòng (giây, càng lớn càng chậm)", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Cam kết",
      "settings": [
        { "type": "text", "id": "icon", "label": "Biểu tượng (emoji)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Cam kết" },
        { "type": "text", "id": "text", "label": "Dòng phụ" }
      ]
    }
  ],
  "presets": [ { "name": "Dải cam kết (trên footer)" } ]
}
{% endschema %}
