{%- comment -%}
  "Để lại thông tin nhận ưu đãi" — form khách hàng chuẩn của Shopify (form 'customer').
  Người đăng ký được lưu vào Khách hàng (đồng ý nhận email marketing) + gắn tag để lọc.
  Mã ưu đãi (nếu nhập) chỉ hiện sau khi đăng ký thành công.
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

<div class="pf-lo" id="pf-lo-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="pf-lo__card">
      <span class="pf-lo__deco" aria-hidden="true">%</span>
      <div class="pf-lo__text">
        {%- if section.settings.eyebrow != blank -%}<span class="pf-lo__pill">🎁 {% render 'pf-tr', s: section.settings.eyebrow %}</span>{%- endif -%}
        <h2 class="pf-lo__title">{% render 'pf-tr', s: section.settings.heading %}</h2>
        {%- if section.settings.subheading != blank -%}<p class="pf-lo__sub">{% render 'pf-tr', s: section.settings.subheading %}</p>{%- endif -%}
        <ul class="pf-lo__perks">
          {%- for i in (1..3) -%}
            {%- capture k %}perk_{{ i }}{% endcapture -%}
            {%- if section.settings[k] != blank -%}<li>{% render 'pf-tr', s: section.settings[k] %}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="pf-lo__formbox" id="pf-lo-form-{{ section.id }}">
        {%- assign pf_lo_fid = 'PfLeadForm-' | append: section.id -%}
        {%- form 'customer', id: pf_lo_fid, class: 'pf-lo__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.tag | default: 'lead-trang-chu' }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          {%- if form.posted_successfully? -%}
            <div class="pf-lo__ok" role="status" tabindex="-1" autofocus>
              <b>✅ {% if vi %}Đăng ký thành công!{% else %}You're subscribed!{% endif %}</b>
              {%- if section.settings.reward_code != blank -%}
                <span>{% if vi %}Mã ưu đãi của bạn:{% else %}Your discount code:{% endif %}</span>
                <button type="button" class="pf-lo__code" data-pf-lo-copy="{{ section.settings.reward_code | escape }}">{{ section.settings.reward_code }} <small>{% if vi %}Chép mã{% else %}Copy{% endif %}</small></button>
                {%- if section.settings.reward_note != blank -%}<small class="pf-lo__codenote">{% render 'pf-tr', s: section.settings.reward_note %}</small>{%- endif -%}
              {%- else -%}
                <span>{% render 'pf-tr', s: section.settings.success_text %}</span>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="pf-lo__formtitle">{% render 'pf-tr', s: section.settings.form_title %}</p>
            <label class="pf-lo__field">
              <span>{% if vi %}Tên của bạn{% else %}Your name{% endif %}</span>
              <input type="text" name="contact[first_name]" autocomplete="given-name" placeholder="{% if vi %}VD: Lan{% else %}e.g. Anna{% endif %}">
            </label>
            <label class="pf-lo__field">
              <span>Email <em>*</em></span>
              <input type="email" name="contact[email]" required autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="ban@email.com" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </label>
            {%- if form.errors -%}
              <p class="pf-lo__err" role="alert">⚠️ {% if form.errors contains 'email' %}{% if vi %}Email chưa đúng hoặc đã được đăng ký.{% else %}Invalid or already subscribed email.{% endif %}{% else %}{{ form.errors | default_errors }}{% endif %}</p>
            {%- endif -%}
            <button type="submit" class="pf-lo__btn">{% render 'pf-tr', s: section.settings.button_label %} →</button>
            <p class="pf-lo__fine">🔒 {% render 'pf-tr', s: section.settings.privacy_note %}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
  #pf-lo-{{ section.id }} { --g: #1e8541; --g-d: #14672f; --y: #ffc61a; --r: #d62828; --ink: #2a2622; }
  #pf-lo-{{ section.id }} .pf-lo__card {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.1fr 1fr; gap: 3.2rem; align-items: center;
    background: linear-gradient(135deg, #1e8541 0%, #14672f 100%); color: #fff; border-radius: 24px;
    padding: clamp(2.4rem, 4vw, 4.4rem); box-shadow: 0 14px 34px rgba(20, 103, 47, .25);
  }
  #pf-lo-{{ section.id }} .pf-lo__deco { position: absolute; left: -2rem; bottom: -7rem; font-size: 26rem; font-weight: 900; line-height: 1; color: rgba(255,255,255,.06); pointer-events: none; }
  #pf-lo-{{ section.id }} .pf-lo__text { position: relative; }
  #pf-lo-{{ section.id }} .pf-lo__pill { display: inline-block; background: var(--y); color: var(--ink); font-size: 1.25rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: .55rem 1.3rem; border-radius: 999px; }
  #pf-lo-{{ section.id }} .pf-lo__title { margin: 1.4rem 0 0; color: #fff; font-family: var(--font-heading-family, sans-serif); font-weight: 900; font-size: clamp(2.6rem, 3.4vw, 3.8rem); line-height: 1.15; }
  #pf-lo-{{ section.id }} .pf-lo__sub { margin: 1.2rem 0 0; font-size: 1.6rem; line-height: 1.55; color: rgba(255,255,255,.88); max-width: 52rem; }
  #pf-lo-{{ section.id }} .pf-lo__perks { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: .9rem; }
  #pf-lo-{{ section.id }} .pf-lo__perks li { position: relative; padding-left: 3rem; font-size: 1.5rem; font-weight: 600; line-height: 1.45; }
  #pf-lo-{{ section.id }} .pf-lo__perks li::before { content: "✓"; position: absolute; left: 0; top: .05rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--y); color: var(--g-d); font-size: 1.2rem; font-weight: 900; display: grid; place-items: center; }

  #pf-lo-{{ section.id }} .pf-lo__formbox { position: relative; background: #fff; color: var(--ink); border-radius: 18px; padding: 2.4rem; box-shadow: 0 10px 26px rgba(0,0,0,.14); }
  #pf-lo-{{ section.id }} .pf-lo__form { display: grid; gap: 1.2rem; margin: 0; }
  #pf-lo-{{ section.id }} .pf-lo__formtitle { margin: 0 0 .2rem; font-size: 1.8rem; font-weight: 800; color: var(--g-d); }
  #pf-lo-{{ section.id }} .pf-lo__field { display: grid; gap: .5rem; font-size: 1.35rem; font-weight: 700; color: #5a5346; }
  #pf-lo-{{ section.id }} .pf-lo__field em { color: var(--r); font-style: normal; }
  #pf-lo-{{ section.id }} .pf-lo__field input {
    width: 100%; box-sizing: border-box; height: 4.8rem; padding: 0 1.6rem; border: 1.5px solid #ddd3c2; border-radius: 12px;
    font-size: 1.6rem; font-family: inherit; color: var(--ink); background: #fffdf8; transition: border-color .15s ease, box-shadow .15s ease;
  }
  #pf-lo-{{ section.id }} .pf-lo__field input:focus { outline: none; border-color: var(--g); box-shadow: 0 0 0 3px rgba(30,133,65,.15); }
  #pf-lo-{{ section.id }} .pf-lo__field input[aria-invalid="true"] { border-color: var(--r); }
  #pf-lo-{{ section.id }} .pf-lo__err { margin: 0; font-size: 1.35rem; color: var(--r); font-weight: 600; }
  #pf-lo-{{ section.id }} .pf-lo__btn {
    margin-top: .4rem; height: 5rem; border: 0; border-radius: 999px; cursor: pointer; font-family: inherit;
    background: var(--y); color: var(--ink); font-size: 1.6rem; font-weight: 900; box-shadow: 0 6px 16px rgba(255,170,0,.35); transition: transform .15s ease, filter .15s ease;
  }
  #pf-lo-{{ section.id }} .pf-lo__btn:hover { transform: translateY(-2px); filter: brightness(1.03); }
  #pf-lo-{{ section.id }} .pf-lo__fine { margin: 0; font-size: 1.2rem; color: #8a8273; text-align: center; }
  #pf-lo-{{ section.id }} .pf-lo__ok { display: grid; gap: 1rem; justify-items: center; text-align: center; padding: 1rem 0; font-size: 1.5rem; }
  #pf-lo-{{ section.id }} .pf-lo__ok b { font-size: 2rem; color: var(--g-d); }
  #pf-lo-{{ section.id }} .pf-lo__code { display: inline-flex; align-items: center; gap: 1rem; border: 2px dashed var(--g); background: #e9f5ed; color: var(--g-d); font: 900 2.2rem/1 var(--font-body-family, sans-serif); letter-spacing: .08em; padding: 1.2rem 2rem; border-radius: 12px; cursor: pointer; }
  #pf-lo-{{ section.id }} .pf-lo__code small { font-size: 1.2rem; letter-spacing: 0; font-weight: 700; background: var(--g); color: #fff; padding: .4rem .8rem; border-radius: 999px; }
  #pf-lo-{{ section.id }} .pf-lo__codenote { color: #8a8273; font-size: 1.3rem; }

  @media (max-width: 989px) {
    #pf-lo-{{ section.id }} .pf-lo__card { grid-template-columns: 1fr; gap: 2.2rem; }
  }
  @media (max-width: 749px) {
    #pf-lo-{{ section.id }} .pf-lo__card { border-radius: 18px; padding: 2.2rem 1.6rem; }
    #pf-lo-{{ section.id }} .pf-lo__title { font-size: 2.4rem; }
    #pf-lo-{{ section.id }} .pf-lo__sub { font-size: 1.4rem; }
    #pf-lo-{{ section.id }} .pf-lo__perks li { font-size: 1.35rem; }
    #pf-lo-{{ section.id }} .pf-lo__formbox { padding: 1.8rem 1.6rem; border-radius: 14px; }
    #pf-lo-{{ section.id }} .pf-lo__formtitle { font-size: 1.6rem; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pf-lo-{{ section.id }}');
    if (!root) return;
    var btn = root.querySelector('[data-pf-lo-copy]');
    if (btn) {
      root.scrollIntoView({ block: 'center' });
      btn.addEventListener('click', function () {
        var code = btn.getAttribute('data-pf-lo-copy');
        var done = function () { var s = btn.querySelector('small'); if (s) s.textContent = '✓'; };
        if (navigator.clipboard) navigator.clipboard.writeText(code).then(done, function () {}); else done();
      });
    } else if (root.querySelector('.pf-lo__ok')) {
      root.scrollIntoView({ block: 'center' });
    }
  })();
</script>

{% schema %}
{
  "name": "Đăng ký nhận ưu đãi",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Người đăng ký được lưu vào Khách hàng (đồng ý nhận email marketing) và gắn tag bên dưới để lọc." },
    { "type": "text", "id": "eyebrow", "label": "Nhãn vàng", "default": "Ưu đãi thành viên" },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Để lại thông tin, nhận ưu đãi riêng" },
    { "type": "textarea", "id": "subheading", "label": "Mô tả", "default": "Đăng ký email để là người đầu tiên biết deal xả kho, hàng mới về và mã giảm giá chỉ dành cho thành viên Phomifood." },
    { "type": "text", "id": "perk_1", "label": "Lợi ích 1", "default": "Mã giảm giá riêng cho thành viên" },
    { "type": "text", "id": "perk_2", "label": "Lợi ích 2", "default": "Báo deal xả kho, hàng mới về sớm nhất" },
    { "type": "text", "id": "perk_3", "label": "Lợi ích 3", "default": "Không spam — hủy đăng ký bất cứ lúc nào" },
    { "type": "text", "id": "form_title", "label": "Tiêu đề ô form", "default": "Nhận ưu đãi qua email" },
    { "type": "text", "id": "button_label", "label": "Chữ nút", "default": "Nhận ưu đãi ngay" },
    { "type": "text", "id": "privacy_note", "label": "Dòng bảo mật", "default": "Thông tin của bạn được bảo mật tuyệt đối" },
    { "type": "header", "content": "Sau khi đăng ký" },
    { "type": "text", "id": "reward_code", "label": "Mã ưu đãi hiện sau khi đăng ký", "info": "Nhập mã giảm giá có thật trong Shopify. Để trống = chỉ hiện lời cảm ơn." },
    { "type": "text", "id": "reward_note", "label": "Ghi chú dưới mã", "default": "Nhập mã ở bước thanh toán" },
    { "type": "text", "id": "success_text", "label": "Lời cảm ơn (khi không có mã)", "default": "Cảm ơn bạn! Phomifood sẽ gửi ưu đãi mới nhất qua email cho bạn." },
    { "type": "text", "id": "tag", "label": "Tag khách hàng", "default": "lead-trang-chu" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 56 }
  ],
  "presets": [ { "name": "Đăng ký nhận ưu đãi" } ]
}
{% endschema %}
