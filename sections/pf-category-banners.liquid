{%- comment -%}
  Danh mục dạng banner lớn, trượt ngang (3 ô trên desktop). Mỗi ô: ảnh nền + nhãn + tiêu đề chữ viết tay
  + mô tả + badge giá + nút + 3 cam kết nhỏ. Màu theo brand Phomi: xanh lá + vàng.
  CSS/JS gắn với id section nên không ảnh hưởng section khác.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet">
<style>
  #pf-cb-{{ section.id }} {
    --pf-cb-green: #1f8a43;
    --pf-cb-green-dark: #14562b;
    --pf-cb-yellow: #ffc61a;
    --pf-cb-cream: #fff8d9;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #pf-cb-{{ section.id }} .pf-wrap { max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: clamp(1.6rem, 3vw, 3rem); }

  /* Tiêu đề section (giữ kiểu hiện tại) */
  #pf-cb-{{ section.id }} .pf-cathead { text-align: center; margin-bottom: 2.4rem; }
  #pf-cb-{{ section.id }} .pf-ornament { display: flex; align-items: center; justify-content: center; gap: 1.2rem; margin-bottom: 1rem; }
  #pf-cb-{{ section.id }} .pf-ornament .line { width: clamp(3rem, 8vw, 6rem); height: 1px; background: linear-gradient(90deg, transparent, #d62828); }
  #pf-cb-{{ section.id }} .pf-ornament .line + .line { background: linear-gradient(90deg, #d62828, transparent); }
  #pf-cb-{{ section.id }} .pf-ornament .dia { width: 9px; height: 9px; background: #d62828; transform: rotate(45deg); }
  #pf-cb-{{ section.id }} .pf-titlerow { position: relative; display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
  #pf-cb-{{ section.id }} .pf-title {
    font-family: var(--font-heading-family, sans-serif); font-weight: 800; margin: 0;
    font-size: clamp(2.4rem, 3.8vw, 3.4rem); line-height: 1.15;
    color: #d62828; background: linear-gradient(90deg, #d62828 0%, #e8452f 55%, #f2792a 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  #pf-cb-{{ section.id }} .pf-all-link {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; white-space: nowrap;
    font-size: 1.45rem; font-weight: 800; color: #1e63c8;
  }
  #pf-cb-{{ section.id }} .pf-all-link:hover { color: #d62828; }

  /* Khung trượt */
  #pf-cb-{{ section.id }} .pf-cb__slider { position: relative; }
  #pf-cb-{{ section.id }} .pf-cb__track {
    display: flex; gap: 2rem; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; padding: .4rem .2rem 1rem; scroll-behavior: smooth;
  }
  #pf-cb-{{ section.id }} .pf-cb__track::-webkit-scrollbar { display: none; }
  #pf-cb-{{ section.id }} .pf-cb__card {
    position: relative; flex: 0 0 calc((100% - 4rem) / 3); scroll-snap-align: start;
    aspect-ratio: 3 / 2; border-radius: 20px; overflow: hidden; isolation: isolate;
    background: var(--pf-cb-green-dark); color: #fff; text-decoration: none; display: block;
    box-shadow: 0 10px 28px rgba(20,86,43,.16);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  #pf-cb-{{ section.id }} .pf-cb__card:hover { transform: translateY(-5px); box-shadow: 0 18px 40px rgba(20,86,43,.26); }
  #pf-cb-{{ section.id }} .pf-cb__img { position: absolute; inset: 0; z-index: -2; }
  #pf-cb-{{ section.id }} .pf-cb__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  #pf-cb-{{ section.id }} .pf-cb__card:hover .pf-cb__img img { transform: scale(1.05); }
  #pf-cb-{{ section.id }} .pf-cb__shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(20,86,43,.92) 0%, rgba(20,86,43,.78) 42%, rgba(20,86,43,.25) 72%, rgba(20,86,43,0) 100%);
  }
  #pf-cb-{{ section.id }} .pf-cb__card::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--pf-cb-yellow);
  }
  #pf-cb-{{ section.id }} .pf-cb__body {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: .6rem;
    padding: 2rem 2.2rem 4.6rem; max-width: 72%;
  }
  #pf-cb-{{ section.id }} .pf-cb__eyebrow {
    display: inline-flex; align-items: center; gap: .5rem; background: var(--pf-cb-cream); color: #6a5200;
    font-size: 1.05rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: .4rem 1rem; border-radius: 999px;
  }
  #pf-cb-{{ section.id }} .pf-cb__eyebrow::before { content: ""; width: .7rem; height: .7rem; border-radius: 50%; background: var(--pf-cb-green); }
  #pf-cb-{{ section.id }} .pf-cb__name {
    margin: .2rem 0 0; font-family: 'Dancing Script', var(--font-heading-family, cursive); font-weight: 700;
    font-size: clamp(2.6rem, 2.6vw, 3.6rem); line-height: 1.05; color: var(--pf-cb-yellow);
    text-shadow: 0 2px 10px rgba(0,0,0,.35);
  }
  #pf-cb-{{ section.id }} .pf-cb__sub { margin: 0; font-size: 1.25rem; line-height: 1.4; color: rgba(255,255,255,.92); }
  #pf-cb-{{ section.id }} .pf-cb__badge {
    display: inline-flex; align-items: center; gap: .6rem; margin-top: .3rem;
    background: var(--pf-cb-cream); color: var(--pf-cb-green-dark); font-weight: 800; font-size: 1.2rem;
    padding: .5rem 1.1rem; border-radius: 999px; box-shadow: 0 4px 10px rgba(0,0,0,.15);
  }
  #pf-cb-{{ section.id }} .pf-cb__badge svg { width: 1.6rem; height: 1.6rem; color: var(--pf-cb-green); }
  #pf-cb-{{ section.id }} .pf-cb__btn {
    display: inline-flex; align-items: center; gap: .6rem; margin-top: .5rem;
    background: var(--pf-cb-yellow); color: #22201c; font-weight: 800; font-size: 1.3rem;
    padding: .8rem 1.6rem; border-radius: 999px; box-shadow: 0 6px 16px rgba(255,170,0,.35);
    transition: transform .15s ease;
  }
  #pf-cb-{{ section.id }} .pf-cb__card:hover .pf-cb__btn { transform: translateX(3px); }

  /* 3 cam kết nhỏ dưới đáy ô */
  #pf-cb-{{ section.id }} .pf-cb__trust {
    position: absolute; left: 0; right: 0; bottom: 3px; display: flex; align-items: center; justify-content: space-around; gap: .6rem;
    padding: .7rem 1.2rem; background: rgba(20,86,43,.82); backdrop-filter: blur(4px);
  }
  #pf-cb-{{ section.id }} .pf-cb__trust span {
    display: inline-flex; align-items: center; gap: .45rem; font-size: .95rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: #fff; white-space: nowrap;
  }
  #pf-cb-{{ section.id }} .pf-cb__trust svg { width: 1.5rem; height: 1.5rem; color: var(--pf-cb-yellow); flex: none; }
  #pf-cb-{{ section.id }} .pf-cb__trust span + span { border-left: 1px solid rgba(255,255,255,.3); padding-left: .6rem; }

  /* Nút mũi tên + chấm */
  #pf-cb-{{ section.id }} .pf-cb__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 4.4rem; height: 4.4rem; border-radius: 50%; border: 0; cursor: pointer;
    background: #fff; color: #22201c; box-shadow: 0 6px 18px rgba(0,0,0,.18); display: grid; place-items: center;
    transition: background .15s ease, color .15s ease, opacity .15s ease;
  }
  #pf-cb-{{ section.id }} .pf-cb__arrow:hover { background: var(--pf-cb-green); color: #fff; }
  #pf-cb-{{ section.id }} .pf-cb__arrow[disabled] { opacity: .35; cursor: default; }
  #pf-cb-{{ section.id }} .pf-cb__arrow--prev { left: -1.2rem; }
  #pf-cb-{{ section.id }} .pf-cb__arrow--next { right: -1.2rem; }
  #pf-cb-{{ section.id }} .pf-cb__arrow svg { width: 2rem; height: 2rem; }
  #pf-cb-{{ section.id }} .pf-cb__dots { display: flex; justify-content: center; gap: .6rem; margin-top: .6rem; }
  #pf-cb-{{ section.id }} .pf-cb__dot { width: 1rem; height: 1rem; border-radius: 999px; border: 0; padding: 0; background: #d9d3c7; cursor: pointer; transition: width .2s ease, background .2s ease; }
  #pf-cb-{{ section.id }} .pf-cb__dot.is-active { width: 2.6rem; background: var(--pf-cb-green); }

  @media (max-width: 1199px) {
    #pf-cb-{{ section.id }} .pf-cb__card { flex-basis: calc((100% - 2rem) / 2); }
  }
  @media (max-width: 749px) {
    #pf-cb-{{ section.id }} .pf-cb__track { gap: 1.2rem; }
    #pf-cb-{{ section.id }} .pf-cb__card { flex-basis: 86%; border-radius: 16px; }
    #pf-cb-{{ section.id }} .pf-cb__body { padding: 1.5rem 1.6rem 4.4rem; max-width: 80%; }
    #pf-cb-{{ section.id }} .pf-cb__name { font-size: 2.8rem; }
    #pf-cb-{{ section.id }} .pf-cb__arrow { display: none; }
    #pf-cb-{{ section.id }} .pf-titlerow { flex-direction: column; }
    #pf-cb-{{ section.id }} .pf-all-link { position: static; transform: none; margin-top: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #pf-cb-{{ section.id }} .pf-cb__track { scroll-behavior: auto; }
    #pf-cb-{{ section.id }} .pf-cb__card, #pf-cb-{{ section.id }} .pf-cb__img img { transition: none; }
  }
</style>

<div id="pf-cb-{{ section.id }}">
  <div class="pf-wrap">
    {%- if section.settings.heading != blank -%}
    <div class="pf-cathead">
      <div class="pf-ornament" aria-hidden="true"><span class="line"></span><span class="dia"></span><span class="line"></span></div>
      <div class="pf-titlerow">
        <h2 class="pf-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_all_button -%}
          <a class="pf-all-link" href="{{ section.settings.all_button_link | default: routes.collections_url }}">{{ section.settings.all_button_label | default: 'Xem tất cả danh mục' }} <span aria-hidden="true">→</span></a>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}

    <div class="pf-cb__slider">
      <button class="pf-cb__arrow pf-cb__arrow--prev" type="button" aria-label="Trước" data-dir="-1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></svg>
      </button>
      <div class="pf-cb__track" data-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign name = block.settings.title
            if name == blank and col != blank
              assign name = col.title | downcase | capitalize
            endif
            if name == blank
              assign name = 'Danh mục'
            endif
            assign url = '#'
            if col != blank
              assign url = col.url
            endif
            assign badge = block.settings.badge_text
            if badge == blank and col != blank and col.products.size > 0
              assign minp = col.products.first.price
              for p in col.products
                if p.price < minp
                  assign minp = p.price
                endif
              endfor
              capture badge
                echo 'Giá chỉ từ '
                echo minp | money
              endcapture
            endif
          -%}
          <a class="pf-cb__card" href="{{ url }}" {{ block.shopify_attributes }}>
            <div class="pf-cb__img">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="(max-width: 749px) 86vw, (max-width: 1199px) 50vw, 400px" alt="" loading="lazy" width="900" height="600">
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" alt="" loading="lazy" width="900" height="600">
              {%- elsif col != blank and col.image -%}
                <img src="{{ col.image | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="600">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="pf-cb__shade" aria-hidden="true"></div>
            <div class="pf-cb__body">
              {%- if block.settings.eyebrow != blank -%}<span class="pf-cb__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
              <h3 class="pf-cb__name">{{ name }}</h3>
              {%- if block.settings.subtitle != blank -%}<p class="pf-cb__sub">{{ block.settings.subtitle }}</p>{%- endif -%}
              {%- if badge != blank -%}
                <span class="pf-cb__badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4h8l9 9-8 8z"/><circle cx="7.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/></svg>
                  {{ badge }}
                </span>
              {%- endif -%}
              <span class="pf-cb__btn">{{ block.settings.button_label | default: 'Mua ngay' }} <span aria-hidden="true">→</span></span>
            </div>
            <div class="pf-cb__trust" aria-hidden="true">
              {%- if section.settings.trust_1 != blank -%}
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v6c0 4.2 3 7.6 7 9 4-1.4 7-4.8 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg>{{ section.settings.trust_1 }}</span>
              {%- endif -%}
              {%- if section.settings.trust_2 != blank -%}
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/><path d="M3.5 7.5 12 12l8.5-4.5"/><path d="M12 12v9"/></svg>{{ section.settings.trust_2 }}</span>
              {%- endif -%}
              {%- if section.settings.trust_3 != blank -%}
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>{{ section.settings.trust_3 }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
      <button class="pf-cb__arrow pf-cb__arrow--next" type="button" aria-label="Sau" data-dir="1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></svg>
      </button>
    </div>
    <div class="pf-cb__dots" data-dots role="tablist" aria-label="Trang danh mục"></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('pf-cb-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-track]');
    var dotsWrap = root.querySelector('[data-dots]');
    var prev = root.querySelector('.pf-cb__arrow--prev');
    var next = root.querySelector('.pf-cb__arrow--next');
    var cards = Array.prototype.slice.call(track.children);
    if (!cards.length) return;

    function perView() {
      var cw = cards[0].getBoundingClientRect().width;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      return Math.max(1, Math.round((track.clientWidth + gap) / (cw + gap)));
    }
    function pages() { return Math.max(1, Math.ceil(cards.length / perView())); }
    function current() {
      var cw = cards[0].getBoundingClientRect().width;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      var idx = Math.round(track.scrollLeft / ((cw + gap) * perView()));
      return Math.min(pages() - 1, Math.max(0, idx));
    }
    function goTo(page) {
      var cw = cards[0].getBoundingClientRect().width;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      track.scrollTo({ left: page * perView() * (cw + gap), behavior: 'smooth' });
    }
    function buildDots() {
      dotsWrap.innerHTML = '';
      for (var i = 0; i < pages(); i++) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'pf-cb__dot'; b.setAttribute('aria-label', 'Trang ' + (i + 1));
        b.addEventListener('click', (function (n) { return function () { goTo(n); }; })(i));
        dotsWrap.appendChild(b);
      }
      update();
    }
    function update() {
      var c = current();
      Array.prototype.forEach.call(dotsWrap.children, function (d, i) { d.classList.toggle('is-active', i === c); });
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    prev.addEventListener('click', function () { goTo(current() - 1); });
    next.addEventListener('click', function () { goTo(current() + 1); });
    var t;
    track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(update, 80); }, { passive: true });
    window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(buildDots, 120); });
    buildDots();
  })();
</script>

{% schema %}
{
  "name": "Danh mục dạng banner",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Danh Mục Sản Phẩm" },
    { "type": "checkbox", "id": "show_all_button", "label": "Hiện link \"Xem tất cả danh mục\"", "default": true },
    { "type": "text", "id": "all_button_label", "label": "Chữ của link", "default": "Xem tất cả danh mục" },
    { "type": "url", "id": "all_button_link", "label": "Liên kết (mặc định: trang bộ sưu tập)" },
    { "type": "header", "content": "3 cam kết nhỏ dưới mỗi banner" },
    { "type": "text", "id": "trust_1", "label": "Cam kết 1", "default": "Hàng Việt chính hãng" },
    { "type": "text", "id": "trust_2", "label": "Cam kết 2", "default": "Tổng kho tại EU" },
    { "type": "text", "id": "trust_3", "label": "Cam kết 3", "default": "Giao khắp châu Âu" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 40 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner danh mục",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Bộ sưu tập" },
        { "type": "image_picker", "id": "image", "label": "Ảnh nền (tải lên)", "info": "Nên dùng ảnh ngang 3:2, phần bên phải là sản phẩm vì chữ nằm bên trái." },
        { "type": "text", "id": "image_url", "label": "Hoặc dán URL ảnh" },
        { "type": "text", "id": "eyebrow", "label": "Nhãn nhỏ phía trên", "default": "Danh mục nổi bật" },
        { "type": "text", "id": "title", "label": "Tiêu đề (để trống = tên bộ sưu tập)" },
        { "type": "text", "id": "subtitle", "label": "Mô tả ngắn" },
        { "type": "text", "id": "badge_text", "label": "Chữ badge", "info": "Để trống sẽ tự lấy giá thấp nhất của bộ sưu tập." },
        { "type": "text", "id": "button_label", "label": "Chữ nút", "default": "Mua ngay" }
      ]
    }
  ],
  "presets": [
    { "name": "Danh mục dạng banner", "blocks": [ { "type": "banner" }, { "type": "banner" }, { "type": "banner" } ] }
  ]
}
{% endschema %}
