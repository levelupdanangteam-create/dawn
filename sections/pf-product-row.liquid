{%- comment -%}
  Hàng sản phẩm trượt ngang kiểu siêu thị online:
  tiêu đề trái + "Xem tất cả" phải, (tuỳ chọn) nút lọc nhanh, thẻ sản phẩm gọn, mũi tên trái/phải.
  Thêm nhiều lần trên trang chủ, mỗi lần một danh mục (Bán chạy, Mì ăn liền, Bánh kẹo…).
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show
  assign view_all_url = section.settings.view_all_link | default: col.url
-%}
<style>
  #pf-row-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #pf-row-{{ section.id }} .pf-row__chips { display: flex; gap: .8rem; overflow-x: auto; margin: -.4rem 0 1.6rem; padding-bottom: .2rem; scrollbar-width: none; }
  #pf-row-{{ section.id }} .pf-row__chips::-webkit-scrollbar { display: none; }
  #pf-row-{{ section.id }} .pf-row__chip {
    flex: none; display: inline-flex; align-items: center; gap: .4rem; padding: .6rem 1.4rem; border-radius: 999px;
    background: #f7f1e9; border: 1px solid #ece3d4; color: #2a2622; font-size: 1.3rem; font-weight: 700; text-decoration: none;
    transition: background .15s ease, color .15s ease, border-color .15s ease;
  }
  #pf-row-{{ section.id }} .pf-row__chip:hover { background: #1e8541; border-color: #1e8541; color: #fff; }
  #pf-row-{{ section.id }} .pf-row__chip--hot { background: #d62828; border-color: #d62828; color: #fff; }
  #pf-row-{{ section.id }} .pf-row__viewport { position: relative; }
  #pf-row-{{ section.id }} .pf-row__track {
    --pf-cols: {{ section.settings.columns_desktop }};
    display: grid; grid-auto-flow: column; gap: 1.2rem;
    grid-auto-columns: calc((100% - (var(--pf-cols) - 1) * 1.2rem) / var(--pf-cols));
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch;
    padding: .4rem .2rem 1.4rem; scrollbar-width: thin; scrollbar-color: #d9cdb6 transparent;
  }
  #pf-row-{{ section.id }} .pf-row__track::-webkit-scrollbar { height: 6px; }
  #pf-row-{{ section.id }} .pf-row__track::-webkit-scrollbar-thumb { background: #d9cdb6; border-radius: 999px; }
  #pf-row-{{ section.id }} .pf-row__track > * { scroll-snap-align: start; min-width: 0; }
  #pf-row-{{ section.id }} .pf-row__arrow {
    position: absolute; top: 38%; z-index: 3; width: 4rem; height: 4rem; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer; border: 1px solid #ece3d4;
    background: #fff; color: #2a2622; box-shadow: 0 4px 14px rgba(0,0,0,.12); transition: opacity .15s ease, background .15s ease;
  }
  #pf-row-{{ section.id }} .pf-row__arrow:hover { background: #1e8541; color: #fff; border-color: #1e8541; }
  #pf-row-{{ section.id }} .pf-row__arrow[disabled] { opacity: 0; pointer-events: none; }
  #pf-row-{{ section.id }} .pf-row__arrow--prev { left: -1.6rem; }
  #pf-row-{{ section.id }} .pf-row__arrow--next { right: -1.6rem; }
  @media (max-width: 989px) {
    #pf-row-{{ section.id }} .pf-row__track { grid-auto-columns: calc((100% - 2 * 1.2rem) / 3.2); }
    #pf-row-{{ section.id }} .pf-row__arrow { display: none; }
  }
  @media (max-width: 599px) {
    #pf-row-{{ section.id }} .pf-row__track { grid-auto-columns: calc((100% - 1rem) / 2.25); gap: 1rem; }
  }
</style>

<div id="pf-row-{{ section.id }}" class="pf-row">
  <div class="pf-panel{% unless section.settings.boxed %} pf-panel--flat{% endunless %}">
    <div class="pf-panel__inner">
      <div class="pf-rowhead">
        <div>
          {%- if section.settings.heading != blank -%}<h2 class="pf-rowhead__title">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="pf-rowhead__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        {%- if view_all_url != blank -%}
          <a class="pf-rowhead__all" href="{{ view_all_url }}">
            {{ 'pf.view_all' | t }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <nav class="pf-row__chips" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <a class="pf-row__chip{% if block.settings.highlight %} pf-row__chip--hot{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              {{- block.settings.label -}}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="pf-row__viewport">
        <button type="button" class="pf-row__arrow pf-row__arrow--prev" aria-label="{{ 'pf.prev' | t }}" disabled>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="pf-row__track" tabindex="0">
          {%- if col != blank and col.products_count > 0 -%}
            {%- for product in col.products limit: limit -%}
              {% render 'pf-mini-card',
                product: product,
                section_id: section.id,
                show_rating: section.settings.show_rating,
                show_stock: section.settings.show_stock,
                low_stock: section.settings.low_stock
              %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <div class="pf-mc">
                <div class="pf-mc__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="pf-mc__body">
                  <h3 class="pf-mc__title">Product name</h3>
                  <div class="pf-mc__foot"><div class="pf-mc__price"><span class="pf-mc__now">0,00 €</span></div></div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="pf-row__arrow pf-row__arrow--next" aria-label="{{ 'pf.next' | t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('pf-row-{{ section.id }}');
    if (!root || root.dataset.pfInit) return;
    root.dataset.pfInit = '1';
    var track = root.querySelector('.pf-row__track');
    var prev = root.querySelector('.pf-row__arrow--prev');
    var next = root.querySelector('.pf-row__arrow--next');
    function update() {
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    function step(dir) { track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: 'smooth' }); }
    prev.addEventListener('click', function () { step(-1); });
    next.addEventListener('click', function () { step(1); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Hàng sản phẩm trượt",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Best Sellers" },
    { "type": "text", "id": "subheading", "label": "Phụ đề" },
    { "type": "collection", "id": "collection", "label": "Danh mục" },
    { "type": "url", "id": "view_all_link", "label": "Link \"Xem tất cả\"", "info": "Để trống = link tới danh mục ở trên" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 24, "step": 1, "label": "Số sản phẩm", "default": 12 },
    { "type": "range", "id": "columns_desktop", "min": 4, "max": 7, "step": 1, "label": "Số thẻ hiện trên máy tính", "default": 6 },
    { "type": "checkbox", "id": "show_rating", "label": "Hiện sao đánh giá", "default": true },
    { "type": "checkbox", "id": "show_stock", "label": "Hiện tình trạng kho (Còn hàng / Chỉ còn X)", "default": true },
    { "type": "range", "id": "low_stock", "min": 1, "max": 20, "step": 1, "label": "Báo \"Chỉ còn X\" khi tồn kho ≤", "default": 5 },
    { "type": "checkbox", "id": "boxed", "label": "Đặt trong khung trắng", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách trên", "default": 12 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Khoảng cách dưới", "default": 12 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Nút lọc nhanh",
      "settings": [
        { "type": "text", "id": "label", "label": "Nhãn", "default": "Under 3 €" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "highlight", "label": "Tô đỏ nổi bật", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Hàng sản phẩm trượt" }]
}
{% endschema %}
