{%- comment -%}
  Hiển thị khối lượng của dòng sản phẩm trong giỏ hàng.
  Chỉ hiện khi biến thể (variant) ĐÃ được set Weight trong Shopify.
  Dùng: {% render 'pf-cart-weight', line: item %}
{%- endcomment -%}
{%- assign pf_cw_g = line.grams | times: line.quantity -%}
{%- if pf_cw_g > 0 -%}
  {%- assign pf_cw_vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign pf_cw_vi = true -%}{%- endif -%}
  <div class="pf-cw">
    <span aria-hidden="true">⚖️</span>
    <span>{% if pf_cw_vi %}Khối lượng:{% else %}Weight:{% endif %}
      <b>{%- if pf_cw_g >= 1000 -%}{{ pf_cw_g | divided_by: 1000.0 | round: 2 }} kg{%- else -%}{{ pf_cw_g }} g{%- endif -%}</b>
    </span>
  </div>
  <style>
    .pf-cw { display: flex; align-items: center; gap: .35rem; margin-top: .5rem; font-size: 1.2rem; color: #6a6255; line-height: 1.3; }
    .pf-cw b { color: #3d3a33; font-weight: 700; }
  </style>
{%- endif -%}
