{%- comment -%}
  PHOMIFOOD — Chặn mềm khách truy cập từ US (client-side geo-block).
  - Phát hiện quốc gia qua get.geojs.io (miễn phí, có CORS, không cần key).
  - Nếu country === "US" → hiện overlay khoá trang + chặn cuộn.
  - FAIL-OPEN: nếu lỗi/mất mạng/quá thời gian thì KHÔNG chặn (tránh chặn nhầm khách EU).
  - Kết quả cache trong sessionStorage để không gọi lại mỗi trang.
  Lưu ý: đây là chặn phía trình duyệt, không chặn bot & không giảm tiền quảng cáo
  (muốn chặn tận gốc phải loại US trong Meta Ads).
{%- endcomment -%}
<div id="pf-geoblock" hidden>
  <div class="pf-geoblock__box">
    <div class="pf-geoblock__logo">PHOMIFOOD<span>.eu</span></div>
    <div class="pf-geoblock__ico">🇪🇺🚚</div>
    <h1 class="pf-geoblock__title">Chúng tôi chỉ phục vụ tại châu Âu</h1>
    <p class="pf-geoblock__txt">
      Phomifood hiện chỉ bán và giao hàng trong khu vực <b>châu Âu</b> nên rất tiếc chưa thể phục vụ đơn hàng của bạn.<br>
      <span class="pf-geoblock__en">We currently sell &amp; ship within <b>Europe</b> only and cannot serve your region yet.</span>
    </p>
    <p class="pf-geoblock__contact">📧 phomifood.eu &nbsp;·&nbsp; WhatsApp 0853 999 740</p>
  </div>
</div>

<style>
  #pf-geoblock:not([hidden]){
    position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;
    padding:24px;background:linear-gradient(160deg,#14672f,#1e8541);
  }
  html.pf-geoblocked,html.pf-geoblocked body{overflow:hidden !important;height:100% !important}
  .pf-geoblock__box{
    max-width:520px;width:100%;text-align:center;background:#fffdf8;border-radius:20px;
    padding:36px 28px;box-shadow:0 24px 60px rgba(0,0,0,.35);
    font-family:"Be Vietnam Pro",system-ui,sans-serif;color:#1b241d;
  }
  .pf-geoblock__logo{font-weight:800;font-size:1.5rem;color:#1e8541;letter-spacing:.3px;margin-bottom:14px}
  .pf-geoblock__logo span{color:#d62828}
  .pf-geoblock__ico{font-size:2.6rem;line-height:1;margin-bottom:10px}
  .pf-geoblock__title{font-size:1.6rem;font-weight:800;margin:0 0 12px;color:#14672f;line-height:1.2}
  .pf-geoblock__txt{font-size:1.05rem;line-height:1.6;color:#3a453c;margin:0 0 16px}
  .pf-geoblock__en{display:inline-block;margin-top:8px;color:#7a857b;font-size:.95rem}
  .pf-geoblock__contact{font-size:1rem;font-weight:600;color:#14672f;margin:0}
</style>

<script>
  (function(){
    var BLOCK=['US'];               // danh sách quốc gia bị chặn
    var KEY='pf_geo_cc';
    function apply(cc){
      if(!cc) return;
      if(BLOCK.indexOf(cc)>-1){
        var el=document.getElementById('pf-geoblock');
        if(el){ el.hidden=false; document.documentElement.classList.add('pf-geoblocked'); }
      }
    }
    // dùng cache trong phiên nếu có
    try{ var c=sessionStorage.getItem(KEY); if(c){ apply(c); return; } }catch(e){}
    var done=false, t=setTimeout(function(){ done=true; }, 3500); // fail-open sau 3.5s
    fetch('https://get.geojs.io/v1/ip/country.json',{cache:'no-store'})
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(done) return; clearTimeout(t);
        var cc=(d && d.country ? String(d.country).toUpperCase() : '');
        try{ if(cc) sessionStorage.setItem(KEY,cc); }catch(e){}
        apply(cc);
      })
      .catch(function(){ /* lỗi mạng → không chặn ai */ });
  })();
</script>
