{%- comment -%}
  PHOMIFOOD: hiện tên sản phẩm GIỮ dung tích / khối lượng, BỎ số lượng chai, hũ, gói...
  "Trà bí đao lon 310ml x 24"            → "Trà bí đao lon 310ml"
  "Sữa Kun Hương Nho 180ml x 48 hộp"     → "Sữa Kun Hương Nho 180ml"
  "Bún Thanh Thủy size S 500gx40 gói"    → "Bún Thanh Thủy size S 500g"
  "Nấm hương khô 100g (50 gói)"          → "Nấm hương khô 100g"
  "Bánh Tráng Mè Đen 40 hộp x 300g"      → "Bánh Tráng Mè Đen 300g"
  "Cá Đù Giòn Tẩm Vị 130g - Giòn Tan..." → "Cá Đù Giòn Tẩm Vị 130g"
  Cách làm: tên = phần trước chữ quy cách đầu tiên; sau đó gắn thêm dung tích/khối lượng
  đầu tiên tìm thấy trong phần quy cách (ml, g, gr, kg, l, cl, lít). Phần còn lại bị bỏ.
  Chữ quy cách: dung tích/khối lượng, "x 24" / "x24" / "*48", "(50 gói)", "24 gói" (không tính ở đầu tên).
  Không cắt: số đứng riêng ("loại 3", "Wake-up 247", "60 độ"), cỡ sợi "1.1mm", "4X".
  Tên gốc trong Shopify giữ nguyên (đơn hàng, checkout, catalog vẫn đủ quy cách).
  Cách dùng: {% render 'pf-short-title', title: product.title %} → đã escape.
{%- endcomment -%}
{%- liquid
  assign pf_digits = '0123456789'
  assign pf_units = ',ml,g,gr,kg,l,cl,lít,lit,gram,'
  assign pf_counts = ',gói,chai,lon,hộp,túi,lọ,hũ,bịch,bát,can,lốc,thùng,cái,vỉ,dây,'
  assign pf_words = title | strip | split: ' '
  assign pf_cut = pf_words.size
  assign pf_size = ''

  for w in pf_words
    assign wl = w | downcase | replace: '×', 'x' | replace: '*', 'x'
    assign c0 = wl | slice: 0
    assign c1 = wl | slice: 1
    assign nxt = pf_words[forloop.index] | downcase
    assign nxt0 = nxt | slice: 0
    assign is_spec = false
    assign w_size = ''

    if c0 == '(' and c1 != blank and pf_digits contains c1
      assign is_spec = true
    elsif c0 == 'x'
      assign rest_x = wl | remove_first: 'x'
      if rest_x == blank
        if nxt0 != blank and pf_digits contains nxt0
          assign is_spec = true
        endif
      else
        assign rx0 = rest_x | slice: 0
        if pf_digits contains rx0
          assign is_spec = true
        endif
      endif
    elsif c0 != blank and pf_digits contains c0
      assign base = wl
      if wl contains 'x'
        assign base = wl | split: 'x' | first
      endif
      assign unit = base | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: '.' | remove: ','
      assign unit_key = ',' | append: unit | append: ','
      assign nxt_key = ',' | append: nxt | append: ','
      if unit == blank
        if pf_units contains nxt_key
          assign is_spec = true
          assign w_size = w | append: ' ' | append: pf_words[forloop.index]
        elsif pf_counts contains nxt_key and forloop.index0 > 0
          assign is_spec = true
        elsif nxt0 == 'x' or nxt0 == '×' or nxt0 == '*'
          assign is_spec = true
        endif
      elsif pf_units contains unit_key
        assign is_spec = true
        assign w_size = w | slice: 0, base.size
      elsif pf_counts contains unit_key and forloop.index0 > 0
        assign is_spec = true
      endif
    endif

    if is_spec and pf_cut == pf_words.size
      assign pf_cut = forloop.index0
    endif
    if pf_cut < pf_words.size and w_size != blank
      assign pf_size = w_size
      break
    endif
  endfor

  assign pf_short = title | strip
  if pf_cut < pf_words.size
    assign pf_short = ''
    if pf_cut > 0
      assign pf_short = pf_words | slice: 0, pf_cut | join: ' '
    endif
    for i in (1..3)
      assign pf_last = pf_short | slice: -1
      if pf_last == '-' or pf_last == ',' or pf_last == '/' or pf_last == '(' or pf_last == ':' or pf_last == '|' or pf_last == '–'
        assign pf_short = pf_short | remove_last: pf_last | strip
      endif
    endfor
    if pf_size != blank
      assign pf_short = pf_short | append: ' ' | append: pf_size | strip
    endif
  endif
  if pf_short == blank
    assign pf_short = title
  endif
-%}
{{- pf_short | escape -}}
