{%- comment -%}
  Thẻ sản phẩm cho section "SIÊU SALE 10.10" (pf-sale-1010).
  Params: product (bắt buộc), section_id (bắt buộc), hidden (tuỳ chọn), badge (tuỳ chọn), low_stock (tuỳ chọn: ngưỡng "Chỉ còn N").
  Bản riêng, không dùng chung pf-ex-card để không ảnh hưởng section khác.
  Kiểu giảm giá thống nhất: nhãn xanh góc trái + ô đỏ "-x%" góc phải (tự tính từ giá gạch).
{%- endcomment -%}
{%- assign pf_v = product.selected_or_first_available_variant -%}
{%- assign pf_price = pf_v.price -%}
{%- assign pf_cmp = pf_v.compare_at_price -%}
{%- if pf_cmp == blank or pf_cmp <= pf_price -%}{%- assign pf_cmp = product.compare_at_price_max -%}{%- endif -%}
{%- comment -%} Tag cũ dạng "Giảm 20%" trùng với ô % tự tính, nên đổi thành nhãn chung. {%- endcomment -%}
{%- assign pf_label = badge | default: 'Ưu đãi' -%}
{%- if pf_label contains '%' -%}
  {%- if request.locale.iso_code == "vi" -%}{%- assign pf_label = 'Ưu đãi' -%}{%- else -%}{%- assign pf_label = 'Deal' -%}{%- endif -%}
{%- endif -%}
<div class="pf-s10__card{% if hidden %} pf-s10__card--hidden{% endif %}">
  <span class="pf-s10__badge">🔥 {{ pf_label }}</span>
  <a class="pf-s10__media" href="{{ product.url }}">
    {% render 'pf-preorder-badge', product: product %}
    {%- if pf_cmp > pf_price -%}
      <span class="pf-s10__sale">-{{ pf_cmp | minus: pf_price | times: 100.0 | divided_by: pf_cmp | round }}%</span>
    {%- endif -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200,300,400,500', sizes: '(max-width: 749px) 46vw, 250px', alt: product.title }}
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="pf-s10__info">
    <h3 class="pf-s10__nm"><a href="{{ product.url }}">{% render 'pf-short-title', title: product.title %}</a></h3>
    <div class="pf-s10__price">
      <span class="now">{{ pf_price | money }}</span>
      {%- if pf_cmp > pf_price -%}<span class="was">{{ pf_cmp | money }}</span>{%- endif -%}
    </div>
    {%- if pf_cmp > pf_price -%}
      <span class="pf-s10__save">{% if request.locale.iso_code == "vi" %}Tiết kiệm{% else %}Save{% endif %} {{ pf_cmp | minus: pf_price | money }}</span>
    {%- endif -%}
    {%- assign pf_low = low_stock | default: 0 -%}
    {%- if pf_low > 0 and pf_v.inventory_management == 'shopify' and pf_v.inventory_quantity > 0 and pf_v.inventory_quantity <= pf_low -%}
      <span class="pf-s10__low">⚡ {% if request.locale.iso_code == "vi" %}Chỉ còn {{ pf_v.inventory_quantity }} sản phẩm{% else %}Only {{ pf_v.inventory_quantity }} left{% endif %}</span>
    {%- endif -%}
    {% render 'pf-card-buttons', product: product, section_id: section_id %}
  </div>
</div>
