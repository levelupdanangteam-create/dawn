<style>
  .pf-fab {
    position: fixed; inset: auto 1.6rem 1.6rem auto; z-index: 2147482000;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .pf-fab__btn {
    position: relative; width: 5.4rem; height: 5.4rem; border-radius: 50%;
    display: grid; place-items: center; color: #fff; text-decoration: none;
    box-shadow: 0 8px 22px rgba(0, 0, 0, .22);
    transition: transform .15s ease, filter .15s ease, box-shadow .15s ease;
  }
  .pf-fab__btn:hover { transform: scale(1.08); filter: brightness(1.05); color: #fff; }
  .pf-fab__btn--wa { background: linear-gradient(145deg, #45d367, #1faf52); }
  .pf-fab__btn--mess { background: linear-gradient(145deg, #00c6ff, #0068ff); }
  /* Gentle attention pulse */
  .pf-fab__btn::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    box-shadow: 0 0 0 0 currentColor; opacity: .5; animation: pf-fab-pulse 2.4s infinite;
  }
  .pf-fab__btn--wa::after { color: #25d366; }
  .pf-fab__btn--mess::after { color: #0084ff; }
  @keyframes pf-fab-pulse {
    0% { box-shadow: 0 0 0 0 currentColor; opacity: .45; }
    70% { box-shadow: 0 0 0 1.2rem currentColor; opacity: 0; }
    100% { box-shadow: 0 0 0 0 currentColor; opacity: 0; }
  }
  /* Hover label */
  .pf-fab__label {
    position: absolute; right: calc(100% + 1rem); top: 50%; transform: translateY(-50%);
    background: #23201b; color: #fff; font-size: 1.25rem; font-weight: 700; white-space: nowrap;
    padding: .5rem .9rem; border-radius: 8px; opacity: 0; pointer-events: none;
    transition: opacity .15s ease; box-shadow: 0 4px 12px rgba(0,0,0,.2);
  }
  .pf-fab__label::after {
    content: ""; position: absolute; left: 100%; top: 50%; transform: translateY(-50%);
    border: 6px solid transparent; border-left-color: #23201b;
  }
  .pf-fab__btn:hover .pf-fab__label { opacity: 1; }
  @media (max-width: 749px) {
    .pf-fab { inset: auto 1.1rem 1.1rem auto; gap: .9rem; }
    .pf-fab__btn { width: 5rem; height: 5rem; }
    .pf-fab__label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-fab__btn::after { animation: none; }
  }
</style>
