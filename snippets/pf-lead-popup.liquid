{%- comment -%}
  PHOMIFOOD — Lead-capture popup.
  Invites the visitor to leave their details so Phomifood can keep the "Deal
  Sốc" offer for them and send future promotions. Uses Shopify's customer
  (newsletter) form, so submissions land in Admin → Customers with marketing
  consent. Shows once per session and is coordinated with the other popups so
  nothing overlaps.
{%- endcomment -%}

{%- assign pf_lead_ok = false -%}
{%- assign pf_lead_err = false -%}

<div class="pf-lead" id="pf-lead-popup" hidden aria-hidden="true">
  <div class="pf-lead__overlay" data-pf-lead-close></div>
  <div class="pf-lead__card" role="dialog" aria-modal="true" aria-label="Nhận Ưu đãi đặc biệt từ Phomifood">
    <button type="button" class="pf-lead__x" data-pf-lead-close aria-label="Đóng">&times;</button>

    {%- form 'contact', id: 'pf-lead-form', class: 'pf-lead__form' -%}
      {%- if form.posted_successfully? -%}
        {%- assign pf_lead_ok = true -%}
        <div class="pf-lead__thanks">
          <div class="pf-lead__flame">🎉</div>
          <h2 class="pf-lead__title">Cảm ơn bạn!</h2>
          <p class="pf-lead__sub">
            Phomifood đã <strong>giữ Ưu đãi đặc biệt</strong> cho bạn. Chúng tôi sẽ gửi ưu đãi này và các ưu đãi
            hấp dẫn sau này qua thông tin bạn để lại. Hẹn gặp lại bạn nhé!
          </p>
          <a class="pf-lead__cta" href="/pages/deal-0-euro">🔥 Xem Ưu đãi đặc biệt ngay</a>
        </div>
      {%- else -%}
        <div class="pf-lead__flame">🔥</div>
        <h2 class="pf-lead__title">Giữ Ưu đãi đặc biệt cho bạn!</h2>
        <p class="pf-lead__sub">
          Để giữ lại <strong>Ưu đãi đặc biệt</strong>, hãy cho Phomifood biết thông tin của bạn.
          Chúng tôi sẽ gửi tặng bạn ưu đãi này khi mua hàng, kèm các ưu đãi hấp dẫn sau này!
        </p>

        {%- if form.errors -%}
          {%- assign pf_lead_err = true -%}
          <div class="pf-lead__error">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <input type="hidden" name="contact[body]" value="Đăng ký giữ Ưu đãi đặc biệt từ popup website.">
        <div class="pf-lead__field">
          <input type="text" name="contact[first_name]" placeholder="Họ tên của bạn" autocomplete="name">
        </div>
        <div class="pf-lead__field">
          <input type="email" name="contact[email]" placeholder="Email của bạn *" required autocomplete="email">
        </div>
        <div class="pf-lead__field">
          <input type="tel" name="contact[phone]" placeholder="Số điện thoại *" required autocomplete="tel" pattern="[0-9+\s().-]{6,}">
        </div>

        <button type="submit" class="pf-lead__cta">🎁 Giữ Ưu đãi đặc biệt cho tôi</button>
        <button type="button" class="pf-lead__no" data-pf-lead-close>Để sau</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

<style>
  .pf-lead { position: fixed; inset: 0; z-index: 1001; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
  .pf-lead[hidden] { display: none; }
  .pf-lead__overlay { position: absolute; inset: 0; background: rgba(20,15,10,.62); backdrop-filter: blur(2px); }
  .pf-lead__card {
    position: relative; z-index: 1; width: 100%; max-width: 42rem;
    background: #fff; border-radius: 20px; padding: 2.6rem 2rem 1.8rem; text-align: center;
    box-shadow: 0 24px 60px rgba(0,0,0,.35); border: 3px solid #f2c14e;
    animation: pf-lead-pop .32s cubic-bezier(.2,.9,.3,1.2) both;
  }
  @keyframes pf-lead-pop { from { transform: translateY(24px) scale(.94); opacity: 0; } to { transform: none; opacity: 1; } }
  .pf-lead__x { position: absolute; top: 1rem; right: 1.1rem; border: 0; background: transparent; cursor: pointer; font-size: 2.6rem; line-height: 1; color: #b6ac97; padding: .2rem .6rem; }
  .pf-lead__x:hover { color: #6b6350; }
  .pf-lead__flame { font-size: 3.2rem; line-height: 1; }
  .pf-lead__title { margin: .4rem 0 0; font-size: clamp(2rem, 5.5vw, 2.6rem); font-weight: 900; color: #d62828; }
  .pf-lead__sub { margin: .8rem 0 1.6rem; font-size: 1.45rem; line-height: 1.55; color: #5a5346; }
  .pf-lead__sub strong { color: #14672f; }
  .pf-lead__field { margin-bottom: 1rem; }
  .pf-lead__field input {
    width: 100%; box-sizing: border-box; padding: 1.2rem 1.3rem; font-size: 1.5rem;
    border: 1.5px solid #e0d6bd; border-radius: 12px; background: #fffdf8; color: #3d3a33;
  }
  .pf-lead__field input:focus { outline: none; border-color: #1e8541; box-shadow: 0 0 0 3px rgba(30,133,65,.12); }
  .pf-lead__cta {
    display: block; width: 100%; box-sizing: border-box; margin-top: .4rem;
    background: linear-gradient(135deg, #e8452f 0%, #d62828 60%, #a81f1f 100%); color: #fff;
    font-size: 1.7rem; font-weight: 800; text-decoration: none; border: 0; cursor: pointer;
    padding: 1.35rem 1.5rem; border-radius: 999px; box-shadow: 0 8px 20px rgba(214,40,40,.35);
    transition: transform .15s ease;
  }
  .pf-lead__cta:hover { transform: translateY(-2px); color: #fff; }
  .pf-lead__no { display: block; margin: 1rem auto 0; border: 0; background: transparent; cursor: pointer; color: #9a9384; font-size: 1.35rem; text-decoration: underline; }
  .pf-lead__error {
    background: #fdeaea; border: 1px solid #f3c2c2; color: #c0392b; border-radius: 10px;
    padding: .9rem 1rem; font-size: 1.3rem; margin-bottom: 1.2rem; text-align: left;
  }
  .pf-lead__thanks { padding: .4rem 0; }
  @media (max-width: 749px) { .pf-lead__card { padding: 2.2rem 1.4rem 1.4rem; } }
</style>

<script>
  (function () {
    if (window.__pfLead) return;
    window.__pfLead = true;

    var el = document.getElementById('pf-lead-popup');
    if (!el) return;
    var KEY = 'pf_lead_shown';
    var forceOpen = {% if pf_lead_ok or pf_lead_err %}true{% else %}false{% endif %};

    // Claim the single popup slot (see the RULE in pf-popups). ignoreCooldown
    // lets the after-submit result show immediately.
    function claim(ignoreCooldown) {
      if (window.PFPopups && typeof window.PFPopups.claim === 'function') return window.PFPopups.claim(ignoreCooldown);
      return !document.querySelector('.pf-pop.is-open, #pf-exit-intent:not([hidden])');
    }
    function show() {
      el.hidden = false;
      el.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }
    function close() {
      el.hidden = true;
      el.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      if (window.PFPopups && typeof window.PFPopups.markClosed === 'function') window.PFPopups.markClosed();
    }
    el.querySelectorAll('[data-pf-lead-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !el.hidden) close(); });

    // After a submit (success or error) the page reloads — show the result.
    if (forceOpen) { try { sessionStorage.setItem(KEY, '1'); } catch (e) {} claim(true); show(); return; }

    // Otherwise: show once per session, ~30s after landing. The slot must be
    // free (no other popup open, cooldown elapsed) — otherwise retry.
    try { if (sessionStorage.getItem(KEY) === '1') return; } catch (e) {}
    setTimeout(function tryOpen() {
      try { if (sessionStorage.getItem(KEY) === '1') return; } catch (e) {}
      if (!claim(false)) { setTimeout(tryOpen, 3000); return; }
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      show();
    }, 30000);
  })();
</script>
