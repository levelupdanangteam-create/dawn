{%- comment -%}
  Video riêng cho từng sản phẩm (khớp theo handle).
  Thêm sản phẩm mới: thêm một nhánh {%- when 'handle-cua-san-pham' -%} với danh sách URL video.
{%- endcomment -%}
{%- assign pf_pv_urls = '' -%}
{%- case product.handle -%}
  {%- when 'canh-chua-isoup' -%}
    {%- assign pf_pv_urls = 'https://cdn.shopify.com/videos/c/o/v/6cdfb0dc6a9a4c0cbd295df5dc6668a4.mp4,https://cdn.shopify.com/videos/c/o/v/f8a00a1c3d604feb9edd96b0f3c6679f.mp4,https://cdn.shopify.com/videos/c/o/v/3025f2f9a4714a7a840067e5db0e13e9.mp4' -%}
{%- endcase -%}

{%- if pf_pv_urls != '' -%}
  {%- assign pf_pv_list = pf_pv_urls | split: ',' -%}
  <section class="pf-pvid">
    <div class="pf-pvid__inner page-width">
      <h2 class="pf-pvid__h">{% if request.locale.iso_code == 'vi' %}🎬 Video sản phẩm{% else %}🎬 Product videos{% endif %}</h2>
      <div class="pf-pvid__grid">
        {%- for u in pf_pv_list -%}
          <video class="pf-pvid__v" controls playsinline preload="metadata" muted loop>
            <source src="{{ u | strip }}" type="video/mp4">
          </video>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <style>
    .pf-pvid { margin: 3rem 0 1rem; padding: 3.5rem 0; background: #f4f1ea; border-top: 1px solid #ece6d8; }
    .pf-pvid__inner { text-align: center; }
    .pf-pvid__h { font-size: 2.2rem; font-weight: 700; margin: 0 0 1.8rem; color: #2e7d46; }
    .pf-pvid__grid {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 1.4rem;
    }
    .pf-pvid__v {
      width: 100%; max-width: 260px; aspect-ratio: 9 / 16; object-fit: cover;
      border-radius: 14px; background: #000; display: block;
      box-shadow: 0 8px 22px rgba(0,0,0,.16);
    }
    @media (max-width: 749px) {
      .pf-pvid { padding: 2.4rem 0; }
      .pf-pvid__h { font-size: 1.8rem; }
      /* Lướt ngang trên điện thoại */
      .pf-pvid__grid {
        display: flex; flex-wrap: nowrap; justify-content: flex-start;
        gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding: 0 1.5rem .8rem; margin: 0 -1.5rem;
        scrollbar-width: none;
      }
      .pf-pvid__grid::-webkit-scrollbar { display: none; }
      .pf-pvid__v {
        flex: 0 0 auto; width: 62vw; max-width: 260px;
        scroll-snap-align: center;
      }
    }
  </style>
{%- endif -%}
