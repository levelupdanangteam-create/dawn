{%- comment -%}
  Bảng tổng tiền trong "Order summary" (trang giỏ hàng):
    Subtotal · Discount · Shipping (theo nước đang chọn) · 10% off (IE/DK/FI/SE từ €169) · TOTAL (đã cộng ship).
  Nước giao lấy từ ô chọn ở khung "Shipping" (pf-ship-table), mặc định = nước khách đang mua.
  Dùng chung bảng phí với thanh cố định (pf-cart-stickybar) qua window.pfShip — đổi nước là cả 2 cập nhật.
  Phí ship cố định theo nước + mốc €169: sửa ở PF_SHIP_FEES bên dưới (giữ khớp pf-ship-table).
{%- endcomment -%}
{%- liquid
  assign vi = true
  assign sub_before = cart.items_subtotal_price
-%}
{% render 'pf-ship-rates' %}
<div class="pf-tot" data-pf-tot data-sub="{{ cart.total_price }}" data-weight="{{ cart.total_weight }}" data-cc="{{ localization.country.iso_code }}">
  <div class="pf-tot__row"><span>{% if vi %}Tạm tính{% else %}Subtotal{% endif %} ({{ cart.item_count }})</span><span>{{ sub_before | money }}</span></div>
  {%- if cart.total_discount > 0 -%}
    <div class="pf-tot__row pf-tot__row--green"><span>{% if vi %}Giảm giá{% else %}Discount{% endif %}</span><span>−{{ cart.total_discount | money }}</span></div>
  {%- endif -%}
  <div class="pf-tot__row"><span>{% if vi %}Phí ship{% else %}Shipping{% endif %} <em data-pf-tot-country></em></span><span data-pf-tot-ship>—</span></div>
  <div class="pf-tot__row pf-tot__row--green" data-pf-tot-discrow hidden><span>{% if vi %}Giảm 10% (từ €169){% else %}10% off (from €169){% endif %}</span><span data-pf-tot-disc></span></div>
  <div class="pf-tot__total"><span>{% if vi %}Tổng cộng{% else %}Total{% endif %}</span><span data-pf-tot-total>{{ cart.total_price | money }}</span></div>
</div>
<script>
  (function () {
    // Phí ship theo nước + CÂN NẶNG giỏ (bảng giá trong pf-ship-rates, khớp Shopify)
    var R = window.pfRates, VI = {{ vi | json }};
    var PF_SHIP_FEES = R.R, eur = R.eur;
    function getCc(fallback) { try { var s = sessionStorage.getItem('pf_ship_cc'); if (s && PF_SHIP_FEES[s]) return s; } catch (e) {} return fallback; }
    // Trả về phí ship, giảm 10% (nước 'disc' khi đạt €169), tổng cuối
    function calc(cc, sub, grams) {
      var q = R.quote(cc, grams, sub); if (!q) return null;
      var ship = q.over ? 0 : q.ship;
      var disc = (q.reached && q.perk === 'disc') ? Math.round(sub * 0.10) : 0;
      q.disc = disc; q.total = sub + ship - disc; return q;
    }
    // Chỉ ghi khi giá trị đổi → tránh MutationObserver tự kích hoạt lặp vô hạn
    function setT(el, v) { if (el && el.textContent !== v) el.textContent = v; }
    function setH(el, v) { if (el && el.dataset.pfv !== v) { el.dataset.pfv = v; el.innerHTML = v; } }
    function update() {
      document.querySelectorAll('[data-pf-tot]').forEach(function (box) {
        var sub = parseInt(box.dataset.sub, 10) || 0, g = parseInt(box.dataset.weight, 10) || 0, cc = getCc(box.dataset.cc), c = calc(cc, sub, g);
        var q = function (s) { return box.querySelector(s); };
        if (!c) { setT(q('[data-pf-tot-ship]'), VI ? 'Tính khi thanh toán' : 'At checkout'); return; }
        setT(q('[data-pf-tot-country]'), '(' + c.name + ' · ' + R.kg(g) + ')');
        setT(q('[data-pf-tot-ship]'), c.over ? 'Liên hệ shop' : (c.ship === 0 ? (VI ? 'Miễn phí' : 'Free') : eur(c.ship)));
        var dr = q('[data-pf-tot-discrow]'); if (dr.hidden !== !c.disc) dr.hidden = !c.disc;
        setT(q('[data-pf-tot-disc]'), '−' + eur(c.disc));
        setT(q('[data-pf-tot-total]'), eur(c.total));
        document.querySelectorAll('[data-pf-csb-total]').forEach(function (el) { setT(el, eur(c.total)); });
        document.querySelectorAll('[data-pf-csb-shipline]').forEach(function (el) {
          var h, ok = c.free || (c.reached && c.perk === 'disc');
          if (c.over) h = 'Đơn trên 40 kg · nhắn shop để báo phí ship';
          else if (c.free) h = '<b>Miễn phí vận chuyển</b> đến ' + c.name;
          else if (c.reached && c.perk === 'disc') h = 'Đã đạt <b>giảm 10%</b> · ship ' + eur(c.fee);
          else if (c.reached) h = 'Ship đến ' + c.name + ' ' + eur(c.fee) + ' (đơn trên 30 kg)';
          else h = 'Ship đến ' + c.name + ' ' + eur(c.fee) + ' · thêm <b>' + eur(c.rem) + '</b> để ' + (c.perk === 'disc' ? 'giảm 10%' : 'Freeship');
          setH(el, h);
          var wrap = el.closest('.pf-csb__ship'); if (wrap && wrap.classList.contains('is-ok') !== ok) wrap.classList.toggle('is-ok', ok);
        });
      });
    }
    window.pfShip = { fees: PF_SHIP_FEES, calc: calc, update: update, setCc: function (cc) { try { sessionStorage.setItem('pf_ship_cc', cc); } catch (e) {} update(); }, getCc: getCc };
    update();
    document.addEventListener('DOMContentLoaded', update);
    // Giỏ đổi số lượng → Dawn thay nội dung khung tổng → tính lại
    if (!window.__pfTotObs) {
      var root = document.getElementById('main-cart-footer');
      if (root) { window.__pfTotObs = new MutationObserver(function () { clearTimeout(window.__pfTotT); window.__pfTotT = setTimeout(update, 30); }); window.__pfTotObs.observe(root, { childList: true, subtree: true }); }
    }
  })();
</script>
<style>
  .pf-tot { margin: .4rem 0 1rem; font-size: 1.4rem; color: #4a443c; }
  .pf-tot__row { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; }
  .pf-tot__row em { font-style: normal; color: #8a857c; font-size: 1.25rem; }
  .pf-tot__row span:last-child { font-weight: 700; color: #2a2622; white-space: nowrap; }
  .pf-tot__row--green span:last-child { color: #1e8541; }
  .pf-tot__total { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: .6rem; padding-top: 1rem; border-top: 1px dashed #e2d9c9; font-size: 1.7rem; font-weight: 800; color: #2a2622; }
  .pf-tot__total span:last-child { font-size: 2.4rem; font-weight: 900; color: #d62828; }
</style>
