{%- comment -%}
  Ô "Phí vận chuyển & ưu đãi" trên trang giỏ hàng: khách CHỌN QUỐC GIA → hiện phí ship cụ thể,
  ưu đãi (Freeship hoặc giảm 10% từ €169) và số tiền còn thiếu theo giỏ hiện tại.
  Mặc định chọn sẵn nước khách đang mua (localization.country). Phí ship cố định – sửa ở mảng ROWS bên dưới
  (giữ khớp với pf-cart-stickybar và section "Shipping rates" ở trang chủ).
{%- endcomment -%}
{%- liquid
  assign vi = true
  assign rows = 'SK|Slovakia|11|free;PL|Ba Lan|12|free;DE|Đức|13|free;HU|Hungary|13|free;BG|Bulgaria|13|free;RO|Romania|13|free;AT|Áo|14|free;IT|Ý|16|free;HR|Croatia|16|free;BE|Bỉ|17|free;FR|Pháp|17|free;NL|Hà Lan|17|free;ES|Tây Ban Nha|17|free;PT|Bồ Đào Nha|17|free;GR|Hy Lạp|17|free;IE|Ireland|22|disc;DK|Đan Mạch|46|disc;FI|Phần Lan|46|disc;SE|Thụy Điển|46|disc' | split: ';'
  assign cur = localization.country.iso_code
-%}
<div class="pf-ship" data-pf-ship data-sub="{{ cart.total_price }}" data-goal="16900" data-vi="{{ vi }}">
  <label class="pf-ship__lbl" for="PfShipCountry">🚚 {% if vi %}Phí vận chuyển{% else %}Shipping{% endif %}</label>
  <div class="pf-ship__line">
    <div class="pf-ship__selwrap">
      <select id="PfShipCountry" class="pf-ship__sel" data-pf-ship-sel aria-label="{% if vi %}Giao đến{% else %}Ship to{% endif %}">
        {%- for r in rows -%}
          {%- assign p = r | split: '|' -%}
          <option value="{{ p[0] }}" data-fee="{{ p[2] }}" data-perk="{{ p[3] }}"{% if p[0] == cur %} selected{% endif %}>{{ p[1] }}</option>
        {%- endfor -%}
      </select>
    </div>
    <span class="pf-ship__v" data-pf-ship-fee aria-live="polite">—</span>
  </div>
  <p class="pf-ship__note" data-pf-ship-note aria-live="polite"></p>
</div>
<script>
  (function () {
    document.querySelectorAll('[data-pf-ship]').forEach(function (box) {
      if (box.dataset.pfInit) return; box.dataset.pfInit = '1';
      var sel = box.querySelector('[data-pf-ship-sel]');
      var vi = box.dataset.vi === 'true';
      var goal = parseInt(box.dataset.goal, 10) || 16900;
      function eur(c) { return '€' + (c / 100).toFixed(2).replace('.', ','); }
      function render() {
        var o = sel.options[sel.selectedIndex]; if (!o) return;
        var fee = parseInt(o.dataset.fee, 10) * 100, disc = o.dataset.perk === 'disc';
        var sub = parseInt(box.dataset.sub, 10) || 0, rem = goal - sub;
        box.querySelector('[data-pf-ship-fee]').textContent = eur(fee);
        var note = box.querySelector('[data-pf-ship-note]');
        if (rem <= 0) {
          note.innerHTML = disc
            ? (vi ? '🎉 Giỏ đã đạt €169 — được <b>giảm 10%</b> (phí ship ' + eur(fee) + ').' : '🎉 Your cart reached €169 — you get <b>10% off</b> (shipping ' + eur(fee) + ').')
            : (vi ? '🎉 Giỏ đã đạt €169 — <b>miễn phí ship</b>!' : '🎉 Your cart reached €169 — <b>free shipping</b>!');
        } else {
          note.innerHTML = vi
            ? 'Mua thêm <b>' + eur(rem) + '</b> để được ' + (disc ? '<b>giảm 10%</b>' : '<b>miễn phí ship</b>') + '.'
            : 'Add <b>' + eur(rem) + '</b> more to get ' + (disc ? '<b>10% off</b>' : '<b>free shipping</b>') + '.';
        }
      }
      function refresh() {
        fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'cart.js', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (c) { box.dataset.sub = c.total_price; render(); }).catch(function () {});
      }
      try { var saved = sessionStorage.getItem('pf_ship_cc'); if (saved && sel.querySelector('option[value="' + saved + '"]')) sel.value = saved; } catch (e) {}
      sel.addEventListener('change', function () { render(); if (window.pfShip) window.pfShip.setCc(sel.value); });
      // Giỏ đổi số lượng/xoá SP → cập nhật "còn thiếu bao nhiêu"
      if (window.subscribe && window.PUB_SUB_EVENTS) { try { subscribe(PUB_SUB_EVENTS.cartUpdate, refresh); } catch (e) {} }
      render();
    });
  })();
</script>
<style>
  .pf-ship { margin: 0; }
  .pf-ship__lbl { display: block; margin-bottom: .6rem; font-size: 1.4rem; font-weight: 800; color: #2a2622; }
  .pf-ship__line { display: flex; align-items: center; gap: 1rem; }
  .pf-ship__selwrap { position: relative; flex: 1; min-width: 0; }
  .pf-ship__selwrap::after { content: ""; position: absolute; right: 1.2rem; top: 50%; width: .7rem; height: .7rem; margin-top: -.5rem;
    border: solid #6b665e; border-width: 0 2px 2px 0; transform: rotate(45deg); pointer-events: none; }
  .pf-ship__sel { width: 100%; height: 4.4rem; padding: 0 3.2rem 0 1.2rem; border: 1px solid #d9d4ca; border-radius: 10px;
    background: #fff; font: inherit; font-size: 1.4rem; color: #2a2622; appearance: none; -webkit-appearance: none; cursor: pointer; }
  .pf-ship__sel:focus { outline: 2px solid #1e8541; outline-offset: 0; border-color: #1e8541; }
  .pf-ship__v { flex: none; min-width: 6.4rem; text-align: right; font-size: 1.7rem; font-weight: 900; color: #2a2622; }
  .pf-ship__note { margin: .6rem 0 0; font-size: 1.2rem; color: #6b665e; }
  .pf-ship__note b { color: #1e8541; }
</style>
