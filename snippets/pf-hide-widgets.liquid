{%- comment -%}
  Hide the injected "Shop with AI" / Shopify store-assistant widget.
  Uses CSS for known selectors + JS that pierces shadow DOM and matches
  by visible text / aria-label, retrying for late/async injection.
{%- endcomment -%}
<style>
  /* Known / likely selectors for the Shopify store-assistant pill */
  shopify-store-assistant,
  shop-store-assistant,
  [id*="store-assistant" i],
  [class*="store-assistant" i],
  [id*="shop-assistant" i],
  [class*="shop-assistant" i],
  [id*="shop-ai" i],
  [class*="shop-ai" i],
  [aria-label="Shop with AI" i],
  [title="Shop with AI" i] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>
<script>
  (function () {
    if (window.__pfHideWidgets) return;
    window.__pfHideWidgets = true;

    var TARGETS = ['shop with ai'];

    function matches(el) {
      if (!el || el.__pfHidden) return false;
      var aria = (el.getAttribute && (el.getAttribute('aria-label') || el.getAttribute('title')) || '').trim().toLowerCase();
      if (aria && TARGETS.indexOf(aria) !== -1) return true;
      var txt = (el.textContent || '').trim().toLowerCase();
      return TARGETS.indexOf(txt) !== -1 && el.children.length <= 6;
    }

    function hide(el) {
      // Climb to the outermost element that still holds only this text (whole pill).
      var target = el, txt = (el.textContent || '').trim().toLowerCase();
      while (
        target.parentElement &&
        (target.parentElement.textContent || '').trim().toLowerCase() === txt
      ) {
        target = target.parentElement;
      }
      target.style.setProperty('display', 'none', 'important');
      target.__pfHidden = true;
    }

    function scan(root) {
      var nodes;
      try { nodes = root.querySelectorAll('button, a, [role="button"], div, span, [aria-label], [title]'); }
      catch (e) { return; }
      for (var i = 0; i < nodes.length; i++) {
        var el = nodes[i];
        if (matches(el)) hide(el);
        // Recurse into shadow roots (Shopify widgets often use them).
        if (el.shadowRoot) scan(el.shadowRoot);
      }
    }

    function run() {
      scan(document);
      var tries = 0;
      var timer = setInterval(function () {
        scan(document);
        if (++tries >= 20) clearInterval(timer);
      }, 600);
      if (window.MutationObserver) {
        new MutationObserver(function () { scan(document); }).observe(document.documentElement, { childList: true, subtree: true });
      }
    }

    run();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  })();

  // Toggle body.pf-menu-open while the mobile menu drawer is open, so CSS can
  // hide the slideshow arrows/dots even in in-app browsers without :has().
  (function () {
    if (window.__pfMenuOpen) return;
    window.__pfMenuOpen = true;

    function sync() {
      var open = !!document.querySelector('.menu-drawer-container[open]');
      document.body.classList.toggle('pf-menu-open', open);
    }

    function bind() {
      sync();
      if (window.MutationObserver) {
        new MutationObserver(sync).observe(document.documentElement, {
          attributes: true, attributeFilter: ['open'], subtree: true
        });
      }
      document.addEventListener('click', function () { setTimeout(sync, 30); }, true);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
    else bind();
  })();
</script>
