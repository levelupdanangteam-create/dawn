{%- comment -%}
  Nút tìm kiếm nổi góc dưới bên phải (29/10).
  - Bấm → mở ô tìm kiếm của header (Dawn details-modal); không có thì sang trang /search.
  - Điện thoại: khi thanh giỏ hàng cố định (pf-sticky-cart, body.pf-stc-on) đang hiện, nút nằm ngay trên thanh đó.
{%- endcomment -%}
<a
  href="{{ routes.search_url }}"
  class="pf-sfab"
  data-pf-search-fab
  aria-label="{% if request.locale.iso_code == 'vi' %}Tìm kiếm sản phẩm{% else %}Search products{% endif %}"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
</a>

<style>
  .pf-sfab {
    position: fixed; right: 2rem; bottom: 2rem; z-index: 21;
    width: 5.6rem; height: 5.6rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #1e8541; color: #fff; text-decoration: none;
    box-shadow: 0 8px 22px rgba(20, 103, 47, .35);
    transition: bottom .35s cubic-bezier(.2, .7, .3, 1), transform .15s ease, background .15s ease;
  }
  .pf-sfab:hover { background: #14672f; transform: scale(1.06); }
  .pf-sfab:focus-visible { outline: 3px solid #ffc61a; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .pf-sfab { right: 1.4rem; bottom: 1.6rem; width: 5rem; height: 5rem; }
    /* Thanh giỏ hàng cố định đang hiện (cao ~6rem, cách đáy 1.6rem) → đưa nút lên trên nó */
    body.pf-stc-on .pf-sfab { bottom: 9.2rem; }
  }
  @media screen and (min-width: 750px) {
    /* Máy tính: thanh giỏ hàng nằm giữa, rộng tối đa 72rem — chỉ đẩy nút lên khi màn hình hẹp hơn thanh + nút */
    body.pf-stc-on .pf-sfab { bottom: 2rem; }
  }
  @media screen and (min-width: 750px) and (max-width: 899px) {
    body.pf-stc-on .pf-sfab { bottom: 9.6rem; }
  }
  @media print { .pf-sfab { display: none; } }
</style>

<script>
  (function () {
    if (window.__pfSearchFab) return;
    window.__pfSearchFab = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('[data-pf-search-fab]');
      if (!btn) return;
      var summary = document.querySelector('details-modal.header__search summary');
      if (!summary) return; // không có ô tìm kiếm header → đi theo link /search
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      summary.click();
    });
  })();
</script>
