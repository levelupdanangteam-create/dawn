{%- comment -%}
  PHOMIFOOD — Social-proof "recent order" popup (self-contained).
  Cycles through recent-order notifications: name • city, product, order value,
  a blurred address line, and time-ago. Bottom-left toast, auto-dismiss,
  closeable. Edit the pf_orders array below to change the notifications.
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

<div id="pf-sp" class="pf-sp" role="status" aria-live="polite" hidden>
  <button type="button" class="pf-sp__close" id="pf-sp-close" aria-label="{% if vi %}Đóng{% else %}Close{% endif %}">&times;</button>
  <div class="pf-sp__check" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
  </div>
  <div class="pf-sp__body">
    <div class="pf-sp__line1">
      <span class="pf-sp__name" id="pf-sp-name"></span>
      <span class="pf-sp__city" id="pf-sp-city"></span>
    </div>
    <div class="pf-sp__line2">
      <span id="pf-sp-action">{% if vi %}vừa đặt{% else %}just ordered{% endif %}</span>
      <span class="pf-sp__val" id="pf-sp-val"></span>
      <span class="pf-sp__time" id="pf-sp-time"></span>
    </div>
    <div class="pf-sp__addr">
      <span class="pf-sp__pin" aria-hidden="true">📍</span>
      <span class="pf-sp__blur" id="pf-sp-addr"></span><span id="pf-sp-addrcity"></span>
    </div>
  </div>
</div>

<style>
  .pf-sp {
    position: fixed; inset: auto auto 1.4rem 1.4rem; z-index: 2147483000;
    width: min(26rem, calc(100vw - 2.6rem));
    display: flex; align-items: center; gap: .85rem;
    background: #fff; border: 1px solid #e6ecdf; border-left: 4px solid #1e8541;
    border-radius: 13px; padding: .8rem 2rem .8rem .9rem;
    box-shadow: 0 10px 28px rgba(20, 60, 30, .16);
    transform: translateY(140%); opacity: 0;
    transition: transform .5s cubic-bezier(.2,.8,.2,1), opacity .4s ease;
    font-family: inherit;
  }
  .pf-sp[hidden] { display: none; }
  .pf-sp.is-in { transform: translateY(0); opacity: 1; }
  .pf-sp__close {
    position: absolute; top: .3rem; right: .4rem; width: 2rem; height: 2rem; border: 0;
    background: transparent; color: #b3aa99; font-size: 1.6rem; line-height: 1; cursor: pointer; border-radius: 50%;
  }
  .pf-sp__close:hover { background: #f2ede3; color: #5a5346; }
  .pf-sp__check {
    flex: none; width: 2.8rem; height: 2.8rem; border-radius: 50%;
    background: linear-gradient(135deg, #23a152, #14672f); display: grid; place-items: center;
    box-shadow: 0 3px 8px rgba(20, 103, 47, .28);
  }
  .pf-sp__check svg { width: 16px; height: 16px; }
  .pf-sp__body { min-width: 0; flex: 1; }
  .pf-sp__line1 { display: flex; align-items: baseline; gap: .4rem; flex-wrap: wrap; }
  .pf-sp__name { font-size: 1.3rem; font-weight: 800; color: #23201b; }
  .pf-sp__city { font-size: 1.1rem; color: #1e8541; font-weight: 700; }
  .pf-sp__line2 { margin-top: .1rem; font-size: 1.15rem; color: #6a6255; line-height: 1.3; display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .pf-sp__val {
    background: #fdeaea; color: #d62828; font-weight: 800; font-size: 1.1rem;
    padding: .05rem .5rem; border-radius: 999px; white-space: nowrap;
  }
  .pf-sp__time { font-size: 1.05rem; color: #a49c8c; }
  .pf-sp__addr { margin-top: .15rem; font-size: 1.05rem; color: #9a9080; display: flex; align-items: center; gap: .25rem; white-space: nowrap; overflow: hidden; }
  .pf-sp__blur { filter: blur(3px); user-select: none; letter-spacing: .5px; }
  @media (max-width: 749px) {
    /* Gọn hơn, nâng cao khỏi mép dưới và chừa chỗ cho nút liên hệ bên phải. */
    .pf-sp {
      left: .8rem; bottom: 5.5rem; right: auto;
      width: min(19rem, calc(100vw - 8rem));
      padding: .9rem 1.9rem .9rem .8rem; gap: .6rem; border-radius: 11px;
    }
    .pf-sp__check { width: 2.3rem; height: 2.3rem; }
    .pf-sp__name { font-size: 1.2rem; }
    .pf-sp__city { font-size: 1.05rem; }
    .pf-sp__line2 { font-size: 1.05rem; }
    .pf-sp__val { font-size: 1.02rem; }
    .pf-sp__addr { font-size: .98rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-sp { transition: opacity .3s ease; transform: none; }
  }
</style>

<script>
  (function () {
    var el = document.getElementById('pf-sp');
    if (!el) return;
    // Re-attach to <body> so a transformed ancestor (e.g. an injected popup
    // container) can't trap our position:fixed and float it mid-screen.
    if (el.parentNode !== document.body) { document.body.appendChild(el); }
    var VI = {{ vi }};

    // ==== Editable sample orders ==================================
    // name, city (hiển thị), country flag, product, value(€), street (bị làm mờ), addrCity
    var ORDERS = [
      ['Thu Hương', 'Praha', '🇨🇿', VI ? 'Mì Hảo Hảo & nước mắm Chinsu' : 'Hao Hao noodles & fish sauce', 142, 'Vinohradská 118', 'Praha 3'],
      ['Quốc Tuấn', 'Berlin', '🇩🇪', VI ? 'Bún, phở khô & gia vị' : 'Rice noodles & seasonings', 89, 'Karl-Marx-Str. 42', 'Berlin'],
      ['Ngọc Lan', 'Paris', '🇫🇷', VI ? 'Combo gạo ST25 & cà phê G7' : 'ST25 rice & G7 coffee', 176, 'Rue de Belleville 61', 'Paris 20'],
      ['Việt Minh', 'Warszawa', '🇵🇱', VI ? 'Thùng mì Omachi & bánh gạo' : 'Omachi noodles & rice crackers', 210, 'Marszałkowska 9', 'Warszawa'],
      ['Hồng Mai', 'Amsterdam', '🇳🇱', VI ? 'Nước mắm, mắm tôm & cà pháo' : 'Sauces & pickled eggplant', 64, 'Damstraat 7', 'Amsterdam'],
      ['Trung Đức', 'München', '🇩🇪', VI ? 'Hạt nêm Knorr & dầu hào' : 'Knorr bouillon & oyster sauce', 118, 'Landsberger Str. 24', 'München'],
      ['Thanh Thủy', 'Brno', '🇨🇿', VI ? 'Bánh đa nem & bún Gia Bảo' : 'Rice paper & vermicelli', 73, 'Cejl 55', 'Brno'],
      ['Hải Long', 'Bruxelles', '🇧🇪', VI ? 'Combo bán sỉ nhà hàng' : 'Wholesale restaurant combo', 268, 'Chaussée de Louvain 30', 'Bruxelles'],
      ['Kiều Nga', 'Praha', '🇨🇿', VI ? 'Sữa TH, Kun & bánh Chocopie' : 'Milk & Chocopie', 96, 'Českomoravská 12', 'Praha 9'],
      ['Thái Sơn', 'Wien', '🇦🇹', VI ? 'Phở Đệ Nhất & cà phê Trung Nguyên' : 'Pho & coffee', 131, 'Favoritenstraße 88', 'Wien']
    ];
    // =============================================================

    var name = document.getElementById('pf-sp-name');
    var city = document.getElementById('pf-sp-city');
    var val  = document.getElementById('pf-sp-val');
    var addr = document.getElementById('pf-sp-addr');
    var addrCity = document.getElementById('pf-sp-addrcity');
    var timeEl = document.getElementById('pf-sp-time');

    var i = Math.floor((new Date().getTime() / 60000) % ORDERS.length);
    var stopped = false;
    var hideT, nextT;

    function timeAgo() {
      var m = 2 + Math.floor(Math.random() * 22);
      return VI ? (m + ' phút trước') : (m + ' min ago');
    }
    function render() {
      var o = ORDERS[i % ORDERS.length];
      name.textContent = o[0];
      city.textContent = '• ' + o[1] + ' ' + o[2];
      val.textContent = o[4] + '€';
      addr.textContent = o[5];
      addrCity.textContent = ', ' + o[6];
      timeEl.textContent = '· ' + timeAgo();
      i++;
    }
    function show() {
      if (stopped) return;
      render();
      el.hidden = false;
      // force reflow then animate in
      void el.offsetWidth;
      el.classList.add('is-in');
      hideT = setTimeout(hide, 6500);
    }
    function hide() {
      el.classList.remove('is-in');
      setTimeout(function () { el.hidden = true; }, 500);
      if (!stopped) nextT = setTimeout(show, 9000 + Math.random() * 7000);
    }
    document.getElementById('pf-sp-close').addEventListener('click', function () {
      stopped = true;
      clearTimeout(hideT); clearTimeout(nextT);
      el.classList.remove('is-in');
      setTimeout(function () { el.hidden = true; }, 400);
    });

    // First popup a few seconds after load.
    setTimeout(show, 4000);
  })();
</script>
