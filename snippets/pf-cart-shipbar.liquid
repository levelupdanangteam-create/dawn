{%- comment -%}
  Cart shipping-fee reward progress (compact — shows only the NEXT milestone).
  −10€ from 169€, −15€ from 269€. Re-renders with the cart on change.
{%- endcomment -%}
{%- unless cart == empty -%}
  {%- assign pf_t1 = 16900 -%}{%- comment -%}169€{%- endcomment -%}
  {%- assign pf_t2 = 26900 -%}{%- comment -%}269€{%- endcomment -%}
  {%- assign pf_sub = cart.total_price -%}
  {%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

  {%- comment -%}Pick the current target = next unmet milestone.{%- endcomment -%}
  {%- if pf_sub < pf_t1 -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_t1 -%}
    {%- assign pf_rem = pf_t1 | minus: pf_sub -%}
    {%- assign pf_state = 'tier1' -%}
  {%- elsif pf_sub < pf_t2 -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_t2 -%}
    {%- assign pf_rem = pf_t2 | minus: pf_sub -%}
    {%- assign pf_state = 'tier2' -%}
  {%- else -%}
    {%- assign pf_pct = 100 -%}
    {%- assign pf_state = 'max' -%}
  {%- endif -%}

  <div class="pf-shipbar pf-shipbar--{{ pf_state }}">
    <p class="pf-shipbar__line">
      {%- if pf_state == 'tier1' -%}
        🚚 {% if vi %}Mua thêm <b>{{ pf_rem | money }}</b> để được <strong>giảm 10€ phí ship</strong>{% else %}Add <b>{{ pf_rem | money }}</b> for <strong>−10€ shipping</strong>{% endif %}
      {%- elsif pf_state == 'tier2' -%}
        ✅ {% if vi %}Đã giảm 10€ ship · mua thêm <b>{{ pf_rem | money }}</b> để <strong>giảm 15€</strong>{% else %}−10€ unlocked · add <b>{{ pf_rem | money }}</b> for <strong>−15€</strong>{% endif %}
      {%- else -%}
        🎉 {% if vi %}Đã đạt <strong>giảm 15€ phí ship</strong> — ưu đãi cao nhất!{% else %}You've unlocked <strong>−15€ shipping</strong> — the best tier!{% endif %}
      {%- endif -%}
    </p>
    <div class="pf-shipbar__track"><div class="pf-shipbar__fill" style="width: {{ pf_pct }}%;"></div></div>
  </div>

  <style>
    .pf-shipbar { background: #fbf7ee; border: 1px solid #ecdfc4; border-radius: 12px; padding: .9rem 1.1rem; margin: 1rem 0; }
    .pf-shipbar__line { margin: 0 0 .6rem; font-size: 1.3rem; line-height: 1.4; font-weight: 600; color: #6a5c40; }
    .pf-shipbar__line b { color: #d62828; font-weight: 800; }
    .pf-shipbar__line strong { color: #b8791a; font-weight: 800; }
    .pf-shipbar__track { height: 7px; border-radius: 999px; background: #ece3d0; overflow: hidden; }
    .pf-shipbar__fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #1e8541, #63c98a); transition: width .35s ease; }
    .pf-shipbar--max { background: #eef7f0; border-color: #bfe0c7; }
    .pf-shipbar--max .pf-shipbar__line { color: #14672f; }
    .pf-shipbar--max .pf-shipbar__line strong { color: #1e8541; }
    .pf-shipbar--max .pf-shipbar__fill { background: linear-gradient(90deg, #1e8541, #14672f); }
    @media (max-width: 749px) {
      .pf-shipbar { padding: .8rem 1rem; margin: .8rem 0; border-radius: 10px; }
      .pf-shipbar__line { font-size: 1.25rem; margin-bottom: .5rem; }
    }
  </style>
{%- endunless -%}
