{%- comment -%}
  PHOMIFOOD — Thanh tiến độ ưu đãi giỏ hàng (1 mốc duy nhất: 169€).
  Mua thêm X để đạt 169€ → hưởng ưu đãi (Freeship / giảm 10%).
  Dùng chung cho trang giỏ hàng và giỏ hàng drawer; nằm trong vùng js-contents
  nên tự cập nhật ngay khi số lượng / giỏ thay đổi.
{%- endcomment -%}
{%- unless cart == empty -%}
  {%- assign pf_goal = 16900 -%}
  {%- assign pf_sub = cart.total_price -%}
  {%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
  {%- if pf_sub >= pf_goal -%}
    {%- assign pf_pct = 100 -%}{%- assign pf_reached = true -%}
  {%- else -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_goal -%}
    {%- assign pf_rem = pf_goal | minus: pf_sub -%}{%- assign pf_reached = false -%}
  {%- endif -%}

  <div class="pf-shipbar{% if pf_reached %} pf-shipbar--max{% endif %}">
    <div class="pf-shipbar__head">
      🚚 <span>{% if vi %}Ưu đãi đơn hàng{% else %}Order reward{% endif %}</span>
    </div>
    <div class="pf-shipbar__track"><span class="pf-shipbar__fill" style="width: {{ pf_pct }}%;"></span></div>
    <p class="pf-shipbar__status">
      {%- if pf_reached -%}
        🎉 {% if vi %}Đơn của bạn đã đạt <b>169€</b> — được <b>Freeship / giảm 10%</b>!{% else %}Your order reached <b>169€</b> — enjoy <b>free shipping / 10% off</b>!{% endif %}
      {%- else -%}
        {% if vi %}Mua thêm <b>{{ pf_rem | money }}</b> để đạt <b>169€</b> — hưởng <b>Freeship / giảm 10%</b>{% else %}Add <b>{{ pf_rem | money }}</b> to reach <b>169€</b> — get <b>free shipping / 10% off</b>{% endif %}
      {%- endif -%}
    </p>
  </div>

  <style>
    .pf-shipbar{ background:#fbf7ee; border:1px solid #ecdfc4; border-radius:12px; padding:.9rem 1.1rem; margin:1rem 0; }
    .pf-shipbar__head{ display:flex; align-items:center; gap:.4rem; font-size:1.3rem; font-weight:800; color:#6a5c40; }
    .pf-shipbar__track{ height:9px; border-radius:999px; background:#ece3d0; overflow:hidden; margin:.6rem 0 0; }
    .pf-shipbar__fill{ display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#1e8541,#63c98a); transition:width .35s ease; }
    .pf-shipbar__status{ margin:.55rem 0 0; font-size:1.25rem; font-weight:600; color:#8a7b5c; line-height:1.4; }
    .pf-shipbar__status b{ color:#d62828; font-weight:800; }
    .pf-shipbar--max{ background:#eef7f0; border-color:#bfe0c7; }
    .pf-shipbar--max .pf-shipbar__head{ color:#14672f; }
    .pf-shipbar--max .pf-shipbar__fill{ background:linear-gradient(90deg,#1e8541,#14672f); }
    .pf-shipbar--max .pf-shipbar__status b{ color:#14672f; }
  </style>
{%- endunless -%}
