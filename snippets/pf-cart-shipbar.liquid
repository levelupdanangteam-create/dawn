{%- comment -%}
  Cart reward progress (compact — shows only the NEXT milestone).
  Milestones (chỉ áp dụng 1 ưu đãi cao nhất, KHÔNG cộng dồn):
    50€ → tặng 1 sản phẩm bất kỳ · 100€ → −5€ ship · 169€ → −10€ ship · 269€ → −15€ ship.
  Re-renders with the cart on change.
{%- endcomment -%}
{%- unless cart == empty -%}
  {%- assign pf_gift = 5000 -%}{%- comment -%}50€{%- endcomment -%}
  {%- assign pf_t5 = 10000 -%}{%- comment -%}100€{%- endcomment -%}
  {%- assign pf_t1 = 16900 -%}{%- comment -%}169€{%- endcomment -%}
  {%- assign pf_t2 = 26900 -%}{%- comment -%}269€{%- endcomment -%}
  {%- assign pf_sub = cart.total_price -%}
  {%- assign vi = false -%}{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}

  {%- comment -%}Pick the current target = next unmet milestone.{%- endcomment -%}
  {%- if pf_sub < pf_gift -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_gift -%}
    {%- assign pf_rem = pf_gift | minus: pf_sub -%}
    {%- assign pf_state = 'gift' -%}
  {%- elsif pf_sub < pf_t5 -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_t5 -%}
    {%- assign pf_rem = pf_t5 | minus: pf_sub -%}
    {%- assign pf_state = 'tier5' -%}
  {%- elsif pf_sub < pf_t1 -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_t1 -%}
    {%- assign pf_rem = pf_t1 | minus: pf_sub -%}
    {%- assign pf_state = 'tier1' -%}
  {%- elsif pf_sub < pf_t2 -%}
    {%- assign pf_pct = pf_sub | times: 100 | divided_by: pf_t2 -%}
    {%- assign pf_rem = pf_t2 | minus: pf_sub -%}
    {%- assign pf_state = 'tier2' -%}
  {%- else -%}
    {%- assign pf_pct = 100 -%}
    {%- assign pf_state = 'max' -%}
  {%- endif -%}

  <div class="pf-shipbar pf-shipbar--{{ pf_state }}">
    <p class="pf-shipbar__line">
      {%- if pf_state == 'gift' -%}
        🎁 {% if vi %}Mua thêm <b>{{ pf_rem | money }}</b> để được <strong>TẶNG 1 sản phẩm bất kỳ</strong>!{% else %}Add <b>{{ pf_rem | money }}</b> to get <strong>1 FREE product of your choice</strong>!{% endif %}
      {%- elsif pf_state == 'tier5' -%}
        🎁 {% if vi %}Đơn của bạn được <strong>tặng 1 sản phẩm</strong> · thêm <b>{{ pf_rem | money }}</b> để lên <strong>giảm 5€ ship</strong>{% else %}You get a <strong>free gift</strong> · add <b>{{ pf_rem | money }}</b> to upgrade to <strong>−5€ shipping</strong>{% endif %}
      {%- elsif pf_state == 'tier1' -%}
        🚚 {% if vi %}Đơn của bạn được <strong>giảm 5€ ship</strong> · thêm <b>{{ pf_rem | money }}</b> để lên <strong>giảm 10€</strong>{% else %}You get <strong>−5€ shipping</strong> · add <b>{{ pf_rem | money }}</b> to upgrade to <strong>−10€</strong>{% endif %}
      {%- elsif pf_state == 'tier2' -%}
        🚚 {% if vi %}Đơn của bạn được <strong>giảm 10€ ship</strong> · thêm <b>{{ pf_rem | money }}</b> để lên <strong>giảm 15€</strong>{% else %}You get <strong>−10€ shipping</strong> · add <b>{{ pf_rem | money }}</b> to upgrade to <strong>−15€</strong>{% endif %}
      {%- else -%}
        🎉 {% if vi %}Đơn của bạn được <strong>giảm 15€ phí ship</strong> — ưu đãi cao nhất!{% else %}You get <strong>−15€ shipping</strong> — the best tier!{% endif %}
      {%- endif -%}
    </p>
    <div class="pf-shipbar__track"><div class="pf-shipbar__fill" style="width: {{ pf_pct }}%;"></div></div>
    <p class="pf-shipbar__note">{% if vi %}* Mỗi đơn chỉ áp dụng 1 ưu đãi cao nhất, không cộng dồn.{% else %}* One best reward per order — offers don't stack.{% endif %}</p>
  </div>

  <style>
    .pf-shipbar { background: #fbf7ee; border: 1px solid #ecdfc4; border-radius: 12px; padding: .9rem 1.1rem; margin: 1rem 0; }
    .pf-shipbar__line { margin: 0 0 .6rem; font-size: 1.3rem; line-height: 1.4; font-weight: 600; color: #6a5c40; }
    .pf-shipbar__line b { color: #d62828; font-weight: 800; }
    .pf-shipbar__line strong { color: #b8791a; font-weight: 800; }
    .pf-shipbar__track { height: 7px; border-radius: 999px; background: #ece3d0; overflow: hidden; }
    .pf-shipbar__fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #1e8541, #63c98a); transition: width .35s ease; }
    .pf-shipbar__note { margin: .5rem 0 0; font-size: 1.05rem; line-height: 1.35; color: #a8a08e; font-weight: 500; }
    /* Gift tier (first milestone) — warm accent to draw attention */
    .pf-shipbar--gift { background: #fef4ef; border-color: #f4d2bf; }
    .pf-shipbar--gift .pf-shipbar__line { color: #a4442a; }
    .pf-shipbar--gift .pf-shipbar__line strong { color: #d62828; }
    .pf-shipbar--gift .pf-shipbar__fill { background: linear-gradient(90deg, #e8602f, #f2a65a); }
    .pf-shipbar--tier5 .pf-shipbar__line strong { color: #b8791a; }
    .pf-shipbar--tier1 .pf-shipbar__line strong { color: #b8791a; }
    .pf-shipbar--max { background: #eef7f0; border-color: #bfe0c7; }
    .pf-shipbar--max .pf-shipbar__line { color: #14672f; }
    .pf-shipbar--max .pf-shipbar__line strong { color: #1e8541; }
    .pf-shipbar--max .pf-shipbar__fill { background: linear-gradient(90deg, #1e8541, #14672f); }
    @media (max-width: 749px) {
      .pf-shipbar { padding: .8rem 1rem; margin: .8rem 0; border-radius: 10px; }
      .pf-shipbar__line { font-size: 1.25rem; margin-bottom: .5rem; }
    }
  </style>
{%- endunless -%}
