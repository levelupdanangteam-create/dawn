{%- comment -%}
  Banner "Thanh toán trong 5 phút nhận quà" + đồng hồ đếm ngược, đặt ở giỏ hàng (trên nút Thanh toán).
  Đếm ngược 5:00, lưu mốc theo trình duyệt nên không reset khi chuyển trang; hết giờ tự làm mới để luôn còn ưu đãi.
{%- endcomment -%}
<div class="pf-cd" role="note">
  <span class="pf-cd__gift" aria-hidden="true">🎁</span>
  <div class="pf-cd__txt">
    {%- if request.locale.iso_code == 'vi' -%}
      <b>Thanh toán trong <span class="pf-cd__time">05:00</span> — nhận ngay một phần quà!</b>
      <span>Hoàn tất đặt hàng sớm để được tặng quà kèm đơn 🎉</span>
    {%- else -%}
      <b>Checkout within <span class="pf-cd__time">05:00</span> to get a free gift!</b>
      <span>Complete your order soon to receive a gift with your parcel 🎉</span>
    {%- endif -%}
  </div>
</div>
<style>
  .pf-cd{
    display:flex; align-items:center; gap:1.1rem;
    margin:1.4rem 0; padding:1.3rem 1.4rem; border-radius:16px; position:relative;
    background:linear-gradient(135deg,#fff0cf 0%,#ffd7a1 55%,#ffc27a 100%);
    border:2px solid #f0b23e; box-shadow:0 8px 20px rgba(214,120,20,.22);
    animation:pf-cd-glow 1.8s ease-in-out infinite;
  }
  @keyframes pf-cd-glow{ 0%,100%{box-shadow:0 8px 20px rgba(214,120,20,.20)} 50%{box-shadow:0 10px 28px rgba(214,120,20,.44)} }
  .pf-cd__gift{ font-size:3rem; line-height:1; flex-shrink:0; animation:pf-cd-wob 1.4s ease-in-out infinite; }
  @keyframes pf-cd-wob{ 0%,100%{transform:rotate(-10deg) scale(1)} 50%{transform:rotate(10deg) scale(1.18)} }
  .pf-cd__txt{ display:flex; flex-direction:column; gap:.3rem; line-height:1.4; }
  .pf-cd__txt b{ font-size:1.7rem; font-weight:800; color:#c62828; }
  .pf-cd__txt span{ font-size:1.3rem; color:#7a4a12; font-weight:600; }
  .pf-cd__time{
    display:inline-block; min-width:6rem; text-align:center; font-size:1.95rem; vertical-align:-2px;
    background:linear-gradient(180deg,#e53935,#c62828); color:#fff; font-weight:900; letter-spacing:.06em;
    padding:.1rem .8rem; border-radius:9px; font-variant-numeric:tabular-nums;
    box-shadow:0 3px 8px rgba(198,40,40,.45); animation:pf-cd-pulse 1s ease-in-out infinite;
  }
  @keyframes pf-cd-pulse{ 0%,100%{transform:scale(1)} 50%{transform:scale(1.07)} }
  @media (max-width:749px){
    .pf-cd__gift{font-size:2.5rem}
    .pf-cd__txt b{font-size:1.5rem} .pf-cd__txt span{font-size:1.25rem}
    .pf-cd__time{font-size:1.7rem; min-width:5.4rem}
  }
</style>
<script>
  (function(){
    if (window.__pfCd) return; window.__pfCd = true;
    var KEY='pfCheckoutDeadline', DUR=5*60*1000;
    function getDeadline(){
      try{
        var d=parseInt(localStorage.getItem(KEY),10), n=Date.now();
        if(!d || isNaN(d) || d-n<=0 || d-n>DUR){ d=n+DUR; localStorage.setItem(KEY,String(d)); }
        return d;
      }catch(e){ return Date.now()+DUR; }
    }
    var dl=getDeadline();
    function tick(){
      var left=dl-Date.now();
      if(left<=0){ dl=Date.now()+DUR; try{localStorage.setItem(KEY,String(dl));}catch(e){} left=DUR; }
      var m=Math.floor(left/60000), s=Math.floor((left%60000)/1000);
      var txt=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
      var els=document.querySelectorAll('.pf-cd__time');
      for(var i=0;i<els.length;i++){ els[i].textContent=txt; }
    }
    tick(); setInterval(tick,1000);
  })();
</script>
