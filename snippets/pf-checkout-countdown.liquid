{%- comment -%}
  Khối ưu đãi (đặt ở nút "Thêm vào giỏ" trang sản phẩm + trong giỏ hàng):
  báo đang có ưu đãi GIẢM GIÁ tự động áp dụng, kèm đồng hồ đếm ngược + số suất
  còn lại để tạo cảm giác gấp. KHÔNG cần nhập mã (giảm giá tự động).
  - Đồng hồ 5:00 lưu theo trình duyệt, hết giờ tự làm mới.
  - Số suất giảm dần theo thời gian trong phiên (urgency), có mức sàn.
{%- endcomment -%}
<div class="pf-cd" role="note">
  <span class="pf-cd__gift" aria-hidden="true">🏷️</span>
  <div class="pf-cd__txt">
    {%- if request.locale.iso_code == 'vi' -%}
      <b>Nhập mã <button type="button" class="pf-cd__code" id="pf-cd-code" data-code="GIAMGIA" title="Bấm để sao chép">GIAMGIA<span class="pf-cd__copyic" aria-hidden="true">⧉</span></button> vào ô “Mã giảm giá” để được giảm!</b>
      <div class="pf-cd__meta">
        <span class="pf-cd__chip pf-cd__chip--time">⏳ Còn <span class="pf-cd__time">05:00</span></span>
        <span class="pf-cd__chip pf-cd__chip--slot">🔥 Chỉ còn <b class="pf-cd__slot">—</b> suất</span>
      </div>
      <span>Bấm để sao chép mã, dán vào ô “Mã giảm giá” ở bước thanh toán — ưu đãi có hạn 🎉</span>
    {%- else -%}
      <b>Enter code <button type="button" class="pf-cd__code" id="pf-cd-code" data-code="GIAMGIA" title="Click to copy">GIAMGIA<span class="pf-cd__copyic" aria-hidden="true">⧉</span></button> in the “Discount code” field to save!</b>
      <div class="pf-cd__meta">
        <span class="pf-cd__chip pf-cd__chip--time">⏳ <span class="pf-cd__time">05:00</span> left</span>
        <span class="pf-cd__chip pf-cd__chip--slot">🔥 Only <b class="pf-cd__slot">—</b> left</span>
      </div>
      <span>Tap to copy the code, paste it in the “Discount code” field at checkout — limited-time offer 🎉</span>
    {%- endif -%}
  </div>
</div>
<style>
  .pf-cd{
    display:flex; align-items:center; gap:1.1rem;
    margin:1.4rem 0; padding:1.3rem 1.4rem; border-radius:16px; position:relative;
    background:linear-gradient(135deg,#fff0cf 0%,#ffd7a1 55%,#ffc27a 100%);
    border:2px solid #f0b23e; box-shadow:0 8px 20px rgba(214,120,20,.22);
    animation:pf-cd-glow 1.8s ease-in-out infinite;
  }
  @keyframes pf-cd-glow{ 0%,100%{box-shadow:0 8px 20px rgba(214,120,20,.20)} 50%{box-shadow:0 10px 28px rgba(214,120,20,.44)} }
  .pf-cd__gift{ font-size:3rem; line-height:1; flex-shrink:0; animation:pf-cd-wob 1.4s ease-in-out infinite; }
  @keyframes pf-cd-wob{ 0%,100%{transform:rotate(-10deg) scale(1)} 50%{transform:rotate(10deg) scale(1.18)} }
  .pf-cd__txt{ display:flex; flex-direction:column; gap:.45rem; line-height:1.4; min-width:0; }
  .pf-cd__txt b{ font-size:1.6rem; font-weight:800; color:#c62828; }
  .pf-cd__txt span{ font-size:1.3rem; color:#7a4a12; font-weight:600; }
  .pf-cd__badge{ display:inline-block; background:#d62828; color:#fff; font-weight:900;
    font-size:1.35rem; letter-spacing:.04em; padding:.05rem .55rem; border-radius:7px; vertical-align:-1px; }
  /* (không dùng) mã ưu đãi bấm để sao chép */
  .pf-cd__code{
    display:inline-flex; align-items:center; gap:.4rem; vertical-align:-1px;
    background:#fff; color:#c62828; border:2px dashed #d62828; border-radius:8px;
    font:inherit; font-weight:900; font-size:1.55rem; letter-spacing:.12em;
    padding:.1rem .7rem; margin:0 .1rem; cursor:pointer; transition:background .15s ease,transform .1s ease;
  }
  .pf-cd__code:hover{ background:#fff3f3; }
  .pf-cd__code:active{ transform:scale(.97); }
  .pf-cd__code.copied{ background:#1e8541; color:#fff; border-color:#1e8541; }
  .pf-cd__copyic{ font-size:1.25rem; opacity:.8; }
  /* Chip đồng hồ + suất */
  .pf-cd__meta{ display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
  .pf-cd__chip{ display:inline-flex; align-items:center; gap:.35rem; font-size:1.25rem; font-weight:800;
    padding:.25rem .7rem; border-radius:999px; line-height:1.2; }
  .pf-cd__chip--time{ background:#fdecec; color:#b71c1c; border:1px solid #f4c3c3; }
  .pf-cd__chip--slot{ background:#fff3d9; color:#a86a12; border:1px solid #f0d9a8; }
  .pf-cd__chip--slot .pf-cd__slot{ color:#c62828; }
  .pf-cd__time, .pf-cd__chip .pf-cd__time{
    display:inline-block; min-width:5.2rem; text-align:center; font-size:1.5rem; vertical-align:-1px;
    background:#b71c1c; color:#fff; font-weight:900; letter-spacing:.06em;
    padding:.05rem .55rem; border-radius:7px; font-variant-numeric:tabular-nums;
    box-shadow:0 2px 6px rgba(140,20,20,.4); animation:pf-cd-pulse 1s ease-in-out infinite;
  }
  @keyframes pf-cd-pulse{ 0%,100%{transform:scale(1)} 50%{transform:scale(1.06)} }
  @media (max-width:749px){
    .pf-cd__gift{font-size:2.5rem}
    .pf-cd__txt b{font-size:1.45rem} .pf-cd__txt span{font-size:1.2rem}
    .pf-cd__code{font-size:1.4rem} .pf-cd__time{font-size:1.35rem; min-width:4.6rem}
    .pf-cd__chip{font-size:1.15rem}
  }
</style>
<script>
  (function(){
    if (window.__pfCd) return; window.__pfCd = true;
    var KEY='pfCheckoutDeadline', DUR=5*60*1000;
    function getDeadline(){
      try{
        var d=parseInt(localStorage.getItem(KEY),10), n=Date.now();
        if(!d || isNaN(d) || d-n<=0 || d-n>DUR){ d=n+DUR; localStorage.setItem(KEY,String(d)); }
        return d;
      }catch(e){ return Date.now()+DUR; }
    }
    // Số suất còn lại: khởi tạo 9–15 mỗi khách, giảm 1 mỗi ~4 phút, sàn 3.
    function getSlots(){
      try{
        var K='pfPromoSlots', raw=localStorage.getItem(K), o=raw?JSON.parse(raw):null, now=Date.now();
        if(!o || !o.t || !o.n){ o={ n: 9 + Math.floor(Math.random()*7), t: now }; localStorage.setItem(K, JSON.stringify(o)); }
        var dec=Math.floor((now-o.t)/(4*60*1000));
        return Math.max(3, o.n - dec);
      }catch(e){ return 7; }
    }
    var dl=getDeadline();
    function tick(){
      var left=dl-Date.now();
      if(left<=0){ dl=Date.now()+DUR; try{localStorage.setItem(KEY,String(dl));}catch(e){} left=DUR; }
      var m=Math.floor(left/60000), s=Math.floor((left%60000)/1000);
      var txt=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
      var els=document.querySelectorAll('.pf-cd__time');
      for(var i=0;i<els.length;i++){ els[i].textContent=txt; }
      var sl=getSlots(), sels=document.querySelectorAll('.pf-cd__slot');
      for(var j=0;j<sels.length;j++){ sels[j].textContent=sl; }
    }
    tick(); setInterval(tick,1000);

    // Sao chép mã khi bấm
    document.addEventListener('click', function(e){
      var b=e.target.closest ? e.target.closest('.pf-cd__code') : null;
      if(!b) return;
      var code=b.getAttribute('data-code')||'GIAMGIA';
      try{ if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(code); } }catch(err){}
      var vi=('{{ request.locale.iso_code }}'==='vi');
      var orig=b.getAttribute('data-orig'); if(!orig){ orig=b.innerHTML; b.setAttribute('data-orig',orig); }
      b.classList.add('copied');
      b.textContent = (vi ? '✓ Đã sao chép' : '✓ Copied');
      setTimeout(function(){ b.classList.remove('copied'); b.innerHTML=orig; }, 1800);
    });
  })();
</script>
