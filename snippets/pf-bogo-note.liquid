{%- comment -%}
  17/11: dòng nhắc "Mua 1 tặng 1" dưới sản phẩm trong giỏ (trang giỏ + giỏ trượt).
  Áp cho variant có metafield custom.mua_1_tang_1 = true (cùng variant mà discount 1+1 tự động trừ, mỗi đơn tối đa 1 lần).
  SL 1 → nhắc thêm 1 + nút "+1" (bấm nút + của chính dòng đó). SL ≥ 2 → báo đã được tặng.
  Dùng: render 'pf-bogo-note', line: item
{%- endcomment -%}
{%- if line.variant.metafields.custom.mua_1_tang_1 == true -%}
  {%- assign vi = true -%}{%- if request.locale.iso_code != 'vi' -%}{%- assign vi = false -%}{%- endif -%}
  {%- if line.quantity < 2 -%}
    <p class="pf-bogo-note">🎁 {% if vi %}Thêm 1 để được <b>tặng 1</b> (Mua 1 tặng 1){% else %}Add 1 more to get <b>1 free</b> (Buy 1 get 1){% endif %}
      <button type="button" class="pf-bogo-note__add" data-pf-bogo-add>{% if vi %}+ Thêm 1{% else %}+ Add 1{% endif %}</button></p>
  {%- else -%}
    <p class="pf-bogo-note pf-bogo-note--ok">✓ {% if vi %}Đã được <b>tặng 1</b> (Mua 1 tặng 1){% else %}<b>1 free</b> applied (Buy 1 get 1){% endif %}</p>
  {%- endif -%}
{%- endif -%}
{%- unless pf_bogo_note_css -%}
<style>
  .pf-bogo-note { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .8rem; margin: .5rem 0 0; padding: .45rem .9rem; border-radius: 8px; background: #fff3d6; color: #8a4b00; font-size: 1.25rem; line-height: 1.35; width: fit-content; max-width: 100%; }
  .pf-bogo-note b { font-weight: 800; color: #c0261f; }
  .pf-bogo-note--ok { background: #e7f5ec; color: #14672f; }
  .pf-bogo-note--ok b { color: #14672f; }
  .pf-bogo-note__add { border: 0; border-radius: 999px; padding: .25rem .9rem; background: #ffc61a; color: #14672f; font: inherit; font-weight: 800; cursor: pointer; }
  .pf-bogo-note__add:hover { background: #f5b400; }
</style>
<script>
  (function () {
    if (window.__pfBogoNote) return; window.__pfBogoNote = true;
    // "+ Thêm 1": bấm nút + của ô số lượng cùng dòng (giỏ của Dawn tự cập nhật, discount 1+1 tự trừ)
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-pf-bogo-add]');
      if (!b) return;
      var row = b.closest('.cart-item, tr');
      var plus = row && row.querySelector('quantity-input button[name="plus"], .quantity__button[name="plus"]');
      if (plus) { b.disabled = true; plus.click(); }
    });
  })();
</script>
{%- endunless -%}
