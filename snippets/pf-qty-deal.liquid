{%- comment -%}
  "Buy 50+ items → 10% off" store-wide quantity deal banner (product page).
  The actual discount is an automatic Shopify discount (min 50 items → 10%).
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
<div class="pf-qd">
  <span class="pf-qd__ico" aria-hidden="true">🎁</span>
  <div class="pf-qd__body">
    <p class="pf-qd__t">{% if vi %}Mua sỉ tiết kiệm{% else %}Bulk deal{% endif %}</p>
    <p class="pf-qd__d">{% if vi %}Mua từ <b>50 sản phẩm</b> (mix mọi mặt hàng) — <b>giảm ngay 10%</b> toàn đơn!{% else %}Buy <b>50+ items</b> (mix any products) — get <b>10% off</b> your whole order!{% endif %}</p>
  </div>
  <span class="pf-qd__tag">−10%</span>
</div>

<style>
  .pf-qd {
    display: flex; align-items: center; gap: 1.1rem; margin: 1.6rem 0 0;
    background: linear-gradient(90deg, #fff1e0, #ffe6e6);
    border: 1px solid #f2b8a0; border-left: 5px solid #d62828; border-radius: 14px; padding: 1.3rem 1.5rem;
  }
  .pf-qd__ico { flex: none; width: 3.6rem; height: 3.6rem; border-radius: 10px; background: #d62828; color: #fff; display: grid; place-items: center; font-size: 1.8rem; }
  .pf-qd__body { flex: 1; min-width: 0; }
  .pf-qd__t { margin: 0 0 .2rem; font-size: 1.5rem; font-weight: 800; color: #b8341f; }
  .pf-qd__d { margin: 0; font-size: 1.35rem; line-height: 1.5; color: #7a4a3a; }
  .pf-qd__d b { color: #d62828; font-weight: 800; }
  .pf-qd__tag { flex: none; background: #d62828; color: #fff; font-weight: 900; font-size: 1.6rem; padding: .5rem 1rem; border-radius: 999px; }
  @media (max-width: 599px) { .pf-qd__tag { display: none; } }
</style>
