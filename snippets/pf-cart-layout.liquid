{%- comment -%}
  Bố cục trang giỏ hàng (giống phomifood.com/cart):
  - Máy tính (≥ 1200px): 2 cột — trái = thẻ trắng chứa bảng sản phẩm (ảnh | tên + giá + quy cách + cân | số lượng + thùng rác | thành tiền);
    phải = khung "Tóm tắt đơn hàng" (mã giảm giá, phí ship theo nước, tổng tiền, ghi chú, thanh toán). Gợi ý SP trải ngang bên dưới.
  - 750–1199px: bảng full ngang, khung tóm tắt bên dưới dạt phải. Điện thoại: xếp dọc. Chỉ CSS, render trong main-cart-items.
{%- endcomment -%}
<style>
  /* ===== Bảng sản phẩm ===== */
  #main-cart-items .cart-items { border-collapse: collapse; }
  #main-cart-items .cart-items thead th { padding-bottom: 1.4rem; border-bottom: 1px solid #d9d4ca; font-size: 1.5rem; font-weight: 800; letter-spacing: 0; text-transform: none; color: #2a2622; }
  #main-cart-items .cart-item > td { padding-top: 2.4rem; padding-bottom: 2.4rem; vertical-align: middle; }
  #main-cart-items .cart-item { border-bottom: 1px solid #e6e1d7; }
  #main-cart-items .cart-item__name { font-size: 1.7rem; font-weight: 700; color: #2a2622; text-decoration: none; }
  #main-cart-items .cart-item__name:hover { color: #1e8541; }
  #main-cart-items .cart-item__image-container { border-radius: 12px; overflow: hidden; background: #fff; }
  #main-cart-items .cart-quantity { background: #f1f3f5; border-radius: 12px; min-height: 5rem; }
  #main-cart-items .cart-quantity::before, #main-cart-items .cart-quantity::after { display: none; }
  #main-cart-items .cart-quantity .quantity__input { background: transparent; font-weight: 700; font-size: 1.6rem; }
  #main-cart-items .cart-quantity .quantity__button { background: transparent; color: #4a443c; }
  #main-cart-items cart-remove-button .button { color: #8a8273; }
  #main-cart-items cart-remove-button .button:hover { color: #c0392b; }
  #main-cart-items .cart-item__totals .price { font-size: 1.8rem; font-weight: 800; color: #2a2622; }

  /* Ô tick nằm riêng bên trái ảnh, không đè lên ảnh */
  #MainContent[data-template='cart'] #main-cart-items .cart-item__media { position: relative; padding-left: 3.4rem; }
  #MainContent[data-template='cart'] #main-cart-items .cart-item__media .pf-cart-check {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%); margin: 0;
    box-shadow: none; background: none; border-radius: 0;
  }

  /* ===== Điện thoại: mỗi SP là 1 khối gọn — ô tick góc trên | ảnh nhỏ | tên + giá + quy cách | thành tiền,
     hàng dưới: ô số lượng + thùng rác ===== */
  @media screen and (max-width: 749px) {
    #MainContent[data-template='cart'] #main-cart-items .cart-items thead tr { margin-bottom: 0; }
    #MainContent[data-template='cart'] .pf-cartbulk { flex-wrap: nowrap; padding: .8rem 1.2rem; }
    #MainContent[data-template='cart'] .pf-cartbulk__all { font-size: 1.35rem; white-space: nowrap; }
    #MainContent[data-template='cart'] .pf-cartbulk__del { font-size: 1.25rem; padding: .5rem 1.1rem; border-width: 1.5px; white-space: nowrap; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item {
      grid-template-columns: 9.6rem minmax(0, 1fr) auto; grid-template-rows: auto auto;
      column-gap: 1.2rem; row-gap: 1rem; align-items: start;
      margin: 0; padding: 1.6rem 0;
    }
    #MainContent[data-template='cart'] #main-cart-items .cart-item > td { padding: 0; vertical-align: top; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item > td.cart-item__media {
      grid-column: 1; grid-row: 1 / 3; width: auto; padding-left: 3rem;
    }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__media .pf-cart-check {
      top: .2rem; left: 0; transform: none; width: 2rem; height: 2rem;
    }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__image-container { border-radius: 10px; border: 1px solid #efe8dc; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__image { width: 100%; max-width: 6.6rem; height: auto; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details { grid-column: 2; grid-row: 1; min-width: 0; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details > * + * { margin-top: .3rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__name {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      font-size: 1.4rem; line-height: 1.35;
    }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details .product-option,
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details dl { font-size: 1.25rem; line-height: 1.4; color: #6a6255; margin-top: .2rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details dl .product-option { display: flex; flex-wrap: wrap; gap: .3rem; margin: 0; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details dl dt,
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details dl dd { margin: 0; display: inline; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details .discounts:empty { display: none; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__details .pf-cw { margin-top: .2rem; font-size: 1.15rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__totals { grid-column: 3; grid-row: 1; justify-content: flex-end; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__totals .price { font-size: 1.5rem; white-space: nowrap; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__quantity { grid-column: 2 / 4; grid-row: 2; }
    #MainContent[data-template='cart'] #main-cart-items .cart-item__quantity-wrapper { flex-wrap: nowrap; align-items: center; gap: .8rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-quantity { width: 11rem; min-height: 3.6rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-quantity .quantity__button { width: 3.4rem; }
    #MainContent[data-template='cart'] #main-cart-items .cart-quantity .quantity__input { font-size: 1.45rem; }
    #MainContent[data-template='cart'] #main-cart-items cart-remove-button { margin: 0; }
    #MainContent[data-template='cart'] #main-cart-items cart-remove-button .button { min-width: 3.6rem; min-height: 3.6rem; padding: 0; }
  }

  @media screen and (min-width: 990px) {
    #main-cart-items .cart-item__media { width: 17.4rem; }
    #main-cart-items .cart-item__image { max-width: 12rem; }
    #main-cart-items .cart-item__details { padding-left: 2.4rem; }
  }

  /* ===== Khung "Tóm tắt đơn hàng" ===== */
  #MainContent[data-template='cart'] #main-cart-footer .cart__footer {
    display: block; background: transparent; border: 0; box-shadow: none; padding-left: 0; padding-right: 0; border-radius: 0;
  }
  /* Dawn đặt width 35rem + margin cho các cột của .cart__footer → bỏ để khung chiếm đủ chiều ngang */
  #MainContent[data-template='cart'] #main-cart-footer .cart__footer > * { margin: 0; width: 100%; }
  #MainContent[data-template='cart'] #main-cart-footer .cart__blocks.pf-sum {
    box-sizing: border-box; width: 100%; background: #fff; border: 1px solid #ece3d4; border-radius: 18px;
    padding: clamp(2rem, 2.4vw, 2.8rem); box-shadow: 0 10px 28px rgba(120, 100, 70, .08);
  }
  #main-cart-footer .pf-sum__title { margin: 0 0 1.8rem; padding-bottom: 1.4rem; border-bottom: 1px solid #f0e8db; font-size: 2.2rem; font-weight: 900; color: #2a2622; }

  /* Mã giảm giá */
  .pf-disc { margin: 0 0 1.8rem; }
  .pf-disc__label { display: block; margin-bottom: .8rem; font-size: 1.5rem; font-weight: 800; color: #2a2622; }
  .pf-disc__row { display: flex; gap: 1rem; }
  .pf-disc__input { flex: 1; min-width: 0; height: 4.8rem; padding: 0 1.4rem; border: 1px solid #d9d4ca; border-radius: 10px; background: #fff; font: inherit; font-size: 1.45rem; }
  .pf-disc__input:focus { outline: 2px solid #1e8541; outline-offset: 0; border-color: #1e8541; }
  .pf-disc__btn { flex: none; height: 4.8rem; padding: 0 2.4rem; border: 0; border-radius: 10px; background: #1e8541; color: #fff; font: inherit; font-size: 1.5rem; font-weight: 800; cursor: pointer; }
  .pf-disc__btn:hover { background: #166a33; }

  /* Phí ship theo nước: ngăn cách với phần tổng tiền bên dưới */
  #main-cart-footer .pf-sum .pf-ship { padding-bottom: 1.8rem; margin-bottom: 1.8rem; border-bottom: 1px solid #f0e8db; }
  #main-cart-footer .pf-sum .pf-ship__lbl { font-size: 1.5rem; }
  #main-cart-footer .pf-sum .pf-ship__sel { height: 4.8rem; font-size: 1.45rem; }

  /* Ưu đãi đã áp dụng + bảng tổng */
  #main-cart-footer .pf-sum .pf-applied { margin: 0 0 1.4rem; }
  #main-cart-footer .pf-sum .pf-tot { margin: 0 0 1rem; font-size: 1.5rem; }
  #main-cart-footer .pf-sum .pf-tot__row { padding: .6rem 0; }
  #main-cart-footer .pf-sum .pf-tot__total { margin-top: 1rem; padding-top: 1.4rem; font-size: 1.9rem; }
  #main-cart-footer .pf-sum .pf-tot__total span:last-child { font-size: 2.8rem; }
  #main-cart-footer .tax-note { display: block; margin: 0 0 1.2rem; text-align: left; font-size: 1.2rem; color: #8a8273; }

  /* Ghi chú đơn hàng → lưu vào giỏ, hiện ở mục "Notes" của đơn trên Shopify */
  .pf-note { display: block; }
  .pf-note__input { display: block; width: 100%; box-sizing: border-box; min-height: 10rem; padding: 1.2rem 1.4rem; border: 1px solid #d9d4ca; border-radius: 10px; background: #fff; font: inherit; font-size: 1.45rem; line-height: 1.5; resize: vertical; }
  .pf-note__input:focus { outline: 2px solid #1e8541; outline-offset: 0; border-color: #1e8541; }

  /* Nút thanh toán full chiều ngang khung */
  #main-cart-footer .cart__ctas { margin-top: 1.4rem; }
  #MainContent[data-template='cart'] #main-cart-footer .cart__checkout-button.pf-checkout-btn { width: 100%; max-width: none; }

  /* Hộp "copy đơn hàng" nằm dưới nút thanh toán, trong khung tóm tắt (bỏ đường kẻ trái của bố cục cũ) */
  #MainContent[data-template='cart'] #main-cart-footer .pf-sum .pf-ordercopy {
    border: 1px solid #e3ece5; padding: 1.4rem 1.5rem 1.5rem; margin-top: 1.8rem;
  }

  /* ===== Máy tính bảng / laptop nhỏ (750–1199px): khung tóm tắt nằm dưới bảng, dạt phải ===== */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    #MainContent[data-template='cart'] #main-cart-footer .cart__footer > .cart__blocks.pf-sum { max-width: 56rem; margin-left: auto; }
  }

  /* ===== Máy tính (≥ 1200px): 2 cột — bảng sản phẩm bên trái, tóm tắt bên phải; gợi ý SP trải ngang bên dưới ===== */
  @media screen and (min-width: 1200px) {
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) {
      display: grid; grid-template-columns: minmax(0, 1fr) 40rem; column-gap: 3.2rem; align-items: start;
      box-sizing: border-box; max-width: var(--page-width, 120rem); margin-inline: auto; padding-inline: 5rem;
    }
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) > .shopify-section { grid-column: 1 / -1; min-width: 0; }
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) > .pf-cart-items-wrapper { grid-column: 1; grid-row: 1; }
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) > .cart__footer-wrapper { grid-column: 2; grid-row: 1; }
    /* Lưới đã giới hạn chiều rộng + lề → bỏ lề trùng của từng section */
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) .pf-cart-items-wrapper .page-width,
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) .cart__footer-wrapper .page-width { max-width: none; padding-inline: 0; }
    #MainContent[data-template='cart']:has(#main-cart-footer:not(.is-empty)) [id^='pfcr-'] .pfcr__wrap { padding-inline: 0; }
    /* Khung tóm tắt thẳng hàng với tiêu đề "Giỏ hàng" */
    #MainContent[data-template='cart'] #main-cart-footer .cart__footer { padding-top: 3.6rem; padding-bottom: 0; }

    /* Bảng sản phẩm gọn lại cho vừa cột trái: thu khoảng cách giữa các cột của Dawn (4–6rem) để tên SP có chỗ */
    #MainContent[data-template='cart'] .cart__items { padding: .8rem 2.4rem 1.2rem; }
    #MainContent[data-template='cart'] .pf-cartbulk { margin-top: 1.6rem; }
    #main-cart-items .cart-items th + th { padding-left: 1.6rem; }
    #main-cart-items .cart-items .cart-items__heading--wide,
    #main-cart-items .cart-item .cart-item__quantity { padding-left: 1.6rem; }
    #main-cart-items .cart-item > td + td { padding-left: 1.6rem; }
    #main-cart-items .cart-item__media { width: 13.4rem; }
    #main-cart-items .cart-item__image { max-width: 9.6rem; }
    #main-cart-items .cart-item__details { width: auto; padding-left: 1.6rem; }
    #main-cart-items .cart-item__name { font-size: 1.6rem; line-height: 1.35; }
    #main-cart-items .cart-item__quantity-wrapper { flex-wrap: nowrap; }
    #main-cart-items cart-remove-button { margin-left: .6rem; }
    #main-cart-items .cart-item__totals { white-space: nowrap; }
    #main-cart-items .pf-cw { white-space: nowrap; }
  }
</style>
