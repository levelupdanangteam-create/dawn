{%- comment -%}
  Bố cục trang giỏ hàng NGANG, toàn chiều rộng:
  - Bảng sản phẩm trải hết chiều ngang: ảnh lớn | tên + giá | ô số lượng + thùng rác | thành tiền.
  - Bên dưới chia 2 cột (≥ 750px): trái = mã giảm giá, cam kết, phí ship; phải = tóm tắt + nút thanh toán.
  Điện thoại: xếp dọc. Chỉ CSS, render trong main-cart-items.
{%- endcomment -%}
<style>
  /* ===== Bảng sản phẩm ===== */
  #main-cart-items .cart-items { border-collapse: collapse; }
  #main-cart-items .cart-items thead th { padding-bottom: 1.4rem; border-bottom: 1px solid #d9d4ca; font-size: 1.5rem; font-weight: 800; letter-spacing: 0; text-transform: none; color: #2a2622; }
  #main-cart-items .cart-item > td { padding-top: 2.4rem; padding-bottom: 2.4rem; vertical-align: middle; }
  #main-cart-items .cart-item { border-bottom: 1px solid #e6e1d7; }
  #main-cart-items .cart-item__name { font-size: 1.7rem; font-weight: 700; color: #2a2622; text-decoration: none; }
  #main-cart-items .cart-item__name:hover { color: #1e8541; }
  #main-cart-items .cart-item__image-container { border-radius: 12px; overflow: hidden; background: #fff; }
  #main-cart-items .cart-quantity { background: #f1f3f5; border-radius: 12px; min-height: 5rem; }
  #main-cart-items .cart-quantity::before, #main-cart-items .cart-quantity::after { display: none; }
  #main-cart-items .cart-quantity .quantity__input { background: transparent; font-weight: 700; font-size: 1.6rem; }
  #main-cart-items .cart-quantity .quantity__button { background: transparent; color: #4a443c; }
  #main-cart-items cart-remove-button .button { color: #8a8273; }
  #main-cart-items cart-remove-button .button:hover { color: #c0392b; }
  #main-cart-items .cart-item__totals .price { font-size: 1.8rem; font-weight: 800; color: #2a2622; }

  /* Ô tick nằm riêng bên trái ảnh, không đè lên ảnh */
  #MainContent[data-template='cart'] #main-cart-items .cart-item__media { position: relative; padding-left: 3.4rem; }
  #MainContent[data-template='cart'] #main-cart-items .cart-item__media .pf-cart-check {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%); margin: 0;
    box-shadow: none; background: none; border-radius: 0;
  }

  @media screen and (min-width: 990px) {
    #main-cart-items .cart-item__media { width: 17.4rem; }
    #main-cart-items .cart-item__image { max-width: 12rem; }
    #main-cart-items .cart-item__details { padding-left: 2.4rem; }
  }

  /* ===== Khu vực dưới bảng ===== */
  #main-cart-footer .cart__footer { display: block; }
  #main-cart-footer .cart__footer > * + * { margin-top: 2rem; }
  .pf-foot-left { display: flex; flex-direction: column; gap: 1.6rem; }
  .pf-disc__label { display: block; margin-bottom: .8rem; font-size: 1.6rem; font-weight: 800; color: #2a2622; }
  .pf-disc__row { display: flex; gap: 1rem; }
  .pf-disc__input { flex: 1; min-width: 0; height: 5rem; padding: 0 1.4rem; border: 1px solid #d9d4ca; border-radius: 10px; background: #fff; font: inherit; font-size: 1.5rem; }
  .pf-disc__input:focus { outline: 2px solid #1e8541; outline-offset: 0; border-color: #1e8541; }
  .pf-disc__btn { height: 5rem; padding: 0 2.6rem; border: 0; border-radius: 10px; background: #1e8541; color: #fff; font: inherit; font-size: 1.5rem; font-weight: 800; cursor: pointer; }
  .pf-disc__btn:hover { background: #166a33; }

  #main-cart-footer .cart__blocks { width: 100%; }
  #main-cart-footer .pf-sum { background: #fff; border: 1px solid #ece5d8; border-radius: 18px; padding: 2.2rem 2.2rem 2rem; box-shadow: 0 12px 30px rgba(20, 60, 30, .08); }
  #main-cart-footer .pf-sum__title { margin: 0 0 1.4rem; padding-bottom: 1.2rem; border-bottom: 1px solid #f0e8db; font-size: 2rem; font-weight: 900; color: #2a2622; }
  #main-cart-footer .totals { justify-content: space-between; margin: 1.2rem 0 .6rem; padding-top: 1.2rem; border-top: 1px dashed #e2d9c9; }
  #main-cart-footer .totals__total { font-size: 1.8rem; font-weight: 800; }
  #main-cart-footer .totals__total-value { font-size: 2.6rem; font-weight: 900; color: #1e8541; }
  #main-cart-footer .tax-note { display: block; margin: 0 0 1.2rem; text-align: left; font-size: 1.2rem; color: #8a8273; }
  #main-cart-footer .cart__ctas { margin-top: 1.2rem; }
  #main-cart-footer .cart__checkout-button { width: 100%; max-width: none; min-height: 5.4rem; border-radius: 999px; font-size: 1.6rem; font-weight: 800; }

  .pf-sum__trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .pf-sum__trust li { display: flex; flex-direction: column; align-items: center; gap: .3rem; padding: 1rem .4rem; border-radius: 12px; background: #fff; border: 1px solid #ece5d8; font-size: 1.2rem; font-weight: 700; color: #4a443c; text-align: center; line-height: 1.3; }
  .pf-sum__trust li span { font-size: 2rem; }
  .pf-sum__ship { border: 1px solid #ece5d8; border-radius: 14px; overflow: hidden; background: #fff; }
  .pf-sum__ship summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 1.6rem; font-size: 1.4rem; font-weight: 800; color: #2a2622; background: #fbf8f2; }
  .pf-sum__ship summary::-webkit-details-marker { display: none; }
  .pf-sum__ship summary::after { content: "+"; font-size: 1.8rem; color: #1e8541; line-height: 1; }
  .pf-sum__ship[open] summary::after { content: "–"; }
  .pf-sum__ship > div { padding: 1rem 1.2rem 1.2rem; }

  /* Ghi chú đơn hàng → lưu vào giỏ, hiện ở mục "Notes" của đơn trên Shopify */
  .pf-note { display: block; }
  .pf-note__input { display: block; width: 100%; box-sizing: border-box; min-height: 10rem; padding: 1.2rem 1.4rem; border: 1px solid #d9d4ca; border-radius: 10px; background: #fff; font: inherit; font-size: 1.45rem; line-height: 1.5; resize: vertical; }
  .pf-note__input:focus { outline: 2px solid #1e8541; outline-offset: 0; border-color: #1e8541; }

  /* Ghi đè thẻ trắng chung trong pf-brand.css: mỗi cột là một thẻ riêng, có khoảng cách */
  #MainContent[data-template='cart'] #main-cart-footer .cart__footer {
    display: flex; flex-direction: column; gap: 2rem;
    background: transparent; border: 0; box-shadow: none; padding: 0; border-radius: 0;
  }
  /* Dawn đặt margin-left: 4rem cho cột thứ 2 → đẩy thẻ đè lên khoảng cách; bỏ đi */
  #MainContent[data-template='cart'] #main-cart-footer .cart__footer > * { margin: 0; }
  #MainContent[data-template='cart'] #main-cart-footer .pf-foot-left,
  #MainContent[data-template='cart'] #main-cart-footer .cart__blocks.pf-sum {
    box-sizing: border-box; width: 100%; background: #fff; border: 1px solid #ece3d4; border-radius: 18px;
    padding: clamp(1.8rem, 2.4vw, 2.6rem); box-shadow: 0 10px 28px rgba(120, 100, 70, .08);
  }
  #MainContent[data-template='cart'] #main-cart-footer .pf-foot-left { gap: 1.8rem; }
  #MainContent[data-template='cart'] #main-cart-footer .pf-sum__trust li { background: #fbf8f2; }

  @media screen and (min-width: 750px) {
    #MainContent[data-template='cart'] #main-cart-footer .cart__footer {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start;
    }
    #MainContent[data-template='cart'] #main-cart-footer .cart__footer > .pf-sum { grid-column: 1; grid-row: 1; }
    #MainContent[data-template='cart'] #main-cart-footer .cart__footer > .pf-foot-left { grid-column: 2; grid-row: 1; }
  }
</style>
