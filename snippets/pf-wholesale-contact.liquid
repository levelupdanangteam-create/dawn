{%- comment -%}
  Shelf-life (HSD) info box on the product detail page.
  Replaces the previous "wholesale contact" box.
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
<style>
  .pf-hsd {
    margin: 1.8rem 0 0; display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap;
    background: linear-gradient(180deg, #f2faf4 0%, #fbfdf9 100%);
    border: 1px solid #bfe0c7; border-left: 5px solid #1e8541; border-radius: 14px; padding: 1.5rem 1.7rem;
  }
  .pf-hsd__ico {
    flex: none; width: 4rem; height: 4rem; border-radius: 12px; background: #1e8541; color: #fff;
    display: grid; place-items: center; font-size: 2rem; box-shadow: 0 4px 10px rgba(20,103,47,.25);
  }
  .pf-hsd__body { flex: 1 1 20rem; min-width: 0; }
  .pf-hsd__t { margin: 0 0 .4rem; font-size: 1.5rem; font-weight: 800; color: #14672f; }
  .pf-hsd__list { display: flex; flex-wrap: wrap; gap: .6rem .9rem; }
  .pf-hsd__item {
    display: inline-flex; align-items: baseline; gap: .5rem; background: #fff; border: 1px solid #d9eadd;
    border-radius: 999px; padding: .5rem 1rem; font-size: 1.35rem; color: #3d3a33;
  }
  .pf-hsd__item b { color: #1e8541; font-weight: 800; white-space: nowrap; }
  @media (max-width: 599px) { .pf-hsd__item { flex: 1 1 100%; justify-content: center; } }
</style>

<div class="pf-hsd">
  <span class="pf-hsd__ico" aria-hidden="true">🗓️</span>
  <div class="pf-hsd__body">
    <p class="pf-hsd__t">{% if vi %}Hạn sử dụng (HSD){% else %}Shelf life{% endif %}</p>
    <div class="pf-hsd__list">
      <span class="pf-hsd__item">{% if vi %}Gia vị, bột:{% else %}Seasonings, flour:{% endif %} <b>{% if vi %}12 tháng{% else %}12 months{% endif %}</b></span>
      <span class="pf-hsd__item">{% if vi %}Đồ ăn vặt, sữa:{% else %}Snacks, milk:{% endif %} <b>{% if vi %}6 tháng{% else %}6 months{% endif %}</b></span>
    </div>
  </div>
</div>
