{%- comment -%}
  Ô thông tin trên trang sản phẩm.
  Đã gỡ ô "Hạn sử dụng" và ô "Ưu đãi đơn từ 139€" theo yêu cầu (25/10).
  Chỉ còn: sản phẩm có tag PRE-ORDER hiện ô tím "Hàng PRE-ORDER" (thời gian chờ).
  Dùng: {% render 'pf-wholesale-contact', product: product %}
{%- endcomment -%}
{%- assign vi = false -%}
{%- if request.locale.iso_code == 'vi' -%}{%- assign vi = true -%}{%- endif -%}
{%- liquid
  assign pf_po = false
  for t in product.tags
    assign t_up = t | upcase | strip
    if t_up == 'PRE-ORDER' or t_up == 'PREORDER' or t_up == 'PRE ORDER'
      assign pf_po = true
      break
    endif
  endfor
-%}
{%- if pf_po -%}
<style>
  .pf-hsd {
    margin: 1.8rem 0 0; display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap;
    background: linear-gradient(180deg, #f5efff 0%, #fbf9ff 100%);
    border: 1px solid #d9c6ff; border-left: 5px solid #6c2bd9; border-radius: 14px; padding: 1.5rem 1.7rem;
  }
  .pf-hsd__ico {
    flex: none; width: 4rem; height: 4rem; border-radius: 12px; background: #6c2bd9; color: #fff;
    display: grid; place-items: center; font-size: 2rem; box-shadow: 0 4px 10px rgba(108,43,217,.25);
  }
  .pf-hsd__body { flex: 1 1 20rem; min-width: 0; }
  .pf-hsd__t { margin: 0 0 .4rem; font-size: 1.5rem; font-weight: 800; color: #4b1fa3; }
  .pf-hsd__list { display: flex; flex-wrap: wrap; gap: .6rem .9rem; }
  .pf-hsd__item {
    display: inline-flex; align-items: baseline; gap: .5rem; background: #fff; border: 1px solid #e4d8fb;
    border-radius: 999px; padding: .5rem 1rem; font-size: 1.35rem; color: #3d3a33;
  }
  .pf-hsd__item b { color: #6c2bd9; font-weight: 800; white-space: nowrap; }
  @media (max-width: 599px) { .pf-hsd__item { flex: 1 1 100%; justify-content: center; } }
</style>
<div class="pf-hsd pf-hsd--po">
  <span class="pf-hsd__ico" aria-hidden="true">⏳</span>
  <div class="pf-hsd__body">
    <p class="pf-hsd__t">{% if vi %}Hàng PRE-ORDER (đặt trước){% else %}PRE-ORDER item{% endif %}</p>
    <div class="pf-hsd__list">
      <span class="pf-hsd__item">{% if vi %}Thời gian chờ:{% else %}Waiting time:{% endif %} <b>{% if vi %}10–15 ngày{% else %}10–15 days{% endif %}</b></span>
    </div>
  </div>
</div>
{%- endif -%}
