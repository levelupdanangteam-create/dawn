{%- comment -%}
  Section "Giấy chứng nhận sản phẩm" trên trang SP — đặt TRÊN video sản phẩm.
  Dữ liệu: metafield custom.certificates (JSON) = [{"name":"…","img":"url ảnh","pdf":"url PDF hoặc rỗng"}].
  Không có PDF thì bấm mở ảnh gốc. Các thẻ luôn căn giữa khung.
{%- endcomment -%}
{%- assign certs = product.metafields.custom.certificates.value -%}
{%- if certs != blank -%}
<div class="pf-cert page-width">
  <div class="pf-cert__head">
    <h2 class="pf-cert__title">Giấy chứng nhận sản phẩm</h2>
    <p class="pf-cert__sub">Đầy đủ giấy tờ chất lượng &amp; an toàn thực phẩm — bấm để xem bản gốc</p>
  </div>
  <div class="pf-cert__grid">
    {%- for c in certs -%}
      {%- assign c_link = c.pdf | default: c.img -%}
      <a class="pf-cert__card" href="{{ c_link }}" target="_blank" rel="noopener">
        <span class="pf-cert__img"><img src="{{ c.img }}" alt="{{ c.name | escape }}" loading="lazy"></span>
        <span class="pf-cert__nm">{{ c.name }}</span>
        <span class="pf-cert__cta">{% if c.pdf != blank %}📄 Xem bản PDF{% else %}🔍 Xem ảnh gốc{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
<style>
  .pf-cert { padding-top: 32px; padding-bottom: 32px; }
  .pf-cert__head { text-align: center; margin-bottom: 2rem; }
  .pf-cert__title { margin: 0; font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 800; color: #14672f; }
  .pf-cert__sub { margin: .5rem 0 0; font-size: 1.5rem; color: #6a6255; }
  .pf-cert__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.6rem; max-width: 88rem; margin: 0 auto; }
  .pf-cert__card { flex: 0 1 calc((100% - 4.8rem) / 4); min-width: 0; box-sizing: border-box; }
  .pf-cert__card { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: #2a2622; background: #fff; border: 1px solid #e6dcc4; border-radius: 16px; padding: .8rem .8rem 1.2rem; box-shadow: 0 8px 22px rgba(0,0,0,.08); transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
  .pf-cert__card:hover { transform: translateY(-4px); border-color: #a8d5b5; box-shadow: 0 14px 30px rgba(30,133,65,.15); }
  .pf-cert__img { display: block; width: 100%; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 10px; border: 1px solid #eee; background: #f7f7f7; }
  .pf-cert__img img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .pf-cert__nm { margin-top: .9rem; font-size: 1.35rem; font-weight: 700; text-align: center; line-height: 1.3; }
  .pf-cert__cta { margin-top: .4rem; font-size: 1.2rem; font-weight: 700; color: #1e8541; }
  @media (max-width: 749px) {
    .pf-cert__grid { gap: 1.2rem; }
    .pf-cert__card { flex-basis: calc((100% - 1.2rem) / 2); }
    .pf-cert__nm { font-size: 1.25rem; }
  }
</style>
{%- endif -%}
