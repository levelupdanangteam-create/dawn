{%- comment -%}
  Một thẻ sản phẩm cho section "Chỉ có tại Phomifood".
  Params: product (bắt buộc), section_id (bắt buộc), hidden (tuỳ chọn: ẩn ban đầu).
{%- endcomment -%}
{%- assign pf_v = product.selected_or_first_available_variant -%}
{%- assign pf_price = pf_v.price -%}
{%- assign pf_cmp = pf_v.compare_at_price -%}
{%- if pf_cmp == blank or pf_cmp <= pf_price -%}{%- assign pf_cmp = product.compare_at_price_max -%}{%- endif -%}
<div class="pf-ex__card{% if hidden %} pf-ex__card--hidden{% endif %}">
  <span class="pf-ex__badge">{% if request.locale.iso_code == "vi" %}⭐ Độc quyền{% else %}⭐ Exclusive{% endif %}</span>
  <a class="pf-ex__media" href="{{ product.url }}">
    {%- if pf_cmp > pf_price -%}
      <span class="pf-ex__sale">-{{ pf_cmp | minus: pf_price | times: 100.0 | divided_by: pf_cmp | round }}%</span>
    {%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy" width="500" height="500">
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="pf-ex__info">
    <h3 class="pf-ex__nm"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'pf-sold-badge', p: product %}
    <div class="pf-ex__price">
      <span class="now">{{ pf_price | money }}</span>
      {%- if pf_cmp > pf_price -%}<span class="was">{{ pf_cmp | money }}</span>{%- endif -%}
    </div>
    {% render 'pf-card-buttons', product: product, section_id: section_id %}
  </div>
</div>
