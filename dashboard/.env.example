# =============================================================================
# Copy file này thành .env.local (chạy máy) hoặc dán vào Environment Variables
# của Vercel / Cloudflare (chạy thật). KHÔNG commit .env.local lên git.
# =============================================================================

# --- Supabase (miễn phí) -----------------------------------------------------
# Lấy ở Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Shopify -----------------------------------------------------------------
# Shopify Admin → Settings → Apps and sales channels → Develop apps →
# tạo app "Phomifood Dashboard" → Admin API access token
SHOPIFY_SHOP=phomifood.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01
# Lấy ở phần Webhooks của app vừa tạo (dùng để xác thực webhook)
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Meta Ads ----------------------------------------------------------------
# System User token của Business Manager, quyền ads_read (token không hết hạn)
META_ACCESS_TOKEN=EAAxxxxxxxx
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0

# --- PPL (ppl.cz) ------------------------------------------------------------
# Xin trong PPL myAPI / liên hệ người phụ trách tài khoản PPL của công ty.
# Chưa có cũng chạy được — chỉ cần nhập mã vận đơn thủ công trong dashboard.
PPL_CLIENT_ID=
PPL_CLIENT_SECRET=
PPL_CUSTOMER_ID=
PPL_BASE_URL=https://api.dhl.com/ecs/ppl/myapi2
PPL_AUTH_URL=https://api.dhl.com/ecs/ppl/myapi2/login/getAccessToken
PPL_PRODUCT_TYPE=BUSS
PPL_COD_PRODUCT_TYPE=BUSS

# Địa chỉ kho gửi hàng (in lên nhãn PPL)
PPL_SENDER_NAME=Phomifood
PPL_SENDER_STREET=
PPL_SENDER_CITY=
PPL_SENDER_ZIP=
PPL_SENDER_COUNTRY=CZ
PPL_SENDER_PHONE=
PPL_SENDER_EMAIL=
# Tài khoản ngân hàng nhận tiền COD
PPL_BANK_ACCOUNT=
PPL_BANK_CODE=

# --- Dashboard ---------------------------------------------------------------
# Mật khẩu chung cho cả team (marketing / sale / kho)
DASHBOARD_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký cookie: openssl rand -base64 32
SESSION_SECRET=
# Chuỗi ngẫu nhiên khác, dùng cho các endpoint chạy nền (cron)
CRON_SECRET=

APP_TIMEZONE=Europe/Prague
BASE_CURRENCY=CZK
